module mixed

-- Engine-parity fixture for `ailang test --bytecode` (#1487): every outcome
-- kind the harness reports — pass, false, failed assert, runtime error,
-- non-bool body, inline tests, ensures properties with a counterexample —
-- must be reported identically on the evaluator and on the bytecode VM.

import std/list (length)
import std/array (get)
import std/option (Option, Some, None)

export pure func add_one(x: int) -> int { x + 1 }

export pure func square(x: int) -> int
  tests [
    (3, 9),
    (4, 15)
  ]
{
  x * x
}

export pure func clampBuggy(x: int) -> int
  ensures { result >= 0 && result <= 10 }
{
  if x < 0 then -1
  else if x > 10 then 10
  else x
}

export pure func clampGood(x: int) -> int
  ensures { result >= 0 && result <= 10 }
{
  if x < 0 then 0
  else if x > 10 then 10
  else x
}

export pure func sumTo(i: int, acc: int) -> int =
  if i <= 0 then acc else sumTo(i - 1, acc + i)

test "passes" {
  add_one(1) == 2
}

test "false result" {
  add_one(1) == 3
}

test "asserts pass" {
  assert add_one(1) == 2;
  let x = add_one(3);
  assert x == 4
}

test "second assert fails" {
  assert add_one(1) == 2;
  assert add_one(3) == 99
}

test "stdlib call" {
  length([1, 2, 3]) == 3
}

test "option match" {
  match Some(3) {
    Some(x) => x == 3,
    None => false
  }
}

test "deep tail recursion" {
  sumTo(5000, 0) == 12502500
}

test "runtime error" {
  1 / (add_one(0) - 1) == 0
}

test "non-bool body" {
  add_one(41)
}

-- An array literal (`#[...]`) does not compile to bytecode yet (`unsupported
-- expression stmt.ArrayLit`), so `secondOf` is an evaluator-only function: the
-- VM body calls it through the harness bridge. Its signature is int -> int,
-- which the bridge carries, so the calling test body stays on the VM.
-- (Pick another construct if this one starts compiling. Nested cons patterns
-- were used here until the v0.51.1 match lowering made them compile, then an
-- expression-form letrec until M-VM-COVERAGE (#1989) compiled local letrec.)
export pure func secondOf(n: int) -> int = get(#[n, n + 1, n + 2], 1)

test "bridged helper" {
  secondOf(3) == 4
}
