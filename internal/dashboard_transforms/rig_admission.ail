-- Rig Admission
--
-- Who may put work on the rig's single GPU right now.
--
-- This is the DECISION for the rig gateway (M-RIG-GPU-ADMISSION-GATEWAY), written
-- in AILANG on purpose, in the same shape as approval_authority: observed facts
-- in, a verdict carrying its own reason out. Everything else stays in Go
-- (internal/riggate): sockets, streaming, reading the lock directory, the ledger.
--
-- The rule (design doc D2): the rig lock is a LEASE. While someone holds it, only
-- requests carrying that lease's token may send long work (chat/generate) to the
-- GPU. Everyone else is refused AT ONCE, with the holder's name, rather than
-- queued behind it — queueing is exactly what collapsed the rig on 2026-09-27,
-- when two orphaned agents with no lease kept every real eval waiting. Short calls
-- (embeddings, model listing) are always admitted: they run on the second loaded
-- model slot and cost milliseconds. With no lease held, long work is admitted and
-- marked "unleased", so ad-hoc use keeps working.
--
-- The refusal status is 423, never 503: measured 2026-09-27 (design doc V11),
-- opencode retries a 503 indefinitely but treats 423 as final, as does pi.
--
-- Called from: internal/riggate/policy.go

module internal/dashboard_transforms/rig_admission
import std/list (any)
import std/string (startsWith)

-- ============================================================================
-- Types
-- ============================================================================

-- The facts about one request, gathered by the Go shell.
-- path is the request path as received. leaseHeld is whether the rig lock is
-- held by anyone. tokenPresent is whether the request carried a lease token
-- (Authorization: Bearer or X-Rig-Lease); tokenMatches is whether it equals the
-- live lease's token. leaseHasToken is false when the holder minted no token (a
-- holder binary from before leases, or Daneel's lock code until it mints). holder
-- names the current holder for the refusal message.
export type Request = { path: string, leaseHeld: bool, leaseHasToken: bool, tokenPresent: bool, tokenMatches: bool, holder: string }

-- The answer. decision is the ledger label: short | unleased | legacy-holder | lease | refused.
export type Verdict = { admit: bool, status: int, decision: string, reason: string }

-- ============================================================================
-- Classification
-- ============================================================================

-- Long work: a request that prefills and generates on the GPU.
--
-- Prefix match, so both the OpenAI-compatible surface (/v1/...) and ollama's
-- native one (/api/...) are covered, including any trailing path or query.
export pure func isLong(path: string) -> bool
  tests [
    ("/v1/chat/completions", true),
    ("/v1/completions", true),
    ("/api/chat", true),
    ("/api/generate", true),
    ("/api/embed", false),
    ("/api/embeddings", false),
    ("/api/tags", false),
    ("/api/ps", false),
    ("/api/version", false),
    ("/v1/models", false),
    ("/", false)
  ] {
  any(func(p: string) -> bool {
    startsWith(path, p)
  }, ["/v1/chat/completions", "/v1/completions", "/api/chat", "/api/generate"])
}

-- ============================================================================
-- The decision
-- ============================================================================

-- The ledger label for one request:
--   short | unleased | legacy-holder | lease | refused-foreign | refused-none.
--
-- legacy-holder: the lock is held by a holder that minted no token, so NOBODY
-- could present a matching one, including the holder's own agents. Admitting
-- keeps the rollout safe (a pre-lease holder's work is not refused wholesale); it
-- is the pre-gateway behaviour, labelled so the ledger shows how often it happens.
--
-- The branching lives here, as a string, so it can carry inline tests: a record
-- is not accepted as an inline-test expected value (measured 2026-09-27:
-- "expected literal expression, got *ast.Record"). decide() only renders it.
export pure func label(r: Request) -> string
  tests [
    (({path: "/api/embed", leaseHeld: true, leaseHasToken: true, tokenPresent: false, tokenMatches: false, holder: "h"}), "short"),
    (({path: "/v1/chat/completions", leaseHeld: false, leaseHasToken: false, tokenPresent: false, tokenMatches: false, holder: ""}), "unleased"),
    (({path: "/v1/chat/completions", leaseHeld: true, leaseHasToken: true, tokenPresent: true, tokenMatches: true, holder: "h"}), "lease"),
    (({path: "/api/generate", leaseHeld: true, leaseHasToken: true, tokenPresent: true, tokenMatches: false, holder: "h"}), "refused-foreign"),
    (({path: "/v1/chat/completions", leaseHeld: true, leaseHasToken: true, tokenPresent: false, tokenMatches: false, holder: "h"}), "refused-none"),
    (({path: "/api/tags", leaseHeld: true, leaseHasToken: true, tokenPresent: true, tokenMatches: false, holder: "h"}), "short"),
    (({path: "/api/chat", leaseHeld: true, leaseHasToken: false, tokenPresent: false, tokenMatches: false, holder: "h"}), "legacy-holder")
  ]
{
  if !isLong(r.path) then "short"
  else if !r.leaseHeld then "unleased"
  else if !r.leaseHasToken then "legacy-holder"
  else if r.tokenMatches then "lease"
  else if r.tokenPresent then "refused-foreign"
  else "refused-none"
}

export pure func decide(r: Request) -> Verdict {
  let l = label(r);
  if l == "short" then
    {admit: true, status: 200, decision: "short", reason: "short call; always admitted"}
  else if l == "unleased" then
    {admit: true, status: 200, decision: "unleased", reason: "no lease is held; long work admitted without one"}
  else if l == "legacy-holder" then
    {admit: true, status: 200, decision: "legacy-holder", reason: "rig held by ${r.holder}, which minted no lease token; admitted as before leases"}
  else if l == "lease" then
    {admit: true, status: 200, decision: "lease", reason: "request carries the live lease"}
  else if l == "refused-foreign" then
    {admit: false, status: 423, decision: "refused", reason: "lease token is not the live lease (revoked or foreign); rig held by ${r.holder}"}
  else
    {admit: false, status: 423, decision: "refused", reason: "no lease token; rig held by ${r.holder}"}
}
