module string_extra
import std/string (length, trim, toLower, toUpper, split, chars, join, repeat, charAt, replace, startsWith, stringToInt, charCode)
import std/option (Option, Some, None)
import std/list (length as llen)

export func t1(s: string) -> string ! {}
ensures { length(result) <= length(s) } {
  trim(s)
}

export func t1Bad(s: string) -> string ! {}
ensures { length(result) < length(s) } {
  trim(s)
}

export func lower(s: string) -> string ! {}
ensures { length(result) == length(s) } {
  toLower(s)
}

export func parts(s: string) -> [string] ! {}
ensures { llen(result) >= 1 } {
  split(s, ",")
}

export func partsBad(s: string) -> [string] ! {}
ensures { llen(result) >= 2 } {
  split(s, ",")
}

export func cs(s: string) -> [string] ! {}
ensures { llen(result) == length(s) } {
  chars(s)
}

export func j1(x: string) -> string ! {}
ensures { result == x } {
  join(", ", [x])
}

export func rep(s: string, n: int) -> string ! {}
requires { n >= 0 }
ensures { length(result) == length(s) * n } {
  repeat(s, n)
}

export func first(s: string) -> string ! {}
requires { length(s) > 0 }
ensures { length(result) == 1 } {
  charAt(s, 0)
}

export func dash(s: string) -> string ! {}
ensures { result == s || length(s) > 0 } {
  replace(s, "-", "_")
}

export func dashBad(s: string) -> string ! {}
ensures { result == s } {
  replace(s, "-", "_")
}

-- stringToInt (Go's ParseInt): unsigned digits → Some(n); no sign and not
-- all digits → None; a signed string is left open (its model inconclusive).
export func digits(s: string) -> int
  requires { s == "042" }
  ensures { result == 42 }
{
  match stringToInt(s) { Some(n) => n, None => 0 - 1 }
}

export func notDigits(s: string) -> int
  requires { s == "4x" || s == "" }
  ensures { result == 0 - 1 }
{
  match stringToInt(s) { Some(n) => n, None => 0 - 1 }
}

export func minusOpen(s: string) -> int
  requires { s == "-5" }
  ensures { result == 0 - 1 }
{
  match stringToInt(s) { Some(n) => n, None => 0 - 1 }
}

export func plusOpen(s: string) -> int
  requires { s == "+5" }
  ensures { result == 0 - 1 }
{
  match stringToInt(s) { Some(n) => n, None => 0 - 1 }
}

export func positiveOrDefault(s: string, d: int) -> int
  requires { d > 0 }
  ensures { result > 0 }
{
  match stringToInt(s) { Some(n) => if n > 0 then n else d, None => d }
}

export func parsedNonNeg(s: string) -> int
  ensures { result >= 0 }
{
  match stringToInt(s) { Some(n) => n, None => 0 }
}

-- charCode: a single rune's code point, never tied to Z3's narrower range.
export func code(c: string) -> int
  requires { length(c) == 1 }
  ensures { result >= 0 && result <= 1114111 }
{
  charCode(c)
}

export func codeBelowZ3Max(c: string) -> int
  requires { length(c) == 1 }
  ensures { result < 200000 }
{
  charCode(c)
}
