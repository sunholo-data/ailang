module hof_types
import std/list (length, map, filter, foldl, any, flatMap)
import std/string (length as slen)

type Item = { name: string, applicable: bool }

-- FALSE for every non-empty list: must never be VERIFIED
export func badLen(xs: [int]) -> [int] ! {}
ensures { length(result) == length(xs) + 1 } {
  map(\x. x + 1, xs)
}

-- TRUE, but needs induction beyond the unroll depth
export func sameLen(xs: [int]) -> [int] ! {}
ensures { length(result) == length(xs) } {
  map(\x. x + 1, xs)
}

-- TRUE for lists within depth; provable when requires bounds the length
export func shortSame(xs: [int]) -> [int] ! {}
requires { length(xs) <= 2 }
ensures { length(result) == length(xs) } {
  map(\x. x + 1, xs)
}

-- FALSE: [-5] filtered by x > 0 is [], length 0 is not > 0
export func badFilter(xs: [int]) -> [int] ! {}
requires { length(xs) == 1 }
ensures { length(result) > 0 } {
  filter(\x. x > 0, xs)
}

-- FALSE: sum of [-1] is -1
export func badSum(xs: [int]) -> int ! {}
requires { length(xs) == 1 }
ensures { result >= 0 } {
  foldl(\acc x. acc + x, 0, xs)
}

-- TRUE: sum of naturals within bound
export func goodSum(xs: [int]) -> int ! {}
requires { length(xs) <= 2, forall i: 0..length(xs) => _list_nth(xs, i) >= 0 }
ensures { result >= 0 } {
  foldl(\acc x. acc + x, 0, xs)
}

export func strs(xs: [string]) -> [string] ! {}
requires { length(xs) <= 2 }
ensures { length(result) == length(xs) } {
  map(\s. "${s}!", xs)
}

export func floats(xs: [float]) -> [float] ! {}
requires { length(xs) <= 2 }
ensures { length(result) <= length(xs) } {
  filter(\x. x > 0.0, xs)
}

export func intToStr(xs: [int]) -> [string] ! {}
requires { length(xs) <= 2 }
ensures { length(result) == length(xs) } {
  map(\x. if x > 0 then "pos" else "neg", xs)
}

export func lens(xs: [string]) -> int ! {}
requires { length(xs) <= 2 }
ensures { result >= 0 } {
  foldl(\acc s. acc + slen(s), 0, xs)
}


export func applicableCount(items: [Item]) -> int ! {}
requires { length(items) <= 2 }
ensures { result <= length(items) } {
  let applicable = filter(\i. i.applicable, items);
  length(applicable)
}

export func strsBad(xs: [string]) -> [string] ! {}
requires { length(xs) == 1 }
ensures { length(result) == 2 } {
  map(\s. "${s}!", xs)
}

export func floatsBad(xs: [float]) -> [float] ! {}
requires { length(xs) == 1 }
ensures { length(result) == 1 } {
  filter(\x. x > 0.0, xs)
}

export func intToStrBad(xs: [int]) -> [string] ! {}
requires { length(xs) == 1 }
ensures { _list_head(result) == "pos" } {
  map(\x. if x > 0 then "pos" else "neg", xs)
}

export func lensBad(xs: [string]) -> int ! {}
requires { length(xs) == 1 }
ensures { result > 0 } {
  foldl(\acc s. acc + slen(s), 0, xs)
}


export func applicableBad(items: [Item]) -> int ! {}
requires { length(items) == 1 }
ensures { result == 1 } {
  let applicable = filter(\i. i.applicable, items);
  length(applicable)
}

export func hasNeg(xs: [int]) -> bool ! {}
requires { length(xs) == 2, _list_nth(xs, 0) < 0 }
ensures { result == true } {
  any(\x. x < 0, xs)
}

export func hasNegBad(xs: [int]) -> bool ! {}
requires { length(xs) == 1 }
ensures { result == true } {
  any(\x. x < 0, xs)
}

export func dup(xs: [string]) -> [string] ! {}
requires { length(xs) <= 2 }
ensures { length(result) == 2 * length(xs) } {
  flatMap(\s. [s, s], xs)
}

export func dupBad(xs: [string]) -> [string] ! {}
requires { length(xs) == 1 }
ensures { length(result) == 1 } {
  flatMap(\s. [s, s], xs)
}

export func twoMaps(xs: [int]) -> int ! {}
requires { length(xs) <= 2 }
ensures { result == 2 * length(xs) } {
  length(map(\x. x + 1, xs)) + length(map(\x. x * 2, xs))
}

type Req = { session: string, n: int }


export func forSession(rs: [Req], s: string) -> [Req] ! {}
requires { length(rs) <= 2 }
ensures { length(result) <= length(rs) } {
  filter(\r. r.session == s, rs)
}

export func allAbove(xs: [int], lo: int) -> bool ! {}
requires { length(xs) == 1, _list_nth(xs, 0) > lo }
ensures { result == true } {
  any(\x. x > lo, xs)
}

export func allAboveBad(xs: [int], lo: int) -> bool ! {}
requires { length(xs) == 1 }
ensures { result == true } {
  any(\x. x > lo, xs)
}

export func shifted(xs: [int], k: int) -> int ! {}
requires { length(xs) <= 2, k >= 0, forall i: 0..length(xs) => _list_nth(xs, i) >= 0 }
ensures { result >= 0 } {
  let base = k * 2;
  foldl(\acc x. acc + x + base, 0, xs)
}

export func total(rs: [Req]) -> int ! {}
requires { length(rs) <= 2, forall i: 0..length(rs) => _list_nth(rs, i).n >= 0 }
ensures { result >= 0 } {
  foldl(\acc r. acc + r.n, 0, rs)
}

type Rec = { who: string, ok: bool }


-- HOF in ensures, capturing result and a parameter
export func addOk(rs: [Rec], who: string) -> [Rec] ! {}
requires { length(rs) <= 2 }
ensures { any(\r. r.who == who, result) } {
  { who: who, ok: true } :: rs
}

-- false: result can be empty
export func dropAll(rs: [Rec], who: string) -> [Rec] ! {}
requires { length(rs) <= 2 }
ensures { any(\r. r.who == who, result) } {
  filter(\r. r.who != who, rs)
}

-- HOF in requires
export func firstOk(rs: [Rec]) -> bool ! {}
requires { length(rs) == 1, any(\r. r.ok, rs) }
ensures { result == true } {
  _list_head(rs).ok
}

-- requires does not imply ensures
export func firstOkBad(rs: [Rec]) -> bool ! {}
requires { length(rs) == 2, any(\r. r.ok, rs) }
ensures { result == true } {
  _list_head(rs).ok
}
