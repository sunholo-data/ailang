module callee_chain
import std/option (Option, Some, None)
import std/string (stringToFloat)

-- leaf binds a lambda inside an unrolled recursion, which the encoder cannot
-- encode, so it is called opaquely; mid calls leaf; top calls mid.
func leaf(xs: [int], acc: int) -> int {
  let done = \y. y + acc;
  match xs {
    [] => done(0),
    x :: rest => leaf(rest, acc + x)
  }
}

func mid(n: int) -> int = leaf([n], 0) + 1

export func top(n: int) -> int
  ensures { result == mid(n) }
{
  mid(n)
}

-- True (leaf sums), but provable only from leaf's value: inconclusive, and
-- witness replay finds no violation to promote it.
export func topFalse(n: int) -> int
  requires { n >= 0 && n < 1000 }
  ensures { result >= 1 }
{
  mid(n)
}

-- ping calls back into itself through pong: its contract stands in for the
-- inner call (the induction hypothesis), so it verifies.
export func ping(n: int) -> int
  ensures { result >= 0 }
{
  if n <= 0 then 0 else pong(n - 1)
}

func pong(n: int) -> int = if n <= 0 then 1 else ping(n - 1)

-- parsed calls stringToFloat, which has no SMT encoding.
func parsed(s: string) -> int {
  match stringToFloat(s) {
    Some(_) => 1,
    None => 0
  }
}

export func viaParse(s: string) -> int
  ensures { result == result }
{
  parsed(s) + 1
}
