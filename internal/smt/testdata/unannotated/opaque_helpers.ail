module opaque_helpers
import std/string (length)
import std/list (map, foldl, concat)
import std/list (length as listLength)

-- A helper whose body does not encode (a tuple) and that has no ensures is an
-- uninterpreted function: a proof that does not depend on its value holds,
-- with a caveat naming it; a refutation through it is inconclusive.
func swapSum(a: int, b: int) -> int {
  match (a, b) { (x, y) => y + x }
}

export func ignoresHelper(n: int) -> int
  ensures { result == n }
{
  let s = swapSum(n, 1);
  if s == s then n else 0
}

export func dependsOnHelper(n: int) -> int
  ensures { result == n + 1 }
{
  swapSum(n, 1)
}

-- Its requires is still checked at each call.
func halfOfPos(n: int) -> int
  requires { n > 0 }
{
  match (n, 2) { (x, d) => x / d }
}

export func callsWithinRequires(n: int) -> int
  requires { n >= 0 }
  ensures { result == result }
{
  halfOfPos(n + 1)
}

export func breaksRequires(n: int) -> int
  ensures { result == result }
{
  halfOfPos(n)
}

-- Mutually recursive helpers are called opaquely too.
func evenLen(xs: [int]) -> bool = match xs { [] => true, [_, ...r] => oddLen(r) }
func oddLen(xs: [int]) -> bool = match xs { [] => false, [_, ...r] => evenLen(r) }

export func parityLabel(xs: [int]) -> string
  ensures { result == "even" || result == "odd" }
{
  if evenLen(xs) then "even" else "odd"
}

-- A helper with an ensures stands in by its contract, even when its body
-- does not encode: no caveat, and its ensures is usable.
func nonNegPair(n: int) -> int
  ensures { result >= 0 }
{
  match (n, 0) { (x, z) => if x > z then x else z }
}

export func viaContract(n: int) -> int
  ensures { result >= 1 }
{
  nonNegPair(n) + 1
}

-- Bugs that skips through helpers used to hide.
-- An empty list passed to a helper takes the parameter's sort; ANF hoists it
-- into a let that defaulted to (Seq Int), a Z3 ERROR.
func countWords(ws: [string], n: int) -> int {
  match (ws, n) { (_, k) => k }
}

export func emptyListArg(n: int) -> int
  ensures { result == result }
{
  countWords([], n)
}

-- In an ensures, `result` is the return value even when a parameter is
-- named result.
export func paramNamedResult(result: string) -> int
  ensures { result >= 0 }
{
  1
}

-- …the same for a helper that is defined, and for [] that ANF hoists into
-- lets (a match arm), which take the sort from the call they feed.
func strsLen(ws: [string]) -> int {
  match ws { [] => 0, _ => 1 }
}

export func definedEmptyArg(n: int) -> int
  ensures { result == 0 }
{
  strsLen([])
}

func nested(a: [[string]], b: [string], n: int) -> int {
  match (a, n) { (_, k) => k }
}

export func hoistedEmptyArgs(xs: [int], n: int) -> int
  ensures { result == result }
{
  match xs {
    [] => nested([], [], n),
    _ => 0
  }
}

-- A helper without a return annotation has no sort to be opaque at: still a skip.
func untypedTag(n: int) = match (n, "x") { (_, s) => s }

export func viaUntypedReturn(n: int) -> int
  ensures { result >= 0 }
{
  length(untypedTag(n))
}

-- A helper whose SIGNATURE has no sort (a list of tuples) is never defined.
-- Reached through a helper with a good signature, it makes that helper
-- opaque; called directly, it still skips the function.
func escapePairs() -> [(string, string)] = [("<", "&lt;")]

func masked(s: string) -> string {
  match escapePairs() { [] => s, _ => s }
}

export func throughMasked(n: int) -> int
  ensures { result == n }
{
  let m = masked("x");
  if m == m then n else 0
}

export func callsPairsDirectly(n: int) -> int
  ensures { result == n }
{
  match escapePairs() { [] => n, _ => n }
}

-- A helper whose map does not specialise (its lambda matches on a tuple) is
-- opaque like any other unencodable body.
func bumpAll(xs: [int]) -> [int] = map(\x. match (x, 1) { (a, b) => a + b }, xs)

export func throughBadMap(n: int) -> int
  ensures { result == n }
{
  let ys = bumpAll([n]);
  if ys == ys then n else 0
}

-- An opaque helper's signature names an anonymous record: it is declared.
func splitAt(n: int) -> { left: string, n: int } {
  match (n, "x") { (k, s) => { left: s, n: k } }
}

export func throughRecordResult(n: int) -> int
  ensures { result == n }
{
  let p = splitAt(n);
  if p.n == p.n then n else 0
}

-- A foldl's [] accumulator takes the accumulator's sort, not the list's.
func flatten(acc: [[string]]) -> [string] = foldl(\out rs. concat(rs, out), [], acc)

export func flattenLen(acc: [[string]]) -> int
  ensures { result >= 0 }
{
  listLength(flatten(acc))
}

-- A record with a field of no sort (a tuple list) is never declared with the
-- rest: two values differing only there compared equal, so `same` was
-- VERIFIED although pairs may differ.
type Tagged = { tag: int, pairs: [(int, int)] } deriving (Eq)

export func same(r1: Tagged, r2: Tagged) -> bool
  requires { r1.tag == r2.tag }
  ensures { result }
{
  r1 == r2
}

-- A named record only an opaque helper's signature names is declared.
type Pt = { x: int, y: int }

func mkPt(n: int) -> Pt {
  match (n, 0) { (a, b) => { x: a, y: b } }
}

export func throughNamedResult(n: int) -> int
  ensures { result == n }
{
  let p = mkPt(n);
  if p.x == p.x then n else 0
}

-- An inline record with a field of no sort, inside an ADT: never declared.
type Bag = Bag({ tag: int, pairs: [(int, int)] }) deriving (Eq)

export func sameBag(b1: Bag, b2: Bag) -> bool
  ensures { result || !result }
{
  b1 == b2
}
