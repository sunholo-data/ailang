module anon_records

-- An anonymous record in a parameter: the sort is declared when it sits in a
-- list, and after the ADT one of its fields names.
type Q = QA(int) | QB(string)

export pure func listOfRecords(xs: [{ name: string, k: int }]) -> int
  ensures { result >= 0 }
= 0

export pure func recordWithAdt(x: { name: string, q: Q }) -> int
  ensures { result >= 0 }
= 0

export pure func listOfRecordsWithAdt(xs: [{ name: string, q: Q }]) -> int
  ensures { result >= 0 }
= 0

export pure func listOfRecordsFalse(xs: [{ name: string, k: int }]) -> int
  ensures { result > 0 }
= 0

-- Two inline records with the same field names and different field types
-- are named by their field sorts too (record_names.go), so this verifies; it
-- was a skip, and before that a Z3 error.
type Opt = Plain([{ key: string, desc: string }]) | Rich([{ key: string, desc: int }])

export pure func richDesc(o: Opt) -> int
  ensures { result >= 0 }
= match o {
    Plain(_) => 0,
    Rich(xs) => match xs { [] => 0, [x, ..._] => if x.desc >= 0 then x.desc else 0 }
  }

-- Names that still coincide once field sorts are added ({a: [int]} and
-- {a: Seq_Int} are both Record_a__Seq_Int) are a skip naming the clash.
type Seq_Int = SI(int)
type Twin = TA([{ a: [int] }]) | TB([{ a: Seq_Int }])

export pure func twinTag(t: Twin) -> int
  ensures { result >= 0 }
= match t {
    TA(_) => 0,
    TB(_) => 1
  }
