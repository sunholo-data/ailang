{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "~/.ailang/hooks/claude_telemetry.sh", "timeout": 5}]}],
    "PreToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "~/.ailang/hooks/claude_telemetry.sh", "timeout": 3}]}],
    "PostToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "~/.ailang/hooks/claude_telemetry.sh", "timeout": 3}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "~/.ailang/hooks/claude_telemetry.sh", "timeout": 5}]}]
  }
}
