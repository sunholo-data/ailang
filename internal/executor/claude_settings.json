{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:1957/api/hooks/claude",
            "headers": {
              "X-Ailang-Task-Id": "${AILANG_TASK_ID}",
              "X-Ailang-Chain-Id": "${AILANG_CHAIN_ID}",
              "X-Ailang-Stage-Id": "${AILANG_STAGE_ID}",
              "X-Ailang-Message-Id": "${AILANG_MESSAGE_ID}"
            },
            "allowedEnvVars": ["AILANG_TASK_ID", "AILANG_CHAIN_ID", "AILANG_STAGE_ID", "AILANG_MESSAGE_ID"],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:1957/api/hooks/claude",
            "headers": {
              "X-Ailang-Task-Id": "${AILANG_TASK_ID}",
              "X-Ailang-Chain-Id": "${AILANG_CHAIN_ID}",
              "X-Ailang-Stage-Id": "${AILANG_STAGE_ID}",
              "X-Ailang-Message-Id": "${AILANG_MESSAGE_ID}"
            },
            "allowedEnvVars": ["AILANG_TASK_ID", "AILANG_CHAIN_ID", "AILANG_STAGE_ID", "AILANG_MESSAGE_ID"],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:1957/api/hooks/claude",
            "headers": {
              "X-Ailang-Task-Id": "${AILANG_TASK_ID}",
              "X-Ailang-Chain-Id": "${AILANG_CHAIN_ID}",
              "X-Ailang-Stage-Id": "${AILANG_STAGE_ID}",
              "X-Ailang-Message-Id": "${AILANG_MESSAGE_ID}"
            },
            "allowedEnvVars": ["AILANG_TASK_ID", "AILANG_CHAIN_ID", "AILANG_STAGE_ID", "AILANG_MESSAGE_ID"],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:1957/api/hooks/claude",
            "headers": {
              "X-Ailang-Task-Id": "${AILANG_TASK_ID}",
              "X-Ailang-Chain-Id": "${AILANG_CHAIN_ID}",
              "X-Ailang-Stage-Id": "${AILANG_STAGE_ID}",
              "X-Ailang-Message-Id": "${AILANG_MESSAGE_ID}"
            },
            "allowedEnvVars": ["AILANG_TASK_ID", "AILANG_CHAIN_ID", "AILANG_STAGE_ID", "AILANG_MESSAGE_ID"],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:1957/api/hooks/claude",
            "headers": {
              "X-Ailang-Task-Id": "${AILANG_TASK_ID}",
              "X-Ailang-Chain-Id": "${AILANG_CHAIN_ID}",
              "X-Ailang-Stage-Id": "${AILANG_STAGE_ID}",
              "X-Ailang-Message-Id": "${AILANG_MESSAGE_ID}"
            },
            "allowedEnvVars": ["AILANG_TASK_ID", "AILANG_CHAIN_ID", "AILANG_STAGE_ID", "AILANG_MESSAGE_ID"],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:1957/api/hooks/claude",
            "headers": {
              "X-Ailang-Task-Id": "${AILANG_TASK_ID}",
              "X-Ailang-Chain-Id": "${AILANG_CHAIN_ID}",
              "X-Ailang-Stage-Id": "${AILANG_STAGE_ID}",
              "X-Ailang-Message-Id": "${AILANG_MESSAGE_ID}"
            },
            "allowedEnvVars": ["AILANG_TASK_ID", "AILANG_CHAIN_ID", "AILANG_STAGE_ID", "AILANG_MESSAGE_ID"],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:1957/api/hooks/claude",
            "headers": {
              "X-Ailang-Task-Id": "${AILANG_TASK_ID}",
              "X-Ailang-Chain-Id": "${AILANG_CHAIN_ID}",
              "X-Ailang-Stage-Id": "${AILANG_STAGE_ID}",
              "X-Ailang-Message-Id": "${AILANG_MESSAGE_ID}"
            },
            "allowedEnvVars": ["AILANG_TASK_ID", "AILANG_CHAIN_ID", "AILANG_STAGE_ID", "AILANG_MESSAGE_ID"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
