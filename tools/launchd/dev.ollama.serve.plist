<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  M-EVAL-OS-LONGITUDINAL M0: hardened ollama serve via launchd.

  Why this exists: the user-facing Ollama.app (Electron) is the wrong service
  model for a 24/7 eval rig. It runs as a desktop app with a UI, has
  auto-updaters that can restart it without warning, and macOS treats it as
  a background app eligible for cleanup. On 2026-05-23 at 02:02:45 the
  Ollama.app silently died mid-eval, taking ollama serve with it and
  invalidating a 2h 15m N=3 trial run.

  This plist runs `ollama serve` directly (no Electron UI) with:
    - KeepAlive=true: auto-restart on any non-zero exit
    - RunAtLoad=true: start at boot
    - Tuned env vars: keep model resident (24h), 4-way parallel, 64-slot queue
    - Log paths: capture stdout/stderr for post-mortem
    - ThrottleInterval=10: avoid restart loops if it crashes fast

  Installation:
    1. Quit Ollama.app from the menu bar (so it doesn't fight launchd)
    2. Disable "Open at login" in Ollama.app settings
    3. cp tools/launchd/dev.ollama.serve.plist ~/Library/LaunchAgents/
    4. launchctl load ~/Library/LaunchAgents/dev.ollama.serve.plist
    5. Verify: curl -s http://localhost:11434/api/tags
    6. Optional: check status with `launchctl list | grep dev.ollama.serve`

  Stop / unload:
    launchctl unload ~/Library/LaunchAgents/dev.ollama.serve.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.ollama.serve</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Applications/Ollama.app/Contents/Resources/ollama</string>
        <string>serve</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- KeepAlive caveat: on macOS 26.x (Tahoe) gui/<uid> agents, neither
         the boolean <true/> form NOR the dict form reliably auto-restart
         after SIGKILL. Verified 2026-05-23: a kill -9 of the ollama serve
         process leaves the launchd job in "pended nondemand spawn = semaphore"
         state and never respawns within 30+ seconds. This is a known macOS
         launchd limitation in user-agent context.
         The dict form is still preferable for clarity of intent and may help
         in some crash modes (graceful exit with non-zero status).
         For TRUE reliability, see the watchdog approach in
         tools/launchd/dev.ailang.rig-watchdog.plist (StartInterval polling
         that restarts dead services). RunAtLoad still works — the plist
         brings ollama up at user login regardless of KeepAlive.
    -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/tmp/ollama-serve-launchd.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/ollama-serve-launchd.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- Never unload the model: prefix-cache hits across trials in a
             rotation depend on the model staying resident with KV state.
             Default (5min) and even 24h caused trial 1 in a fresh batch to
             pay the full 17 GB reload + 110k-token prefill. -1 = forever. -->
        <key>OLLAMA_KEEP_ALIVE</key>
        <string>-1</string>

        <!-- One model resident at a time (gemma4:26b uses ~17 GB weights;
             with q8_0 KV cache it's ~29 GB total). -->
        <key>OLLAMA_MAX_LOADED_MODELS</key>
        <string>1</string>

        <!-- ONE concurrent request. Why not more: ollama pre-allocates KV cache
             at full context length per slot. With our 110k-token opencode prompts,
             4 slots × ~6 GB KV = 25 GB, and the single integrated GPU can't
             actually parallelise prefill of multiple long prompts — 2026-05-23
             empirically: NUM_PARALLEL=4 caused every concurrent request to hit
             the 15-min TTFT timeout. See design_docs/planned/v0_23_0/m-eval-os-longitudinal.md
             + Ollama FAQ: "Required RAM scales by NUM_PARALLEL × CONTEXT_LENGTH". -->
        <key>OLLAMA_NUM_PARALLEL</key>
        <string>1</string>

        <!-- Quantize the KV cache to int8. Cuts KV memory roughly in half
             (~12 GB instead of ~25 GB at 110k context) for ~5% gen-token
             slowdown on Metal. REQUIRES OLLAMA_FLASH_ATTENTION=1 or it
             silently falls back to fp16. -->
        <key>OLLAMA_KV_CACHE_TYPE</key>
        <string>q8_0</string>

        <!-- Required for quantized KV cache to actually take effect. -->
        <key>OLLAMA_FLASH_ATTENTION</key>
        <string>1</string>

        <!-- Bounded backpressure: harness shouldn't queue more than this. -->
        <key>OLLAMA_MAX_QUEUE</key>
        <string>64</string>

        <!-- Bind localhost only (security). -->
        <key>OLLAMA_HOST</key>
        <string>127.0.0.1:11434</string>

        <!-- Standard macOS PATH so subprocesses can find tools. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/voightkampff</string>
</dict>
</plist>
