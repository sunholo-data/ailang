#!/bin/bash
# Mission scope guard (M-HARNESS-MISSION-LOOP, HD-4). Enabled PER FIRE: the mission driver
# points core.hooksPath here through GIT_CONFIG_COUNT/KEY/VALUE, so no repo config changes
# and attended sessions (no MISSION_NAME) never see it.
#
# Product loops (v1, docs, motoko, ...) may not push changes to the loop harness; they file
# a ticket instead. The fleet loop may not push changes to the language core. Pushes to any
# repo other than sunholo-data/ailang (world, daneel) pass untouched.
#
# BASH 3.2 (the rig): no arrays-of-arrays, no ${v,,}, no mapfile.

# Harness paths: the fleet mission's write scope. Keep in step with
# design_docs/fleet-mission.md "Authority".
_scope_is_harness() {
  case "$1" in
    tools/launchd/*|internal/mission/*|cmd/ailang/mission*|missions/*) return 0 ;;
    .claude/skills/mission-*|.claude/skills/sprint-*|.pi/extensions/*) return 0 ;;
    .agents/skills/mission-*|.agents/skills/sprint-*) return 0 ;;   # generated mirror of the .claude skills
    scripts/hooks/*|scripts/mission_*|scripts/test_mission_*) return 0 ;;   # tests of harness scripts (D-FLEET-5)
    design_docs/fleet-mission*) return 0 ;;   # the fleet's own queue, log and charter
  esac
  return 1
}

# Support paths the fleet may ALSO change: the bookkeeping, docs and wiring a harness fix
# needs (every one was needed by the sprint that built this guard). The fleet's write scope
# is harness + support — an ALLOWLIST, so anything unlisted (CI workflows, go.mod, the
# server, the UI, other commands) is refused rather than silently allowed.
_scope_is_fleet_support() {
  case "$1" in
    .claude/skills/design-doc-creator/*|.agents/skills/design-doc-creator/*) return 0 ;;   # support, not harness (D-FLEET-36)
    design_docs/*|changelogs/*|CHANGELOG.md|docs/*|.ailang/state/sprints/*) return 0 ;;
    internal/config/mission.go|make/test.mk) return 0 ;;
    tools/eval/motoko_connection_probe.sh|tools/eval/test_motoko_connection_probe.sh) return 0 ;;   # support, not harness (D-FLEET-18)
    tools/pi-extensions/sandbox/*) return 0 ;;   # the pi sandbox fail-closed fix (D-FLEET-6); the eval harness shares the rest of tools/pi-extensions
    # Exactly the 16 .agents skill mirrors D-FLEET-38 names (rename-only or identical to .claude);
    # support, not harness, so product loops keep them. No .agents/skills/* wildcard.
    .agents/skills/benchmark-runner/*) return 0 ;;
    .agents/skills/builtin-developer/*) return 0 ;;
    .agents/skills/cloud-cascade-debug/*) return 0 ;;
    .agents/skills/collaboration-hub/*) return 0 ;;
    .agents/skills/coordinator-helper/*) return 0 ;;
    .agents/skills/eval-analyzer/*) return 0 ;;
    .agents/skills/eval-gap-finder/*) return 0 ;;
    .agents/skills/gemini-cli-helper/*) return 0 ;;
    .agents/skills/github-issue-triage/*) return 0 ;;
    .agents/skills/local-model-onboarding/*) return 0 ;;
    .agents/skills/local-ollama-eval/*) return 0 ;;
    .agents/skills/parser-developer/*) return 0 ;;
    .agents/skills/pr-monitor/*) return 0 ;;
    .agents/skills/prompt-manager/*) return 0 ;;
    .agents/skills/trace-debugger/*) return 0 ;;
    .agents/skills/use-ailang/*) return 0 ;;
  esac
  return 1
}

# Language-core paths the fleet mission must not touch.
_scope_is_core() {
  case "$1" in
    internal/parser/*|internal/lexer/*|internal/ast/*|internal/types/*|internal/elaborate/*) return 0 ;;
    internal/core/*|internal/eval/*|internal/vm/*|internal/codegen/*|internal/effects/*) return 0 ;;
    internal/builtins/*|internal/pipeline/*|internal/runtime/*|internal/link/*|internal/iface/*) return 0 ;;
    std/*|examples/*|benchmarks/*) return 0 ;;
  esac
  return 1
}

# _scope_verdict MISSION PATH → prints "refuse <reason>" or nothing.
_scope_verdict() {
  local m="$1" p="$2"
  [ -n "$m" ] || return 0
  if [ "$m" = fleet ]; then
    if _scope_is_core "$p"; then
      echo "refuse language-core path; the fleet mission works the loop harness only"
    elif ! _scope_is_harness "$p" && ! _scope_is_fleet_support "$p"; then
      echo "refuse path outside the fleet allowlist (design_docs/fleet-mission.md, Authority)"
    fi
  else
    _scope_is_harness "$p" && echo "refuse loop-harness path; file it with: ailang mission ticket file --signature <key> --evidence <...>"
  fi
  return 0
}

_scope_target_is_ailang() {
  case "$1" in
    *[:/]sunholo-data/ailang|*[:/]sunholo-data/ailang.git) return 0 ;;
  esac
  [ -n "${MISSION_SCOPE_TEST_REMOTE:-}" ] && [ "$1" = "$MISSION_SCOPE_TEST_REMOTE" ] && return 0
  return 1
}

_scope_fail() {
  printf 'mission scope guard: %s: %s\n' "$1" "$2" >&2
  exit 1
}

# Collect NUL-delimited paths. The subshell keeps a failed check local to this ref.
_scope_paths() (
  local ref="$1" local_sha="$2" remote_sha="$3" remote_url="$4" paths="$5"
  local base="" dev_sha advertised commits commit rewrite=0
  local_sha=$(git rev-parse --verify "$local_sha^{commit}") ||
    _scope_fail "$ref" 'local commit unavailable'
  if [ -n "$remote_sha" ]; then
    remote_sha=$(git rev-parse --verify "$remote_sha^{commit}") ||
      _scope_fail "$ref" 'remote commit unavailable; fetch and retry'
    if git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
      base="$remote_sha"
    elif [ "$?" -ne 1 ]; then
      _scope_fail "$ref" 'git merge-base --is-ancestor failed'
    fi
  fi

  if [ -z "$base" ]; then
    dev_sha=$(git rev-parse --verify 'refs/remotes/origin/dev^{commit}') ||
      _scope_fail "$ref" 'refs/remotes/origin/dev unavailable; fetch origin and retry'
    if [ -n "$remote_sha" ]; then
      # Exempt inherited dev history only when the push target still advertises it.
      advertised=$(GIT_TERMINAL_PROMPT=0 git ls-remote --exit-code "$remote_url" refs/heads/dev </dev/null) ||
        _scope_fail "$ref" 'git ls-remote could not verify refs/heads/dev; fetch origin and retry'
      [ "$advertised" = "$dev_sha"$'\t''refs/heads/dev' ] ||
        _scope_fail "$ref" 'stale refs/remotes/origin/dev; fetch origin and retry'
      rewrite=1
    fi
    base=$(git merge-base "$local_sha" "$dev_sha") ||
      _scope_fail "$ref" 'git merge-base with origin/dev failed; fetch origin and retry'
  fi

  git diff --name-only -z "$base" "$local_sha" -- >"$paths" ||
    _scope_fail "$ref" 'git diff failed to enumerate push paths'
  if [ "$rewrite" -eq 1 ]; then
    # A later commit can hide an earlier edit from the net diff.
    commits=$(git rev-list "$dev_sha..$local_sha") ||
      _scope_fail "$ref" 'git rev-list failed to enumerate branch commits'
    while IFS= read -r commit; do
      [ -n "$commit" ] || continue
      git diff-tree --root --no-commit-id --name-only -z -r -m --no-renames "$commit" -- >>"$paths" ||
        _scope_fail "$ref" "git diff-tree failed to enumerate paths for $commit"
    done <<<"$commits"
  fi
)

_scope_main() {
  local remote_url="$2" zero=0000000000000000000000000000000000000000
  local m="${MISSION_NAME:-}" _local_ref local_sha remote_ref remote_sha paths="" p why refused=0
  [ -n "$m" ] || exit 0
  _scope_target_is_ailang "$remote_url" || exit 0
  while read -r _local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue            # a delete pushes no content
    [ "$remote_sha" != "$zero" ] || remote_sha=""    # a new branch has no remote commit
    if [ -z "$paths" ]; then
      paths=$(mktemp "${TMPDIR:-/tmp}/mission-scope.XXXXXX") ||
        _scope_fail "$remote_ref" 'could not create a temporary path list'
      trap 'rm -f "$paths"' EXIT
    fi
    if ! _scope_paths "$remote_ref" "$local_sha" "$remote_sha" "$remote_url" "$paths"; then
      refused=1
      continue
    fi
    while IFS= read -r -d '' p; do
      why=$(_scope_verdict "$m" "$p")
      if [ -n "$why" ]; then
        echo "mission scope guard: MISSION_NAME=$m may not push $p (${why#refuse })" >&2
        refused=1
      fi
    done <"$paths" || _scope_fail "$remote_ref" 'could not read the path list'
  done
  if [ "$refused" -ne 0 ]; then
    echo "mission scope guard: push refused (M-HARNESS-MISSION-LOOP). Tickets go to the mission-fleet inbox." >&2
    exit 1
  fi
  exit 0
}

# Sourced by the test suite with MISSION_SCOPE_LIB=1 to reach the functions.
[ "${MISSION_SCOPE_LIB:-}" = 1 ] || _scope_main "$@"
