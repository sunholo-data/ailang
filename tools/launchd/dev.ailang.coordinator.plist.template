<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  M-COORD-MULTI-HOST-WORKERS (v0.22.0): launchd plist template for the
  AILANG coordinator daemon.
  M-COORD-TAG-ROUTING-LASTMILE (v0.23.0): adds PORT env var so the
  daemon exposes its HTTP listener (/api/messages, /health, /status).

  This is a TEMPLATE — use tools/launchd/install_coordinator.sh to render
  it with your $HOME / project paths, then load it.

  Tokens replaced by the installer:
    @USER_HOME@           — e.g. /Users/voightkampff
    @AILANG_BIN@          — e.g. /Users/voightkampff/go/bin/ailang
    @AILANG_CLOUD_PROJECT@ — e.g. ailang-multivac-dev
    @HTTP_PORT@           — e.g. 8765 (override via install_coordinator.sh --port N)
    @PATH_PREFIX@         — e.g. /Users/voightkampff/go/bin:/opt/homebrew/bin:...

  Direct manual install (NOT recommended; prefer the installer):

    sed -e "s|@USER_HOME@|$HOME|g" \
        -e "s|@AILANG_BIN@|$HOME/go/bin/ailang|g" \
        -e "s|@AILANG_CLOUD_PROJECT@|ailang-multivac-dev|g" \
        -e "s|@PATH_PREFIX@|$HOME/go/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin|g" \
        tools/launchd/dev.ailang.coordinator.plist.template \
      > ~/Library/LaunchAgents/dev.ailang.coordinator.plist
    launchctl load ~/Library/LaunchAgents/dev.ailang.coordinator.plist

  Verify after install:

    launchctl list | grep dev.ailang.coordinator
    ailang coordinator status

  Stop / unload:

    launchctl unload ~/Library/LaunchAgents/dev.ailang.coordinator.plist

  Worker-tag advertisement happens via the agents in ~/.ailang/config.yaml
  (worker_tags + worker_host_id per agent). The daemon picks them up from
  the first agent that advertises tags; rearrange agents to control choice.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.ailang.coordinator</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>exec "@AILANG_BIN@" coordinator start</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart if the daemon exits unexpectedly. Tight enough to recover
         from transient failures, loose enough to avoid crash loops on
         deterministic startup errors (paired with ThrottleInterval). -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/ailang-coordinator-launchd.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/ailang-coordinator-launchd.log</string>

    <!-- Must be a git checkout, not $HOME. initTaskProcessing creates a
         "default" worktree manager with an empty repo path
         (daemon_tasks_init.go:185), which resolves the git root from CWD; from
         $HOME that is `git rev-parse` exit 128, initTaskProcessing returns an
         error, and the daemon drops into STANDBY MODE — no message processing
         at all, logged once at startup as a Warning and never again.
         Measured 2026-08-26: the rig coordinator had been in standby, silently
         processing nothing, across every restart. -->
    <key>WorkingDirectory</key>
    <string>@COORDINATOR_WORKDIR@</string>

    <!-- Throttle to one launch every 10s — prevents tight crash loops while
         still allowing normal restarts after transient failures. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@PATH_PREFIX@</string>
        <!-- M-COORD-MULTI-HOST-WORKERS: AILANG_CLOUD_PROJECT tells the
             coordinator which GCP project owns its Pub/Sub topics + Firestore.
             Should match the gcloud config: `gcloud config get-value project`. -->
        <key>AILANG_CLOUD_PROJECT</key>
        <string>@AILANG_CLOUD_PROJECT@</string>
        <!-- M-COORD-TAG-ROUTING-LASTMILE (v0.23.0): PORT activates the
             daemon's HTTP listener at http://127.0.0.1:$PORT. Without it,
             /api/messages and /health are unreachable and tag-routed sends
             fail silently. Default 8765; override via
             `install_coordinator.sh --port N`. -->
        <key>PORT</key>
        <string>@HTTP_PORT@</string>
        <!-- Repo coordinate for cloud dispatch. deriveRepoURL
             (daemon_tasks_exec.go:14) prefers the agent's `workspace` when it
             looks like a GitHub org/repo, and falls back to this env var when
             `workspace` is a local path (leading "/").

             That fallback is the ONLY correct way to supply both: `workspace`
             is declared as "Base directory for worktrees"
             (agent_registry.go:105) and is chdir'd into by NewWorktreeManager
             (daemon_tasks_init.go:151). Setting `workspace` to a bare
             org/repo to satisfy cloud dispatch breaks the worktree manager —
             measured 2026-08-26, the daemon logged "failed to prune
             worktrees: chdir sunholo-data/ailang" every 30s because
             WorkingDirectory is $HOME. Keep `workspace` local; set the repo
             here. -->
        <key>AILANG_REPO_URL</key>
        <string>@AILANG_REPO_URL@</string>
    </dict>
</dict>
</plist>
