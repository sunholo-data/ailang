<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  M-EVAL-OS-CONTINUOUS-ROTATION: incremental background OS cross-language/harness
  eval. Fires every 45 min; each fire runs ONE small, time-boxed chunk of the
  4-language sweep on idle rig time and yields immediately (shared rig.lock) if a
  nightly / lang-eval is running. Refreshes the OS/Local dashboard JSON once per
  full pass. Zero cloud cost (local Ollama).

  Tunables via EnvironmentVariables below:
    OS_FILLER_CHUNK           benchmarks per cycle (default 3)
    OS_FILLER_TIMEOUT         wall budget per chunk (default 1500s)
    OS_FILLER_BLACKOUT_START  / OS_FILLER_BLACKOUT_END  (default 04:00-07:00)
    OS_FILLER_MODELS         comma list (default opencode-qwen3 + pi-qwen3 —
                             the cross-harness pair on the same local model)
    OS_FILLER_LANGS          ailang,python,javascript,go

  Installation (on the rig):
    cp tools/launchd/dev.ailang.os-rotation-filler.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/dev.ailang.os-rotation-filler.plist
    launchctl kickstart gui/$UID/dev.ailang.os-rotation-filler   # optional first run

  Logs: /tmp/ailang-os-filler.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.ailang.os-rotation-filler</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>exec "$HOME/dev/sunholo-data/ailang/tools/launchd/os-rotation-filler.sh"</string>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StartInterval</key>
    <integer>2700</integer>

    <key>StandardOutPath</key>
    <string>/tmp/ailang-os-filler.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/ailang-os-filler.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>

        <!-- The 2026-08-07 stopgap (a 1800s total-timeout pin on the buffered
             /v1 path) is REMOVED here and replaced by the streaming opt-in
             below — ailang#618 M4, 2026-08-11.

             Why the stopgap existed: the 300s default in
             internal/ai/ollama/step.go is shorter than a qwen3.6:35b thinking
             turn, so motoko retried the deadline until the wall clock killed
             it — 895 retries / ~74.6 GPU-hours over 43 days, 80 runs lost.
             1800s unblocked the rotation but did not fix the real problem: a
             TOTAL-duration cap cannot tell "hung" from "slow".

             Why removing it is MANDATORY, not tidy-up: with the flag below on,
             that same env var stops being an HTTP client timeout and BECOMES
             the stream's hard deadline. 1800s sits BELOW the computed
             worst-case legitimate request (~2941s), so leaving it in would
             re-create the 4m59.97 failure at a larger scale. Left unset, the
             hard deadline defaults to 3600s, and "hung" is caught by the
             sharper idle (120s) / TTFT (600s) windows instead. -->
        <key>AILANG_OLLAMA_V1_STREAM</key>
        <string>1</string>
    </dict>
</dict>
</plist>
