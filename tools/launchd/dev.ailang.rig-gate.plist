<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  M-RIG-GPU-ADMISSION-GATEWAY: the rig GPU admission gateway on ollama's usual
  address (127.0.0.1:11434), proxying to ollama on its private port (11435).

  NOT INSTALLED BY DEFAULT. Cutover order (design doc, Phase 2) — each step needs
  the one before it, or live GPU work is refused or unreachable:
    1. Daneel's lock code mints the lease token (daneel_rig.ail) and its
       /api/generate calls send X-Rig-Lease. Until then its work is admitted
       only as "legacy-holder" when it holds the lock without a token.
    2. Eval lanes send the lease: pi via an `ollama-rig` provider whose header is
       "X-Rig-Lease": "${AILANG_RIG_LEASE}" (pi refuses to start if a templated
       variable is unset; executors always define it, "none" by default), and
       opencode via "apiKey": "{env:AILANG_RIG_LEASE}".
    3. Move ollama: OLLAMA_HOST=127.0.0.1:11435 in dev.ollama.serve.plist (repo
       AND installed copy), and point rig-watchdog's ollama probe at 11435.
    4. Install this plist, bootstrap it, and add it to rig-watchdog's probes.

  Logs: /tmp/ailang-rig-gate.log   Ledger: /Users/Shared/ailang/rig-gate.jsonl
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.ailang.rig-gate</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>exec "$HOME/go/bin/ailang" rig-gate --listen 127.0.0.1:11434 --upstream http://127.0.0.1:11435</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/voightkampff/dev/sunholo-data/ailang</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/ailang-rig-gate.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ailang-rig-gate.log</string>
</dict>
</plist>
