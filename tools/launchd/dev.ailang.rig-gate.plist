<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  M-RIG-GPU-ADMISSION-GATEWAY: the rig GPU admission gateway on ollama's usual
  address (127.0.0.1:11434), proxying to ollama on its private port (11435).

  Installed on the rig 2026-09-28 (Phase 2 cutover). What each client sends:
    - ailang's own clients (`--ai ollama:`, the OpenAI-compatible client motoko
      uses, the lang nightly): X-Rig-Lease from AILANG_RIG_LEASE, loopback only
      (internal/riglock/lease_transport.go).
    - pi: "X-Rig-Lease" header on the `ollama` provider in ~/.pi/agent/models.json,
      as a `!` command value so an unset AILANG_RIG_LEASE reads "none" instead of
      stopping pi (tools/setup/pi-ollama-models.json).
    - opencode: "apiKey": "{env:AILANG_RIG_LEASE}" on the ollama provider.
    - Daneel: admitted as "legacy-holder" while it holds the lock without a
      token, until daneel_rig.ail mints one and daneel_model.ail sends it.
    - Ollama Cloud models ("…:cloud", "…-cloud") are always admitted: no GPU use.
  ollama itself moved to 127.0.0.1:11435 (dev.ollama.serve.plist); rig-watchdog
  probes both. Rollback: set OLLAMA_HOST back to :11434 in the installed ollama
  plist, bootout this job, bootstrap ollama again.

  Logs: /tmp/ailang-rig-gate.log   Ledger: /Users/Shared/ailang/rig-gate.jsonl
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.ailang.rig-gate</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>exec "$HOME/go/bin/ailang" rig-gate --listen 127.0.0.1:11434 --upstream http://127.0.0.1:11435</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/voightkampff/dev/sunholo-data/ailang</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/ailang-rig-gate.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ailang-rig-gate.log</string>
</dict>
</plist>
