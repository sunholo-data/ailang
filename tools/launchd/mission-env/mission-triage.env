# Triage mission profile (M-TRIAGE-MISSION Part B; charter ratified attended 2026-10-15).
# Verifies every approval card, agent PR and bot-filed issue against origin/dev; Level 1 —
# never approves, rejects or merges (D-TRIAGE-7).
#
# THIS IS A VERSIONED COPY. The driver sources ~/.config/ailang/mission-triage.env; keep the
# two byte-identical (`ailang mission install|apply triage` renders from this file).
# Convention: ${VAR:-value} everywhere except the four identity vars (mission-env/README.md).
MISSION_NAME=triage
MISSION_REPO=sunholo-data/ailang
MISSION_DOC=design_docs/triage-mission.md
MISSION_WORKDIR="${MISSION_WORKDIR:-/Users/voightkampff/dev/sunholo-data/ailang-triage}"

# codex and gh live in Homebrew: a plist PATH without Homebrew makes every pre-flight
# false-negative and silently degrades every role (world iter-23).
PATH=/opt/homebrew/bin:$PATH

# ROUTING — charter "Routing policy" (cost-type ladder, the docs-mission shape):
# subscription → flat-rate (Ollama Cloud) → metered (OpenRouter twin, same weights).
# Controller: Sol 6.1, then Sonnet 5.5.
MISSION_MODEL_PREFS="${MISSION_MODEL_PREFS:-codex:gpt-6.1-sol,claude-sonnet-5-5}"
MISSION_CONTROLLER_FALLBACK="${MISSION_CONTROLLER_FALLBACK:-codex:gpt-6-luna}"

# Designer/planner are UNUSED by triage (no inner loop). Pinned to the controller's model so
# the driver's role pre-flights dedupe onto one probe instead of waking an opus probe.
MISSION_DESIGNER_MODEL="${MISSION_DESIGNER_MODEL:-codex:gpt-6.1-sol}"
MISSION_PLANNER_MODEL="${MISSION_PLANNER_MODEL:-codex:gpt-6.1-sol}"

# Verifiers ride the EXECUTOR role (high volume, read-only; gate-3-triage.md): OpenAI →
# Z-AI → Z-AI.
MISSION_EXECUTOR_MODEL="${MISSION_EXECUTOR_MODEL:-codex:gpt-6-luna}"
MISSION_EXECUTOR_FALLBACK="${MISSION_EXECUTOR_FALLBACK:-pi:ollama/glm-5.3-flash:cloud,pi:openrouter/z-ai/glm-5.3-flash}"
# No fleet-default haiku rung before the pi chain: an Anthropic verifier would share a vendor
# with the sonnet judge (measured in the bootstrap dry run, codex over ration → haiku).
MISSION_EXECUTOR_ANTHROPIC_RUNG="${MISSION_EXECUTOR_ANTHROPIC_RUNG-}"

# Judge rides the EVALUATOR role on a vendor-DISJOINT ladder: Anthropic → MiniMax → MiniMax,
# so generator != judge holds at every rung of both chains.
MISSION_EVALUATOR_MODEL="${MISSION_EVALUATOR_MODEL:-sonnet}"
MISSION_EVALUATOR_FALLBACK="${MISSION_EVALUATOR_FALLBACK:-pi:ollama/minimax-m3:cloud,pi:openrouter/minimax/minimax-m3}"

# Metered ceiling: a fire that spends real dollars has already fallen to rung 3.
MISSION_METERED_BUDGET_USD="${MISSION_METERED_BUDGET_USD:-1}"

# Codex lanes run through the managed daemon under the missions' dedicated OAuth owner, never
# the interactive ~/.codex (same three lines every live mission env carries, 2026-10-15).
export CODEX_HOME="/Users/voightkampff/.codex-missions"
export AILANG_CODEX_RUNTIME=daemon

# Run committed origin/dev from ~/.ailang-driver-pin/triage (D-61).
export AILANG_DRIVER_PIN=1
export AILANG_DRIVER_REF=origin/dev
