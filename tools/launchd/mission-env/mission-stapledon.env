MISSION_EXECUTOR_FALLBACK="${MISSION_EXECUTOR_FALLBACK:-agy:gemini-4-neon-high,pi:ollama/deepseek-v4.1-flash:cloud,pi:openrouter/deepseek/deepseek-v4.1-flash}"
