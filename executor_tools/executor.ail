-- executor_tools/executor.ail — hosted AILANG code executor (M-AILANG-EXECUTOR-GE P1).
--
-- The hosted twin of ailang_bootstrap's local stdio MCP (mcp-server/server.js):
-- same tool names, but the caller sends CODE, not a file path, and never picks
-- capabilities. Every run goes through `ailang run --policy`, the boundary the
-- ailang_only executor lane uses: the policy file (EXECUTOR_POLICY) fixes caps,
-- timeout and output limits, and the supervisor enforces them.
--
-- Each request gets its own directory under EXECUTOR_WORK_DIR (which must be
-- the policy's fs_sandbox), holding one file, main.ail, removed afterwards.
--
-- Every call logs one JSON line (event "executor_call") through Debug.log,
-- which serve-api writes to stderr as-is, so Cloud Logging indexes it as
-- jsonPayload: tool, outcome, duration, code size, a short code hash (repeats
-- show a caller retrying the same code) and the first error, with the request
-- directory stripped. The code itself is never logged.
module executor_tools/executor
import std/bytes (toString)
import std/clock (now)
import std/crypto (sha256Hex)
import std/debug (log)
import std/env (getEnvOr)
import std/fs (mkdirAllResult, readFileResult, writeFileResult, removeFileResult, removeDirResult)
import std/json (Json, jo, kv, js, jb, jnum, jint, encode, decode, get, getString, getBool, getInt, getArray)
import std/list (filter, length as listLength)
import std/option (Option, Some, None)
import std/process (exec, ProcessOutput, ProcessError, NotAllowed, NotFound, PermissionDenied, Timeout, OutputLimitExceeded, SpawnFailed, AbnormalExit)
import std/rand (uuid4)
import std/result (Result, Ok, Err)
import std/string (concat, contains, join, length, split, toLower, substring, replace, startsWith, trim)

type Field = { key: string, value: Json }

-- Source larger than this is refused before anything touches disk.
pure func maxCodeBytes() -> int = 65536

-- Longest error excerpt a log line carries.
pure func maxErrorChars() -> int = 300

func workRoot() -> string ! {Env} = getEnvOr("EXECUTOR_WORK_DIR", "/tmp/ailang-exec")

func policyPath() -> string ! {Env} = getEnvOr("EXECUTOR_POLICY", "/srv/executor-policy.toml")

func ailangBin() -> string ! {Env} = getEnvOr("EXECUTOR_AILANG_BIN", "ailang")

pure func clip(s: string, n: int) -> string = if length(s) > n then substring(s, 0, n) else s

pure func errorJson(code: string, message: string) -> Json =
  jo([kv("ok", jb(false)), kv("error", js(code)), kv("message", js(message))])

pure func processErrorText(e: ProcessError) -> string = match e {
  NotAllowed(c) => "not allowed: ${c}",
  NotFound(c) => "ailang binary not found: ${c}",
  PermissionDenied(c) => "permission denied: ${c}",
  Timeout(ms) => "timed out after ${show(ms)}ms",
  OutputLimitExceeded(n) => "output exceeded ${show(n)} bytes",
  SpawnFailed(m) => "spawn failed: ${m}",
  AbnormalExit(_, name) => "killed by signal ${name}"
}

-- The result shape every exec-backed tool returns.
pure func outputJson(out: ProcessOutput) -> Json = outputJsonIn(out, "")

-- s without the per-request directory, in both spellings tools print it
-- ("/tmp/ailang-exec/<uuid>/" and, in MOD010's canonical path, without the
-- leading slash). The directory is an internal identifier: the logs already
-- strip it, and a listed connector must not return it either. "" = unchanged.
pure func scrubDir(s: string, dir: string) -> string =
  if dir == "" then s else replace(replace(s, "${dir}/", ""), "${substring(dir, 1, length(dir))}/", "")

-- outputJson with the request directory scrubbed from stdout and stderr.
pure func outputJsonIn(out: ProcessOutput, dir: string) -> Json =
  jo([kv("ok", jb(out.exitCode == 0)), kv("exit_code", jnum(intToFloat(out.exitCode))), kv("stdout", js(scrubDir(toString(out.stdout), dir))), kv("stderr", js(scrubDir(toString(out.stderr), dir))), kv("truncated", jb(out.truncated))])

-- First non-blank line of s, without the request directory and a leading
-- "Error: ", clipped. Error text names <dir>/main.ail in several spellings.
pure func firstLine(s: string, dir: string) -> string {
  -- "policy:" is the supervisor's echo of the policy it applied, never the error.
  let lines = filter(\l. trim(l) != "" && !startsWith(l, "policy:"), split(s, "\n"));
  match lines {
    [] => "",
    [l, ..._] => {
      let noDir = scrubDir(l, dir);
      clip(trim(replace(noDir, "Error: ", "")), maxErrorChars())
    }
  }
}

pure func outcomeFields(outcome: string, err: string) -> [Field] =
  if err == "" then [kv("outcome", js(outcome))] else [kv("outcome", js(outcome)), kv("error", js(err))]

-- Classify an `ailang run --policy` result. The supervisor prints a decision
-- JSON on stdout when it refuses a program (error_kind: typecheck_failed,
-- policy_violation, ...); timeouts and limits come as a policy-result line on
-- stderr, runtime errors (RTxxx) as an Error: line.
pure func runOutcome(out: ProcessOutput, dir: string) -> [Field] {
  let stdout = toString(out.stdout);
  let stderr = toString(out.stderr);
  if out.exitCode == 0 then outcomeFields("ok", "") else match decode(stdout) {
    Ok(j) => match get(j, "decision") {
      Some(d) => match getBool(d, "ok") {
        Some(false) => {
          let kind = match getString(d, "error_kind") { Some(k) => k, None => "refused" };
          let msg = match getString(d, "message") { Some(m) => m, None => "" };
          outcomeFields(kind, firstLine(msg, dir))
        },
        _ => runtimeOutcome(stderr, dir)
      },
      None => runtimeOutcome(stderr, dir)
    },
    Err(_) => runtimeOutcome(stderr, dir)
  }
}

-- The supervisor's verdict on a run that started: a "policy-result: {json}"
-- line on stderr whose reason (timeout, output_limit, ...) is authoritative.
pure func policyResult(stderr: string) -> Option[Json] =
  match filter(\l. startsWith(l, "policy-result: "), split(stderr, "\n")) {
    [] => None,
    [l, ..._] => match decode(substring(l, length("policy-result: "), length(l))) {
      Ok(j) => Some(j),
      Err(_) => None
    }
  }

pure func runtimeOutcome(stderr: string, dir: string) -> [Field] = match policyResult(stderr) {
  Some(pr) => match getString(pr, "reason") {
    Some(reason) => outcomeFields(reason, match getString(pr, "message") { Some(m) => clip(m, maxErrorChars()), None => "" }),
    None => runtimeOrFailed(stderr, dir)
  },
  None => runtimeOrFailed(stderr, dir)
}

pure func runtimeOrFailed(stderr: string, dir: string) -> [Field] =
  if contains(stderr, "RT0") then outcomeFields("runtime_error", firstLine(stderr, dir)) else outcomeFields("failed", firstLine(stderr, dir))

-- The `verify.outcome` of an ai-check report on stdout ("" when absent).
pure func reportVerifyOutcome(stdout: string) -> string = match decode(stdout) {
  Ok(j) => match get(j, "verify") {
    Some(v) => match getString(v, "outcome") { Some(o) => o, None => "" },
    None => ""
  },
  Err(_) => ""
}

-- Classify an ai-check report: check.passed, the error count, the first error,
-- any Z3 counterexamples, and the verification outcome. A program that
-- type-checks but whose contracts could not be verified (this host has no
-- solver) is logged as "ok_unverified", one whose verification failed as
-- "verify_failed" — never as a plain "ok".
pure func checkOutcome(out: ProcessOutput, dir: string) -> [Field] = match decode(toString(out.stdout)) {
  Err(_) => outcomeFields("failed", firstLine(toString(out.stderr), dir)),
  Ok(j) => {
    let chk = match get(j, "check") { Some(c) => c, None => j };
    let passed = match getBool(chk, "passed") { Some(b) => b, None => false };
    let count = match getInt(chk, "error_count") { Some(n) => n, None => 0 };
    let first = match getArray(chk, "errors") {
      Some([e, ..._]) => match getString(e, "message") { Some(m) => firstLine(m, dir), None => "" },
      _ => ""
    };
    let cex = match get(j, "verify") {
      Some(v) => match getInt(v, "counterexample") { Some(n) => n, None => 0 },
      None => 0
    };
    let vout = reportVerifyOutcome(toString(out.stdout));
    let outcome = if !passed then "check_failed" else if vout == "not_requested" then "ok_unverified" else if out.exitCode != 0 then "verify_failed" else "ok";
    outcomeFields(outcome, first) ++ [kv("error_count", jint(count)), kv("counterexamples", jint(cex)), kv("verify_outcome", js(vout))]
  }
}

-- What a REMOTE caller is told when this host cannot verify contracts. It
-- replaces the CLI's local install advice, which names files and commands on
-- a machine the caller does not control.
pure func noSolverMessage() -> string = "contract verification is not available on this hosted tool; type checking passed"

-- The `verification` value for a report: the report's verify.outcome, except
-- that a type check run without the verifier (`not_requested`: this host has
-- no solver) is "unavailable", and a missing report is "unknown".
pure func verificationOf(outcome: string) -> string =
  if outcome == "not_requested" then "unavailable" else if outcome == "" then "unknown" else outcome

-- ailang_check's result: the Stable envelope {ok, exit_code, stdout, stderr,
-- truncated}, every field with its old meaning (ok is exit_code == 0, and
-- exit_code is the real status of the command that ran), plus two ADDITIVE
-- fields:
--   verification          "verified", "partial", "unproved", "counterexample",
--                         "inconclusive", "error", "no_obligations",
--                         "not_run" (type check failed), "unavailable" (this
--                         host has no solver; see ailangCheck), "unknown"
--   verification_message  only when verification is "unavailable"
-- Like every exec result, it never names the per-request directory (scrubDir).
pure func checkResultJson(out: ProcessOutput, dir: string) -> Json {
  let stdout = scrubDir(toString(out.stdout), dir);
  let verification = verificationOf(reportVerifyOutcome(stdout));
  let base = [kv("ok", jb(out.exitCode == 0)), kv("exit_code", jnum(intToFloat(out.exitCode))), kv("stdout", js(stdout)), kv("stderr", js(scrubDir(toString(out.stderr), dir))), kv("truncated", jb(out.truncated)), kv("verification", js(verification))];
  jo(if verification == "unavailable" then base ++ [kv("verification_message", js(noSolverMessage()))] else base)
}

-- A program with no contracts, used only to ask the ailang binary whether it
-- can find a solver.
pure func probeProgram() -> string = "module main\nexport pure func probe(x: int) -> int = x\n"

-- Whether this host can run the solver. Decided by the ailang binary itself
-- (`ai-check --no-verify` reports verify.available from the CLI's own Z3
-- resolution: AILANG_Z3_PATH, then PATH and the usual install paths) on a
-- fixed contract-free probe — never on the caller's code, and never by
-- running a verification and retrying. The answer is cached in the work root,
-- keyed by the binary and the two variables the resolution reads, so it is
-- probed once per host configuration: an image that later ships z3 starts
-- verifying with no code change. A probe that cannot run is not cached.
func solverAvailable() -> bool ! {Env, FS, Process, Rand} {
  let key = substring(sha256Hex(concat([ailangBin(), "|", getEnvOr("AILANG_Z3_PATH", ""), "|", getEnvOr("PATH", "")])), 0, 12);
  let cache = "${workRoot()}/.solver-available-${key}";
  match readFileResult(cache) {
    Ok(s) => trim(s) == "yes",
    Err(_) => match probeSolver() {
      Some(found) => {
        let _ = mkdirAllResult(workRoot());
        let _ = writeFileResult(cache, if found then "yes" else "no");
        found
      },
      None => false
    }
  }
}

func probeSolver() -> Option[bool] ! {Env, FS, Process, Rand} =
  match withRequestFile(probeProgram(), \dir. execAilang(["ai-check", "-relax-modules", "--no-verify", "${dir}/main.ail"], \_. [])) {
    (j, _) => match getString(j, "stdout") {
      Some(s) => match decode(s) {
        Ok(r) => match get(r, "verify") {
          Some(v) => getBool(v, "available"),
          None => None
        },
        Err(_) => None
      },
      None => None
    }
  }

-- Run `ailang <args>`, returning the tool result and its log fields.
func execAilang(args: [string], classify: ProcessOutput -> [Field]) -> (Json, [Field]) ! {Env, Process} =
  execAilangIn("", args, classify)

-- execAilang for a per-request directory: the result never names `dir`.
func execAilangIn(dir: string, args: [string], classify: ProcessOutput -> [Field]) -> (Json, [Field]) ! {Env, Process} =
  execAilangWith(args, \out. outputJsonIn(out, dir), classify)

-- execAilang with the tool's own result shape.
func execAilangWith(args: [string], render: ProcessOutput -> Json, classify: ProcessOutput -> [Field]) -> (Json, [Field]) ! {Env, Process} =
  match exec(ailangBin(), args) {
    Ok(out) => (render(out), classify(out) ++ [kv("exit_code", jint(out.exitCode)), kv("truncated", jb(out.truncated))]),
    Err(e) => (errorJson("exec_failed", processErrorText(e)), outcomeFields("exec_failed", processErrorText(e)))
  }

-- Write `source` to <root>/<uuid>/main.ail, run `f` on that directory, clean up.
func withRequestFile(source: string, f: string -> (Json, [Field]) ! {Env, Process}) -> (Json, [Field]) ! {Env, FS, Process, Rand} =
  if length(source) > maxCodeBytes() then (errorJson("code_too_large", "code must be <= ${show(maxCodeBytes())} bytes"), outcomeFields("code_too_large", "")) else {
    let dir = "${workRoot()}/${uuid4()}";
    let file = "${dir}/main.ail";
    match mkdirAllResult(dir) {
      Err(m) => (errorJson("workdir_failed", m), outcomeFields("workdir_failed", m)),
      Ok(_) => match writeFileResult(file, source) {
        Err(m) => (errorJson("write_failed", m), outcomeFields("write_failed", m)),
        Ok(_) => {
          let result = f(dir);
          let _ = removeFileResult(file);
          -- ai-check leaves an empty compile-cache tree, and removeDirResult
          -- is never recursive: take it down bottom-up.
          let _ = removeDirResult("${dir}/.ailang/cache/compile");
          let _ = removeDirResult("${dir}/.ailang/cache");
          let _ = removeDirResult("${dir}/.ailang");
          let _ = removeDirResult(dir);
          result
        }
      }
    }
  }

-- Emit the one executor_call line for a finished call and return its result.
func logged(tool: string, startMs: int, extra: [Field], r: (Json, [Field])) -> Json ! {Clock, Debug} = match r {
  (result, fields) => {
    log(encode(jo([kv("event", js("executor_call")), kv("tool", js(tool)), kv("duration_ms", jint(now() - startMs))] ++ extra ++ fields)));
    result
  }
}

pure func codeFields(code: string) -> [Field] =
  [kv("code_bytes", jint(length(code))), kv("code_sha", js(substring(sha256Hex(code), 0, 12)))]

func runCode(tool: string, code: string, source: string) -> Json ! {Clock, Debug, Env, FS, Process, Rand} {
  let t0 = now();
  logged(tool, t0, codeFields(code), withRequestFile(source, \dir. execAilangIn(dir, ["run", "--policy", policyPath(), "--chdir", dir, "main.ail"], \out. runOutcome(out, dir))))
}

-- Call this FIRST: the AILANG teaching prompt (syntax rules, templates,
-- stdlib map). AILANG is not in your training data the way Python is; code
-- written without this prompt rarely type-checks.
@route("POST", "/api/executor/ailang_prompt")
@mcp_name("ailang_prompt")
@mcp_title("AILANG syntax prompt")
@mcp_hints("readOnly", "idempotent")
export func ailangPrompt() -> Json ! {Clock, Debug, Env, Process} {
  let t0 = now();
  logged("ailang_prompt", t0, [], execAilang(["prompt"], \out. outcomeFields(if out.exitCode == 0 then "ok" else "failed", "")))
}

-- Type-check AILANG source. `code` is a whole module; the module line may be
-- omitted or be `module main`. Returns the ai-check JSON report on stdout:
-- check.passed and check.errors (with locations and fixes), and verify: each
-- function's requires/ensures proved with Z3 (verify.results: verified,
-- counterexample with a witness, or inconclusive after 5s per function).
-- Only `pure` functions (or `! {}`) are proved; others report skipped/NOT_PURE.
-- `verification` names the overall result; "unavailable" means this server
-- had no solver, so the code was type-checked only and its contracts were not
-- proved (prove them locally with `ailang verify`).
@route("POST", "/api/executor/ailang_check")
@mcp_name("ailang_check")
@mcp_title("Check AILANG code")
@mcp_hints("readOnly", "idempotent")
export func ailangCheck(code: string) -> Json ! {Clock, Debug, Env, FS, Process, Rand} {
  let t0 = now();
  -- Without a solver, ask for the type check only, so a program that
  -- type-checks really exits 0 (no exit code is ever rewritten).
  let mode = if solverAvailable() then [] else ["--no-verify"];
  logged("ailang_check", t0, codeFields(code), withRequestFile(code, \dir. execAilangWith(["ai-check", "-relax-modules"] ++ mode ++ ["${dir}/main.ail"], \out. checkResultJson(out, dir), \out. checkOutcome(out, dir))))
}

-- Run AILANG source in the hosted sandbox. Entry point is `main`, with no
-- arguments. Only the IO capability is granted (println works; FS, Net,
-- Process, Env and AI are refused by name before the program starts), and the
-- run is killed at the policy timeout. stdout is the program's output; stderr
-- carries the policy decision JSON.
@route("POST", "/api/executor/ailang_run")
@mcp_name("ailang_run")
@mcp_title("Run AILANG code (sandboxed)")
@mcp_hints("readOnly", "idempotent")
export func ailangRun(code: string) -> Json ! {Clock, Debug, Env, FS, Process, Rand} = runCode("ailang_run", code, code)

-- Evaluate one pure AILANG expression and print it with show(). Builtins are
-- in scope; for stdlib functions (map, filter, ...) use ailang_run with
-- explicit imports.
@route("POST", "/api/executor/ailang_eval")
@mcp_name("ailang_eval")
@mcp_title("Evaluate an AILANG expression")
@mcp_hints("readOnly", "idempotent")
export func ailangEval(expression: string) -> Json ! {Clock, Debug, Env, FS, Process, Rand} =
  runCode("ailang_eval", expression, concat(["module main\nimport std/io (println)\nexport func main() -> () ! {IO} = println(show(\n", expression, "\n))\n"]))

-- List AILANG builtin functions with documentation, grouped by module.
-- `search` filters lines case-insensitively; empty returns everything.
@route("POST", "/api/executor/ailang_builtins")
@mcp_name("ailang_builtins")
@mcp_title("AILANG builtins")
@mcp_hints("readOnly", "idempotent")
export func ailangBuiltins(search: string) -> Json ! {Clock, Debug, Env, Process} {
  let t0 = now();
  let r = match exec(ailangBin(), ["builtins", "list", "--verbose", "--by-module"]) {
    Err(e) => (errorJson("exec_failed", processErrorText(e)), outcomeFields("exec_failed", processErrorText(e))),
    -- The listing lands on stdout or stderr depending on how the CLI is
    -- launched; read both.
    Ok(out) => if search == "" then (jo([kv("ok", jb(true)), kv("stdout", js("${toString(out.stdout)}${toString(out.stderr)}"))]), outcomeFields("ok", "")) else {
      let q = toLower(search);
      let hits = filter(\l. contains(toLower(l), q), split("${toString(out.stdout)}${toString(out.stderr)}", "\n"));
      (jo([kv("ok", jb(true)), kv("stdout", js(if hits == [] then "No matches found" else join("\n", hits)))]), outcomeFields(if hits == [] then "no_match" else "ok", "") ++ [kv("hits", jint(listLength(hits)))])
    }
  };
  logged("ailang_builtins", t0, [kv("search", js(clip(search, 80)))], r)
}
