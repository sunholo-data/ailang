module test/if_else

export func abs(x: int) -> int =
  if x < 0 then 0 - x else x

export func classify(n: int) -> string =
  if n < 0 then "negative"
  else if n == 0 then "zero"
  else "positive"

export func clamp(x: int, lo: int, hi: int) -> int =
  if x < lo then lo
  else if x > hi then hi
  else x
