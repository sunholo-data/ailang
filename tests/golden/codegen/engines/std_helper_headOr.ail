-- Engine parity fixture (engines_test.go): evaluator, --bytecode and --strict-bytecode
-- must print the same summary(). Recovered from the Go emitter's known_failures (#2389); the issue below was emitter-only.
-- #2259: a std function written in AILANG emits a call to a Go helper that
-- does not exist (undefined: HeadOr).
module harness/kf/std_helper_headOr

import std/list (headOr)

export pure func summary() -> string = show(headOr([4, 5], 0))
