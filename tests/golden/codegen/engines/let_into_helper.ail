-- Engine parity fixture (engines_test.go): evaluator, --bytecode and --strict-bytecode
-- must print the same summary(). Recovered from the Go emitter's known_failures (#2389); the issue below was emitter-only.
-- #2262: a module-level let passed to a mapped std helper is type-asserted as
-- interface{} ("is not an interface").
module harness/kf/let_into_helper

import std/string (startsWith)

let prefix = "hi"

export pure func summary() -> string = show(startsWith("hit", prefix))
