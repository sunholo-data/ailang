-- ailang#1354 / #1355: record types that share field names at different
-- sorted positions. The bytecode compiler used to pick a field's slot from
-- whichever registered type it met first in Go map order, so `v.x` could
-- read M's slot for x (2) instead of V's (0): an out-of-range error or a
-- silently wrong value, differing from run to run. Every access below must
-- match the interpreter on every run, under --strict-bytecode.
module tests/golden/bytecode/shared_field_names

type M = { a: float, b: float, x: float }

type V = { x: float, y: float }

type P = V

type Q = P

type Motion = { phi: float, tau: float, t: float, x: float }

type Vec3 = { x: float, y: float, z: float }

type Ship = { motion: Motion, pos: Vec3 }

pure func mx(m: M) -> float = m.x

pure func vx(v: V) -> float = v.x

pure func px(p: P) -> float = p.x

pure func qy(q: Q) -> float = q.y

pure func mkV(k: float) -> V = { x: k, y: k * 2.0 }

pure func vupd(v: V) -> V = { v | x: 99.0 }

pure func vsum(v: V) -> float = v.x + v.y

pure func step(s: Ship) -> Ship = { s | pos: { s.pos | x: s.pos.x + s.motion.x } }

export pure func main(n: int) -> string {
  let v = mkV(10.0)
  let s = step({ motion: { phi: 1.0, tau: 2.0, t: 3.0, x: 4.0 }, pos: { x: 100.0, y: 200.0, z: 300.0 } })
  let setX = \r. { r | x: 42.0 }
  let getX = \r. r.x
  let pm = setX({ a: 1.0, b: 2.0, x: 3.0 })
  let pv = setX({ x: 10.0, y: 20.0 })
  let named = [mx({ a: 1.0, b: 2.0, x: 3.0 }), vx({ x: 10.0, y: 20.0 }), px({ x: 5.0, y: 6.0 }), qy({ x: 5.0, y: 6.0 }), v.x, (mkV(7.0)).y]
  let nested = [vsum(vupd({ x: 1.0, y: 2.0 })), s.pos.x, s.pos.y, s.pos.z, s.motion.x, s.motion.t]
  let poly = [getX(pm), pm.a, pm.b, getX(pv), pv.y]
  "${show(named)} ${show(nested)} ${show(poly)}"
}
