module harness/string_ops

import std/string (trim, toUpper, toLower, split, join, contains, substring, repeat, chars)

export pure func testTrim(s: string) -> string = trim(s)
export pure func testUpper(s: string) -> string = toUpper(s)
export pure func testLower(s: string) -> string = toLower(s)
export pure func testSplit(s: string) -> [string] = split(s, ",")
export pure func testJoin(xs: [string]) -> string = join(", ", xs)
export pure func testContains(s: string) -> bool = contains(s, "hello")
-- startsWith/endsWith with a module-level let (#2262) and length (#2261) are
-- known failures: see known_failures/known_failures.tsv.
export pure func testSubstring(s: string) -> string = substring(s, 0, 5)
export pure func testRepeat(s: string) -> string = repeat(s, 3)
export pure func testChars(s: string) -> [string] = chars(s)
