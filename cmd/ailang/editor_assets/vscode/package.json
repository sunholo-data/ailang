{
  "name": "ailang",
  "displayName": "AILANG Language Support",
  "description": "Syntax highlighting + LSP (diagnostics, hover, definition, references, document symbols) for AILANG (.ail) files. Spawns `ailang lsp --stdio` — requires the ailang binary on PATH.",
  "version": "0.3.0",
  "publisher": "sunholo",
  "repository": {
    "type": "git",
    "url": "https://github.com/sunholo-data/ailang"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ailang",
        "aliases": ["AILANG", "ailang", "Ailang"],
        "extensions": [".ail"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ailang",
        "scopeName": "source.ailang",
        "path": "./syntaxes/ailang.tmLanguage.json"
      }
    ]
  }
}
