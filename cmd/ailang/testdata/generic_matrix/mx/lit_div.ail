module mx/lit_div
import std/io (print)

-- #2378: an integer literal in a generic body; genU must print what the twin
-- of its argument's type prints, on every engine.
export pure func genU(x) = x / 2
export pure func gen(x) = genU(x)
export pure func twinI(x: int) = x / 2
export pure func twinF(x: float) = x / 2.0
export pure func summary() -> string {
  let r1 = genU(7); let r2 = gen(7); let r3 = twinI(7);
  let f1 = genU(7.0); let f2 = gen(7.0); let f3 = twinF(7.0);
  "genUI=${show(r1)}\ngenI=${show(r2)}\ntwinI=${show(r3)}\ngenUF=${show(f1)}\ngenF=${show(f2)}\ntwinF=${show(f3)}\n"
}
export func main() -> () ! {IO} = print(summary())
