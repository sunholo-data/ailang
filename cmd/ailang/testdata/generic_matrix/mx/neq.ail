module mx/neq
import std/option (Option, Some, None)
import std/list (sortBy)
import std/io (print)

export pure func gen[a](x: a, y: a) -> bool = x * y != x
export pure func twinI(x: int, y: int) -> bool = x * y != x
export pure func twinF(x: float, y: float) -> bool = x * y != x
export pure func summary() -> string = "genI=${show(gen(3, 4))}\n twinI=${show(twinI(3, 4))}\n genF=${show(gen(1.5, 2.25))}\n twinF=${show(twinF(1.5, 2.25))}\n"
export func main() -> () ! {IO} = print(summary())
