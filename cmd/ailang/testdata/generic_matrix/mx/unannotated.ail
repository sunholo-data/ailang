module mx/unannotated
import std/io (print)

-- an unannotated generic function: the same defaulting, no signature
pure func gen(x, y) = "${show(x * y)} ${show(x % y)}"

pure func twinI(x: int, y: int) -> string = "${show(x * y)} ${show(x % y)}"

pure func twinF(x: float, y: float) -> string = "${show(x * y)} ${show(x % y)}"

export pure func summary() -> string =
  "genI=${gen(3, 4)}\n twinI=${twinI(3, 4)}\n genF=${gen(1.5, 2.25)}\n twinF=${twinF(1.5, 2.25)}\n"

export func main() -> () ! {IO} = print(summary())
