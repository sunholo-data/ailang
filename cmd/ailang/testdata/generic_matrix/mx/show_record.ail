module mx/show_record
import std/option (Option, Some, None)
import std/list (sortBy)
import std/io (print)

export pure func genR[a](x: a, y: a) -> string { let r = {v: x + y, w: x}; show(r) }
export pure func genU(x, y) { let r = {v: x + y, w: x}; show(r) }
export pure func genL[a](x: a, y: a) -> string { let k = \pp qq. { let r = {v: pp + qq, w: pp}; show(r) }; k(x, y) }
export pure func genF[a](x: a, y: a) -> string { let k = func(pp: a, qq: a) -> string { { let r = {v: pp + qq, w: pp}; show(r) } }; k(x, y) }
export pure func twinI(x: int, y: int) -> string { let r = {v: x + y, w: x}; show(r) }
export pure func twinLI(x: int, y: int) -> string { let k = \pp qq. { let r = {v: pp + qq, w: pp}; show(r) }; k(x, y) }
export pure func twinF(x: float, y: float) -> string { let r = {v: x + y, w: x}; show(r) }
export pure func twinLF(x: float, y: float) -> string { let k = \pp qq. { let r = {v: pp + qq, w: pp}; show(r) }; k(x, y) }
export pure func summary() -> string = "genRI=${genR(3, 4)}\ngenUI=${genU(3, 4)}\ngenLI=${genL(3, 4)}\ngenFI=${genF(3, 4)}\ntwinI=${twinI(3, 4)}\ntwinLI=${twinLI(3, 4)}\ngenRF=${genR(1.5, 2.25)}\ngenUF=${genU(1.5, 2.25)}\ngenLF=${genL(1.5, 2.25)}\ngenFF=${genF(1.5, 2.25)}\ntwinF=${twinF(1.5, 2.25)}\ntwinLF=${twinLF(1.5, 2.25)}\n"
export func main() -> () ! {IO} = print(summary())
