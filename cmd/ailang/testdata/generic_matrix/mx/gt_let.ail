module mx/gt_let
import std/option (Option, Some, None)
import std/list (sortBy)
import std/io (print)

export pure func genR[a](x: a, y: a) -> bool { let d = x - y; d > y }
export pure func genU(x, y) { let d = x - y; d > y }
export pure func genL[a](x: a, y: a) -> bool { let k = \pp qq. { let d = pp - qq; d > qq }; k(x, y) }
export pure func genF[a](x: a, y: a) -> bool { let k = func(pp: a, qq: a) -> bool { { let d = pp - qq; d > qq } }; k(x, y) }
export pure func twinI(x: int, y: int) -> bool { let d = x - y; d > y }
export pure func twinLI(x: int, y: int) -> bool { let k = \pp qq. { let d = pp - qq; d > qq }; k(x, y) }
export pure func twinF(x: float, y: float) -> bool { let d = x - y; d > y }
export pure func twinLF(x: float, y: float) -> bool { let k = \pp qq. { let d = pp - qq; d > qq }; k(x, y) }
export pure func summary() -> string = "genRI=${show(genR(3, 4))}\ngenUI=${show(genU(3, 4))}\ngenLI=${show(genL(3, 4))}\ngenFI=${show(genF(3, 4))}\ntwinI=${show(twinI(3, 4))}\ntwinLI=${show(twinLI(3, 4))}\ngenRF=${show(genR(1.5, 2.25))}\ngenUF=${show(genU(1.5, 2.25))}\ngenLF=${show(genL(1.5, 2.25))}\ngenFF=${show(genF(1.5, 2.25))}\ntwinF=${show(twinF(1.5, 2.25))}\ntwinLF=${show(twinLF(1.5, 2.25))}\n"
export func main() -> () ! {IO} = print(summary())
