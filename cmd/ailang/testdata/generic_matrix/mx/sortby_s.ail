module mx/sortby_s
import std/option (Option, Some, None)
import std/list (sortBy)
import std/io (print)

export pure func gen[a](x: a, y: a) -> string = show(sortBy(\p q. if p < q then -1 else 1, [y, x]))
export pure func twinI(x: int, y: int) -> string = show(sortBy(\p q. if p < q then -1 else 1, [y, x]))
export pure func twinF(x: float, y: float) -> string = show(sortBy(\p q. if p < q then -1 else 1, [y, x]))
export pure func twinS(x: string, y: string) -> string = show(sortBy(\p q. if p < q then -1 else 1, [y, x]))
export pure func summary() -> string = "genI=${gen(3, 4)}\n twinI=${twinI(3, 4)}\n genF=${gen(1.5, 2.25)}\n twinF=${twinF(1.5, 2.25)}\n genS=${gen("p", "q")}\n twinS=${twinS("p", "q")}\n"
export func main() -> () ! {IO} = print(summary())
