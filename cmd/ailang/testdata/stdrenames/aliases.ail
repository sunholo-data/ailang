-- Exercises all 16 canonical post-rename stdlib exports across evaluator and
-- bytecode VM (TestStdlibRenameAliases). Zero TC_DEPRECATED_001 warnings.
module test/stdrenames/aliases
import std/io (println, eprint)
import std/list (headOr, lastOr, nthOr, contains)
import std/string (charAtOr)
import std/math (absInt, absFloat)
import std/rand (randInt, randFloat, randBool, randSeed)
import std/fs (readFileBase64, walkWithSuffix)
import std/bytes (fromString, toString, sliceLen)
import std/array (fromList, get)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)

pure func showBytes(o: Option[bytes]) -> string = match o {
  Some(b) => "Some(${toString(b)})",
  None => "None"
}

pure func showRes(r: Result[string, string]) -> string = match r {
  Ok(s) => "Ok(${show(length(s))} chars)",
  Err(e) => "Err(${e})"
}

pure func length(s: string) -> int = _str_len(s)

func row(name: string, val: string) -> () ! {IO} = println("${name}: ${val}")

export func main() -> () ! {IO, FS, Rand} {
  let xs = [10, 20, 30]
  row("headOr", show(headOr(xs, 0)))
  row("lastOr", show(lastOr(xs, 0)))
  row("nthOr", show(nthOr(xs, 1, 0)))
  row("charAtOr", charAtOr("héllo", 1, "?"))
  row("absInt", show(absInt(0 - 42)))
  row("absFloat", show(absFloat(0.0 - 2.5)))
  randSeed(7)
  let b = randInt(1, 1000000)
  let fb = randFloat(0.0, 1.0)
  let bb = randBool()
  row("randSeed+randInt", show(b))
  row("randFloat", show(fb))
  row("randBool", show(bb))
  let here = "cmd/ailang/testdata/stdrenames/aliases.ail"
  row("readFileBase64", showRes(readFileBase64(here)))
  row("walkWithSuffix", show(walkWithSuffix("cmd/ailang/testdata/stdrenames/samepos", ".ail")))
  let bs = fromString("hello")
  row("sliceLen", showBytes(sliceLen(bs, 1, 3)))
  row("contains", show(contains(xs, 20)))
  let arr = fromList(xs)
  row("get", show(get(arr, 2)))
  eprint("eprint|")
  println("done")
}
