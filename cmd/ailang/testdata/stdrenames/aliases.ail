-- Deliberately uses every deprecated std spelling once (16 TC_DEPRECATED_001
-- warnings), next to its replacement, and prints one line per pair:
--   <old> -> <new>: <old result> | <new result>
-- TestStdlibRenameAliases asserts the two results agree on every line and the
-- transcript is identical on the evaluator and the strict bytecode VM.
module cmd/ailang/testdata/stdrenames/aliases
import std/io (println, eprint, printErr)
import std/list (headOr, head_or, lastOr, last_or, nthOr, nth_or, contains, member)
import std/string (charAtOr, charAt_or)
import std/math (absInt, abs_Int, absFloat, abs_Float)
import std/rand (randInt, rand_int, randFloat, rand_float, randBool, rand_bool, randSeed, rand_seed)
import std/fs (readFileBase64, readFileBytes, walkWithSuffix, glob)
import std/bytes (fromString, toString, sliceLen, slice)
import std/array (fromList, get, unsafeGet)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err)

pure func showBytes(o: Option[bytes]) -> string = match o {
  Some(b) => "Some(${toString(b)})",
  None => "None"
}

pure func showRes(r: Result[string, string]) -> string = match r {
  Ok(s) => "Ok(${show(length(s))} chars)",
  Err(e) => "Err(${e})"
}

pure func length(s: string) -> int = _str_len(s)

func pair(name: string, old: string, new: string) -> () ! {IO} = println("${name}: ${old} | ${new}")

export func main() -> () ! {IO, FS, Rand} {
  let xs = [10, 20, 30]
  pair("head_or -> headOr", show(head_or(xs, 0)), show(headOr(xs, 0)))
  pair("last_or -> lastOr", show(last_or(xs, 0)), show(lastOr(xs, 0)))
  pair("nth_or -> nthOr", show(nth_or(xs, 1, 0)), show(nthOr(xs, 1, 0)))
  pair("charAt_or -> charAtOr", charAt_or("héllo", 1, "?"), charAtOr("héllo", 1, "?"))
  pair("abs_Int -> absInt", show(abs_Int(0 - 42)), show(absInt(0 - 42)))
  pair("abs_Float -> absFloat", show(abs_Float(0.0 - 2.5)), show(absFloat(0.0 - 2.5)))
  rand_seed(7)
  let a = rand_int(1, 1000000)
  let fa = rand_float(0.0, 1.0)
  let ba = rand_bool()
  randSeed(7)
  let b = randInt(1, 1000000)
  let fb = randFloat(0.0, 1.0)
  let bb = randBool()
  pair("rand_seed+rand_int -> randSeed+randInt", show(a), show(b))
  pair("rand_float -> randFloat", show(fa), show(fb))
  pair("rand_bool -> randBool", show(ba), show(bb))
  let here = "cmd/ailang/testdata/stdrenames/aliases.ail"
  pair("readFileBytes -> readFileBase64", showRes(readFileBytes(here)), showRes(readFileBase64(here)))
  pair("glob -> walkWithSuffix", show(glob("cmd/ailang/testdata/stdrenames", ".ail")), show(walkWithSuffix("cmd/ailang/testdata/stdrenames", ".ail")))
  let bs = fromString("hello")
  pair("slice -> sliceLen", showBytes(slice(bs, 1, 3)), showBytes(sliceLen(bs, 1, 3)))
  pair("member(x, xs) -> contains(xs, x)", show(member(20, xs)), show(contains(xs, 20)))
  let arr = fromList(xs)
  pair("unsafeGet -> get", show(unsafeGet(arr, 2)), show(get(arr, 2)))
  printErr("printErr|")
  eprint("eprint|")
  println("done")
}
