-- Exercises the pure canonical post-rename stdlib exports on both evaluator
-- and --strict-bytecode VM (TestStdlibRenameAliases).
module test/stdrenames/aliases_pure
import std/io (println)
import std/list (headOr, lastOr, nthOr, contains, map)
import std/string (charAtOr)
import std/math (absInt, absFloat)
import std/bytes (fromString, toString, sliceLen)
import std/array (fromList, get)
import std/option (Option, Some, None)

pure func showBytes(o: Option[bytes]) -> string = match o {
  Some(b) => "Some(${toString(b)})",
  None => "None"
}

func row(name: string, val: string) -> () ! {IO} = println("${name}: ${val}")

export func main() -> () ! {IO} {
  let xs = [10, 20, 30]
  row("headOr", show(headOr([], 7)))
  row("lastOr", show(lastOr(xs, 0)))
  row("nthOr", show(nthOr(xs, 9, 0 - 1)))
  row("charAtOr", charAtOr("héllo", 1, "?"))
  row("absInt (as a value)", show(map(absInt, [0 - 3, 4])))
  row("absFloat", show(absFloat(0.0 - 2.5)))
  let bs = fromString("hello")
  row("sliceLen", showBytes(sliceLen(bs, 1, 3)))
  row("sliceLen out of range", showBytes(sliceLen(bs, 4, 3)))
  row("contains", show(contains(xs, 40)))
  let arr = fromList(xs)
  row("get", show(get(arr, 2)))
  println("done")
}
