# Force LF line endings for all text files
* text=auto

# Force LF for golden test files (prevents Windows CRLF issues)
*.golden text eol=lf

# Force LF for prompt files (prevents hash mismatches on Windows)
prompts/*.md text eol=lf

# Force LF for shell scripts
*.sh text eol=lf

# Force LF for headroom fixtures (a fixture that changes shape on checkout is not a fixture)
tools/ci/headroom/testdata/*.txt text eol=lf

# Trace baselines (generated, hide from diffs)
examples/traces/*.jsonl linguist-generated text eol=lf

# AILANG language recognition
# Uses OCaml highlighting as closest match until AILANG is added to Linguist
*.ail linguist-language=OCaml linguist-detectable

# Binary files
*.png binary
*.jpg binary
*.pdf binary
*.zip binary
*.tar.gz binary
