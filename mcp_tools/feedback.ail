-- mcp_tools/feedback.ail — public feedback channel (M7).
--
-- Validates anonymous bug/feature/docs reports submitted via MCP. The actual
-- Pub/Sub publish to the ailang-messages topic is deferred to a Go-side
-- builtin in M7.1 (one focused commit, ~80 LOC) — the wire requires
-- coordinating Firestore-store + pubsub-notifier the same way the existing
-- `ailang messages send` CLI does. The IAM binding granting the MCP
-- service account roles/pubsub.publisher on the ailang-messages topic is
-- live as of M7 (see ailang-multivac/terraform/cloud_run_mcp.tf), so the
-- only remaining work is wiring the publish call.
--
-- For now this validates inputs and returns a deterministic placeholder
-- ticket_id so the tool surface advertises the right shape to agents.
-- Submissions are NOT yet reaching the public-feedback inbox.
module mcp_tools/feedback

import mcp_tools/lib (errorJson)
import std/json (Json, jo, kv, js, jb)
import std/string (length)

-- Validate a category against the allowed enum.
pure func validCategory(c: string) -> bool =
  c == "bug" || c == "feature" || c == "docs" || c == "limitation"

-- True when category is NOT in the allowed set (avoids `!` prefix operator).
pure func invalidCategory(c: string) -> bool =
  if validCategory(c) then false else true

-- Anonymous bug report / feature request / docs gap, queued for human review.
-- ailang_version: the reporter's CLI version (free-form string, used for triage).
-- snippet: optional code/error snippet (≤4 KB).
-- contact: optional follow-up address (free-form, opaque to the server).
@route("POST", "/api/mcp/submit_feedback")
@mcp_name("submit_feedback")
export func submitFeedback(
  title: string,
  body: string,
  category: string,
  ailangVersion: string,
  snippet: string,
  contact: string
) -> Json ! {Env, FS} =
  if title == "" then
    errorJson("missing_field", "title is required")
  else if body == "" then
    errorJson("missing_field", "body is required")
  else if length(body) > 10240 then
    errorJson("body_too_large", "body must be <= 10240 bytes")
  else if length(snippet) > 4096 then
    errorJson("snippet_too_large", "snippet must be <= 4096 bytes")
  else if invalidCategory(category) then
    errorJson("invalid_category", "category must be one of: bug, feature, docs, limitation")
  else
    -- M7: inputs validated, IAM in place. Pub/Sub wire ships in M7.1 follow-up.
    jo([
      kv("ticket_id", js("pending-publish-wire-m7-1")),
      kv("queued_at", js("1970-01-01T00:00:00Z")),
      kv("status", js("validated")),
      kv("note", js("Inputs validated successfully. The actual Pub/Sub publish to ailang-messages is wired in M7.1; submissions are not yet reaching the public-feedback inbox.")),
      kv("attributes_would_be", jo([
        kv("inbox", js("public-feedback")),
        kv("from_agent", js("mcp-public")),
        kv("category", js(category)),
        kv("message_type", js("feedback")),
        kv("ailang_version", js(ailangVersion))
      ]))
    ])
