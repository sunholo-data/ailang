-- mcp_tools/examples.ail — example-finder MCP tools.
--
-- All version-scoped: examples that PASS under for_version.
module mcp_tools/examples

import mcp_tools/lib (errorJson, envelope, resolveVersion, readVersionedJson, unknownVersionError)
import mcp_tools/live (releaseVersion, fetchFile, isExamplePath, browseUrl)
import std/json (Json, jo, kv, js, ja, jnum, decode, asString, getArray, getString)
import std/option (getOrElse)
import std/result (Result, Ok, Err)
import std/list (filter, take, map, any, length)
import std/string (toLower, contains, trim, split, startsWith, substring, length as strLength)
import std/math (intToFloat)

-- Examples in the release's manifest (examples/manifest.json at its tag).
-- features = comma-separated tags ("effects,records"); empty = no filter.
-- status = "working" | "broken" | "aspirational" | "" ("passing" = working,
-- "failing" = the other two); empty = working only. At most 50 are returned;
-- total says how many matched.
@route("POST", "/api/mcp/examples_list")
@mcp_name("examples_list")
@mcp_title("List examples")
@mcp_hints("readOnly", "idempotent")
export func examplesList(features: string, status: string, forVersion: string) -> Result[Json, string] ! {Env, FS, Net} =
  match releaseVersion(forVersion) {
    Err(reason) => Err(reason),
    Ok(ver) => match fetchFile("v${ver}", "examples/manifest.json") {
      Err(reason) => Err(reason),
      Ok(body) => match decode(body) {
        Err(reason) => Err("examples/manifest.json at v${ver} is not JSON: ${reason}"),
        Ok(manifest) =>
          let wanted = filter(\e. statusMatches(status, getOrElse(getString(e, "status"), "")) && tagsMatch(features, e),
                              getOrElse(getArray(manifest, "examples"), [])) in
          Ok(envelope(ver, jo([
            kv("total", jnum(intToFloat(length(wanted)))),
            kv("examples", ja(map(exampleRow, take(50, wanted))))
          ])))
      }
    }
  }

pure func statusMatches(asked: string, actual: string) -> bool =
  let a = toLower(trim(asked)) in
  if a == "" || a == "passing" then actual == "working"
  else if a == "failing" then actual != "working"
  else actual == a

-- Any requested tag present (case-insensitive); no tags requested = all.
pure func tagsMatch(features: string, e: Json) -> bool =
  let wanted = filter(\t. t != "", map(\t. toLower(trim(t)), split(features, ","))) in
  let tags = map(\t. toLower(getOrElse(asString(t), "")), getOrElse(getArray(e, "tags"), [])) in
  match wanted {
    [] => true,
    _ => any(\w. any(\t. t == w, tags), wanted)
  }

pure func exampleRow(e: Json) -> Json =
  jo([
    kv("path", js(getOrElse(getString(e, "path"), ""))),
    kv("status", js(getOrElse(getString(e, "status"), ""))),
    kv("description", js(getOrElse(getString(e, "description"), ""))),
    kv("tags", ja(getOrElse(getArray(e, "tags"), [])))
  ])

-- Full source of one example by path (as examples_list gives it, e.g.
-- "runnable/hello.ail"; a leading "examples/" is accepted), at the release.
@route("POST", "/api/mcp/example_get")
@mcp_name("example_get")
@mcp_title("Get an example")
@mcp_hints("readOnly", "idempotent")
export func exampleGet(path: string, forVersion: string) -> Result[Json, string] ! {Env, FS, Net} =
  let rel = if startsWith(path, "examples/") then substring(path, 9, strLength(path)) else path in
  if rel == "" then Err("path is required; examples_list gives paths")
  else if !isExamplePath(rel) then Err("not an example path: ${path} (expected something like runnable/hello.ail)")
  else match releaseVersion(forVersion) {
    Err(reason) => Err(reason),
    Ok(ver) => match fetchFile("v${ver}", "examples/${rel}") {
      Err(reason) => Err(reason),
      Ok(src) => Ok(envelope(ver, jo([
        kv("path", js(rel)),
        kv("url", js(browseUrl("v${ver}", "examples/${rel}"))),
        kv("source", js(src))
      ])))
    }
  }

-- Best-fit examples for a free-form concept query ("how do I use effects?").
-- Filters server-side on why + title; returns up to 5 matches.
@route("POST", "/api/mcp/example_for_concept")
@mcp_name("example_for_concept")
@mcp_title("Example for a concept")
@mcp_hints("readOnly", "idempotent")
export func exampleForConcept(concept: string, forVersion: string) -> Json ! {Env, FS} =
  if concept == "" then
    errorJson("missing_field", "concept is required")
  else
    let resolved = resolveVersion(forVersion) in
    if resolved == "unknown" then
      unknownVersionError(forVersion, "latest")
    else
      match readVersionedJson(resolved, "example_concept_index.json") {
        Err(reason) => errorJson("snapshot_read_failed", reason),
        Ok(idx) =>
          let q = toLower(concept) in
          let all = getOrElse(getArray(idx, "examples"), []) in
          let matched = filter(
            \e. contains(toLower(getOrElse(getString(e, "why"), "")), q) ||
                contains(toLower(getOrElse(getString(e, "title"), "")), q),
            all) in
          let top = take(5, matched) in
          envelope(resolved, jo([kv("examples", ja(top)), kv("query", js(concept))]))
      }
