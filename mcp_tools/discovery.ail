-- mcp_tools/discovery.ail — docs navigation and search MCP tools.
module mcp_tools/discovery

import mcp_tools/lib (readOrError, readUnscopedOrError, errorJson, envelope, resolveVersion, readVersionedJson, unknownVersionError)
import std/json (Json, jo, kv, js, ja, getArray, getString)
import std/option (getOrElse)
import std/list (filter, take, map)
import std/string (toLower, contains, find, substring, length, startsWith)

-- The AILANG docs site's navigation tree for a version, as JSON: section and
-- page titles with their paths.
@route("POST", "/api/mcp/docs_nav")
@mcp_name("docs_nav")
@mcp_title("Docs navigation")
@mcp_hints("readOnly", "idempotent")
export func docsNav(forVersion: string) -> Json ! {Env, FS} =
  readOrError(forVersion, "docs_nav.json")

-- Full-text search of the AILANG documentation for a version (case-insensitive,
-- on page titles and text). Returns the top 10 matches, docs pages before
-- archived teaching prompts, each with its path, title, first 10 headings and
-- an excerpt around the match.
@route("POST", "/api/mcp/docs_search")
@mcp_name("docs_search")
@mcp_title("Search AILANG docs")
@mcp_hints("readOnly", "idempotent")
export func docsSearch(query: string, forVersion: string) -> Json ! {Env, FS} =
  if query == "" then
    errorJson("missing_field", "query is required")
  else
    let resolved = resolveVersion(forVersion) in
    if resolved == "unknown" then
      unknownVersionError(forVersion, "latest")
    else
      match readVersionedJson(resolved, "docs_search_index.json") {
        Err(reason) => errorJson("snapshot_read_failed", reason),
        Ok(idx) =>
          let q = toLower(query) in
          let all = getOrElse(getArray(idx, "pages"), []) in
          let matched = filter(
            \p. contains(getOrElse(getString(p, "body"), ""), q) ||
                contains(toLower(getOrElse(getString(p, "title"), "")), q),
            all) in
          let docs = filter(\p. isPrompt(p) == false, matched) in
          let prompts = filter(isPrompt, matched) in
          let top = take(10, docs ++ prompts) in
          envelope(resolved, jo([kv("pages", ja(map(\p. searchHit(p, q), top))), kv("query", js(query))]))
      }

pure func isPrompt(p: Json) -> bool = startsWith(getOrElse(getString(p, "path"), ""), "prompts/")

-- Characters of body kept around the first match (before, after).
pure func excerptBefore() -> int = 200
pure func excerptAfter() -> int = 600

-- body[i-before .. i+after) around the first occurrence of q, or the opening
-- of the body when q only matched the title. The index lowercases bodies.
pure func excerpt(body: string, q: string) -> string {
  let n = length(body);
  let i = find(body, q);
  let from = if i < 0 then 0 else if i > excerptBefore() then i - excerptBefore() else 0;
  let to = if from + excerptBefore() + excerptAfter() > n then n else from + excerptBefore() + excerptAfter();
  substring(body, from, to)
}

pure func searchHit(p: Json, q: string) -> Json =
  jo([kv("path", js(getOrElse(getString(p, "path"), ""))),
      kv("title", js(getOrElse(getString(p, "title"), ""))),
      kv("headings", ja(take(10, getOrElse(getArray(p, "headings"), [])))),
      kv("excerpt", js(excerpt(getOrElse(getString(p, "body"), ""), q)))])

-- What changed in a given release (added/changed/fixed/breaking).
@route("POST", "/api/mcp/changelog_for_version")
@mcp_name("changelog_for_version")
@mcp_title("Changelog for a version")
@mcp_hints("readOnly", "idempotent")
export func changelogForVersion(version: string) -> Json ! {Env, FS} =
  if version == "" then
    errorJson("missing_field", "version is required")
  else
    let suffix = "changelog/${version}.json" in
    readUnscopedOrError(suffix)
