// Inline Tests: Best Practices & Patterns
//
// This file demonstrates best practices for writing effective inline tests.
// It shows organizing tests, choosing good test cases, and avoiding pitfalls.

module examples/inline_tests_best_practices

// Best Practice 1: Organize tests by category with comments
//
// Group tests logically to make intent clear. Comments describe what each
// group of tests is verifying.
pure func compare(a: int, b: int) -> int
  tests [
    // Equal values should return 0
    ((5, 5), 0),
    ((0, 0), 0),
    (((-1), (-1)), 0),

    // First greater should return 1
    ((10, 3), 1),
    ((1, (-1)), 1),
    ((100, 0), 1),

    // Second greater should return -1
    ((3, 10), -1),
    ((-1, 1), -1),
    ((0, 100), -1)
  ]
{
  if a > b then 1 else if a < b then -1 else 0
}

// Best Practice 2: Include comprehensive edge cases
//
// Test edge cases: zero, boundaries, negative numbers, max/min values
pure func clamp(value: int, min_val: int, max_val: int) -> int
  tests [
    // Value within range: return as-is
    ((50, 0, 100), 50),
    ((5, 5, 5), 5),

    // Value below min: return min
    (((-10), 0, 100), 0),
    ((0, 5, 10), 5),

    // Value above max: return max
    ((150, 0, 100), 100),
    ((20, 5, 15), 15),

    // Edge case: equal min and max
    ((42, 42, 42), 42),

    // Negative ranges
    (((-50), (-100), (-10)), (-50)),
    (((-110), (-100), (-10)), (-100))
  ]
{
  if value < min_val then min_val
  else if value > max_val then max_val
  else value
}

// Best Practice 3: Test all branches of conditional logic
//
// If your function has multiple branches, ensure each branch is tested
pure func classify(n: int) -> string
  tests [
    // Positive numbers
    (1, "positive"),
    (42, "positive"),
    (1000, "positive"),

    // Negative numbers
    ((-1), "negative"),
    ((-42), "negative"),
    ((-1000), "negative"),

    // Zero (edge case between positive and negative)
    (0, "zero")
  ]
{
  if n > 0 then "positive"
  else if n < 0 then "negative"
  else "zero"
}

// Best Practice 4: Give tests descriptive comments when non-obvious
//
// Comments explain WHY the test case is important, not just WHAT it tests
pure func gcd(a: int, b: int) -> int
  tests [
    ((48, 18), 6),   // 48 = 6×8, 18 = 6×3, greatest common divisor = 6
    ((7, 7), 7),     // GCD of number with itself is that number
    ((0, 5), 5),     // Special case: gcd(0, n) = n
    ((100, 50), 50), // One number divides the other
    ((17, 19), 1)    // Coprime numbers have GCD = 1
  ]
{
  if b == 0 then a else gcd(b, a % b)
}

// Best Practice 5: Multiple tests for complex functions
//
// Functions with multiple parameters benefit from many test cases
pure func inRange(value: int, min_val: int, max_val: int) -> bool
  tests [
    // Typical cases
    ((50, 0, 100), true),
    ((150, 0, 100), false),

    // Boundary values
    ((0, 0, 100), true),      // At min
    ((100, 0, 100), true),    // At max
    (((-1), 0, 100), false),  // Just below min
    ((101, 0, 100), false),   // Just above max

    // Single-value range
    ((42, 42, 42), true),
    ((41, 42, 42), false),
    ((43, 42, 42), false),

    // Negative ranges
    (((-50), (-100), 0), true),
    (((-150), (-100), 0), false)
  ]
{
  value >= min_val && value <= max_val
}

// Best Practice 6: Avoid tests that are too slow
//
// ✓ GOOD: Quick, focused tests
// ✗ BAD: Expensive computations in test cases
pure func isEven(n: int) -> bool
  tests [
    (0, true),
    (1, false),
    (2, true),
    (100, true),
    (999, false)
  ]
{
  n % 2 == 0
}

// Best Practice 7: Test recursive functions thoroughly
//
// Include base cases and several recursive cases
pure func fibonacci(n: int) -> int
  tests [
    // Base cases
    (0, 0),
    (1, 1),

    // Recursive cases
    (2, 1),
    (3, 2),
    (4, 3),
    (5, 5),
    (6, 8),

    // Larger case
    (10, 55)
  ]
{
  if n <= 1 then n else fibonacci(n - 1) + fibonacci(n - 2)
}

// Best Practice 8: Handle special values explicitly
//
// Zero, empty collections, and sentinel values deserve special attention
pure func isEmpty(xs: [int]) -> bool
  tests [
    ([], true),         // Empty list
    ([1], false),       // Single element
    ([1, 2, 3], false), // Multiple elements
    ([0], false)        // Note: [0] is not empty, it contains zero
  ]
{
  match xs {
    [] => true,
    _ :: _ => false
  }
}

// Best Practice 9: Type-specific edge cases
//
// Different types have different edge cases to consider
pure func abs(x: int) -> int
  tests [
    (0, 0),           // Zero
    (42, 42),         // Positive
    ((-42), 42),      // Negative
    (1, 1),           // Smallest positive
    ((-1), 1),        // Smallest negative (in magnitude)
    (100, 100),       // Larger positive
    ((-100), 100)     // Larger negative
  ]
{
  if x < 0 then 0 - x else x
}

// Best Practice 10: Clear test names through strategic organization
//
// Even though inline tests don't have individual names,
// grouping related tests with comments makes intent clear
pure func sign(x: int) -> int
  tests [
    // Positive numbers return 1
    (1, 1),
    (42, 1),
    (1000, 1),

    // Negative numbers return -1
    ((-1), -1),
    ((-42), -1),
    ((-1000), -1),

    // Zero returns 0
    (0, 0)
  ]
{
  if x > 0 then 1 else if x < 0 then -1 else 0
}

// Learning Points - When to Use Inline Tests:
//
// ✓ DO use inline tests for:
//   - Pure functions with deterministic behavior
//   - Functions with clear, small domain of inputs
//   - Functions that should document expected behavior
//   - Simple unit-like tests next to implementation
//
// ✗ DON'T use inline tests for:
//   - Complex integration tests
//   - Property-based tests (use `property` instead)
//   - Functions requiring effects (IO, randomness)
//   - Tests that need sophisticated setup/teardown
//
// Tips for Effective Test Organization:
// 1. Group tests by category with comments
// 2. Test edge cases: zero, negatives, empty, boundaries
// 3. Test all branches of conditional logic
// 4. Include comments for non-obvious test purposes
// 5. Provide multiple tests for complex functions
// 6. Keep individual tests fast and focused
// 7. Use clear, readable formatting
// 8. Test domain-specific special values (None, empty, etc.)
