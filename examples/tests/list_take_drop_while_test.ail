module examples/tests/list_take_drop_while_test

import std/list (takeWhile, dropWhile)

test "takeWhile basic" {
  takeWhile(\x. x < 4, [1, 2, 3, 4, 2, 1]) == [1, 2, 3]
}

test "takeWhile empty" {
  takeWhile(\x. x < 4, []) == []
}

test "takeWhile all match" {
  takeWhile(\x. x > 0, [1, 2, 3]) == [1, 2, 3]
}

test "takeWhile none match" {
  takeWhile(\x. x < 0, [1, 2, 3]) == []
}

test "dropWhile basic" {
  dropWhile(\x. x < 4, [1, 2, 3, 4, 2, 1]) == [4, 2, 1]
}

test "dropWhile empty" {
  dropWhile(\x. x < 4, []) == []
}

test "dropWhile all match" {
  dropWhile(\x. x > 0, [1, 2, 3]) == []
}

test "dropWhile none match" {
  dropWhile(\x. x < 0, [1, 2, 3]) == [1, 2, 3]
}
