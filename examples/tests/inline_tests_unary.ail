-- Inline Tests: Single-Argument Functions
-- These examples demonstrate the syntax for testing functions with one argument
-- Format: (input_value, expected_value)

module examples/tests/inline_tests_unary

-- Unary integer operations
pure func double(x: int) -> int
  tests [
    (5, 10),
    (0, 0),
    (-3, -6),
    (100, 200)
  ]
{
  x * 2
}

pure func triple(x: int) -> int
  tests [
    (3, 9),
    (0, 0),
    (-2, -6),
    (10, 30)
  ]
{
  x * 3
}

pure func negate(x: int) -> int
  tests [
    (5, -5),
    (-5, 5),
    (0, 0),
    (100, -100)
  ]
{
  0 - x
}

pure func absolute(x: int) -> int
  tests [
    (5, 5),
    (-5, 5),
    (0, 0),
    (-100, 100)
  ]
{
  if x < 0 then 0 - x else x
}

-- Unary float operations
pure func doubleFloat(x: float) -> float
  tests [
    (5.0, 10.0),
    (0.0, 0.0),
    (-3.5, -7.0),
    (2.5, 5.0)
  ]
{
  x * 2.0
}

pure func absoluteFloat(x: float) -> float
  tests [
    (5.5, 5.5),
    (-5.5, 5.5),
    (0.0, 0.0),
    (-3.14, 3.14)
  ]
{
  if x < 0.0 then 0.0 - x else x
}

-- Unary boolean operations
pure func negate_bool(b: bool) -> bool
  tests [
    (true, false),
    (false, true)
  ]
{
  if b then false else true
}

-- Unary predicates (functions returning bool)
pure func isEven(x: int) -> bool
  tests [
    (4, true),
    (3, false),
    (0, true),
    (-2, true),
    (-3, false)
  ]
{
  x % 2 == 0
}

pure func isOdd(x: int) -> bool
  tests [
    (4, false),
    (3, true),
    (0, false),
    (-2, false),
    (-3, true)
  ]
{
  x % 2 != 0
}

pure func isPositive(x: int) -> bool
  tests [
    (5, true),
    (-5, false),
    (0, false)
  ]
{
  x > 0
}

pure func isNegative(x: int) -> bool
  tests [
    (5, false),
    (-5, true),
    (0, false)
  ]
{
  x < 0
}

pure func isZero(x: int) -> bool
  tests [
    (0, true),
    (5, false),
    (-5, false)
  ]
{
  x == 0
}

-- Identity for strings
pure func identityString(s: string) -> string
  tests [
    ("hello", "hello"),
    ("AILANG", "AILANG"),
    ("", "")
  ]
{
  s
}
