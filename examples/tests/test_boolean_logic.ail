module examples/tests/test_boolean_logic

// Test logical AND
pure func andLogic(a: bool, b: bool) -> bool
  tests [
    ((true, true), true),
    ((true, false), false),
    ((false, true), false),
    ((false, false), false)
  ]
{
  a && b
}

// Test logical OR
pure func orLogic(a: bool, b: bool) -> bool
  tests [
    ((true, true), true),
    ((true, false), true),
    ((false, true), true),
    ((false, false), false)
  ]
{
  a || b
}

// Test logical NOT
pure func notLogic(a: bool) -> bool
  tests [
    (true, false),
    (false, true)
  ]
{
  if a then false else true
}

// Test DeMorgan's Law: not(a && b) == (not a) || (not b)
pure func demorgan1(a: bool, b: bool) -> bool
  tests [
    ((true, true), false),
    ((true, false), true),
    ((false, true), true),
    ((false, false), true)
  ]
{
  if (a && b) then false else true
}

// Test compound AND conditions
pure func compoundAnd(a: bool, b: bool, c: bool) -> bool
  tests [
    ((true, true, true), true),
    ((true, true, false), false),
    ((true, false, true), false),
    ((false, false, false), false)
  ]
{
  a && b && c
}

// Test compound OR conditions
pure func compoundOr(a: bool, b: bool, c: bool) -> bool
  tests [
    ((true, true, true), true),
    ((true, true, false), true),
    ((true, false, false), true),
    ((false, false, false), false)
  ]
{
  a || b || c
}

// Test short-circuit AND (if first is false, second shouldn't matter)
pure func shortCircuitAnd(x: int, y: int) -> bool
  tests [
    ((0, 10), false),
    ((5, 10), true),
    ((5, 0), false),
    ((0, 0), false)
  ]
{
  (x > 0) && (y > 0)
}

// Test short-circuit OR (if first is true, second shouldn't matter)
pure func shortCircuitOr(x: int, y: int) -> bool
  tests [
    ((0, 10), true),
    ((5, 0), true),
    ((5, 10), true),
    ((0, 0), false)
  ]
{
  (x > 0) || (y > 0)
}

// Test conditional with boolean result
pure func boolIf(x: int) -> bool
  tests [
    (5, true),
    (0, false),
    (-3, false),
    (100, true)
  ]
{
  if x > 0 then true else false
}

// Test nested conditionals with boolean logic
pure func complexLogic(x: int, y: int) -> bool
  tests [
    ((5, 10), true),
    ((5, 2), false),
    ((2, 10), false),
    ((2, 2), true)
  ]
{
  if x > 0 && y > 0 then
    if x < y then true else y == x
  else
    false
}
