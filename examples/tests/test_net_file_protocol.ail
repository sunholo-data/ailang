-- Test Net security: file:// should be blocked
-- Run with: ailang run --caps Net,IO --entry main examples/test_net_file_protocol.ail
module examples/tests/test_net_file_protocol

import std/net (httpRequest)
import std/io (println)

export func main() -> () ! {Net, IO} =
  let _ = println("Trying to fetch file:///etc/passwd...") in
  match httpRequest("GET", "file:///etc/passwd", [], "") {
    Ok(resp) => println("ERROR: Should have been blocked!"),
    Err(err) => println("✓ Correctly blocked file:// protocol")
  }
