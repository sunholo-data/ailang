module examples/test_simple

// Simple addition - no recursion
pure func add(x: int, y: int) -> int
  tests [
    ((1, 2), 3),
    ((5, 7), 12),
    ((0, 0), 0),
    ((-1, 1), 0)
  ]
{
  x + y
}

// Simple max function
pure func max(a: int, b: int) -> int
  tests [
    ((5, 3), 5),
    ((3, 5), 5),
    ((7, 7), 7),
    ((-1, -5), -1)
  ]
{
  if a > b then a else b
}

// Boolean negation
pure func negate(b: bool) -> bool
  tests [
    (true, false),
    (false, true)
  ]
{
  if b then false else true
}
