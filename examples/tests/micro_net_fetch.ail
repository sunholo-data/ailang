-- Test Net effect: Fetch from HTTPS URL
-- Run with: ailang run --caps Net,IO --entry main examples/tests/micro_net_fetch.ail
module examples/tests/micro_net_fetch

import std/net (httpGet)

export func main() -> () ! {IO, Net} {
  _io_println("Fetching https://example.com...");
  let html = httpGet("https://example.com");
  _io_println("Success! Fetched " ++ show(_str_len(html)) ++ " bytes")
}
