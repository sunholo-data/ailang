-- Test Net effect security features
-- This should FAIL with E_NET_IP_BLOCKED (localhost)
module examples/tests/test_net_security

import std/net (httpRequest)
import std/io (println)

export func main() -> () ! {Net, IO} =
  let _ = println("Testing localhost IP blocking...") in
  match httpRequest("GET", "https://127.0.0.1:8443/test", [], "") {
    Ok(resp) => println("ERROR: Should have been blocked!"),
    Err(err) => println("✓ Correctly blocked 127.0.0.1")
  }
