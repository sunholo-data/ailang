-- Inline Tests: Recursive Functions
-- These examples demonstrate testing recursive functions with base cases and inductive cases

module examples/tests/inline_tests_recursive

-- Factorial function (classic recursive example)
pure func factorial(n: int) -> int
  tests [
    (0, 1),         -- Base case: 0! = 1
    (1, 1),         -- Base case: 1! = 1
    (5, 120),       -- 5! = 5*4*3*2*1 = 120
    (6, 720),       -- 6! = 6*5*4*3*2*1 = 720
    (10, 3628800)   -- 10! = 3,628,800
  ]
{
  if n <= 1 then 1 else n * factorial(n - 1)
}

-- Fibonacci sequence
pure func fibonacci(n: int) -> int
  tests [
    (0, 0),     -- Base case: fib(0) = 0
    (1, 1),     -- Base case: fib(1) = 1
    (2, 1),     -- fib(2) = fib(1) + fib(0) = 1
    (3, 2),     -- fib(3) = fib(2) + fib(1) = 2
    (5, 5),     -- fib(5) = 5
    (6, 8),     -- fib(6) = 8
    (10, 55)    -- fib(10) = 55
  ]
{
  if n <= 1 then n else fibonacci(n - 1) + fibonacci(n - 2)
}

-- Sum of integers from 1 to n
pure func sumUpTo(n: int) -> int
  tests [
    (0, 0),      -- sum(0) = 0
    (1, 1),      -- sum(1) = 1
    (5, 15),     -- sum(5) = 1+2+3+4+5 = 15
    (10, 55),    -- sum(10) = 1+2+...+10 = 55
    (100, 5050)  -- sum(100) = 5050
  ]
{
  if n <= 0 then 0 else n + sumUpTo(n - 1)
}

-- Countdown from n to 0
pure func countDown(n: int) -> int
  tests [
    (0, 0),
    (1, 0),
    (5, 0),
    (10, 0)
  ]
{
  if n <= 0 then 0 else countDown(n - 1)
}

-- Power function (base^exponent)
pure func power(base: int, exp: int) -> int
  tests [
    ((2, 0), 1),      -- x^0 = 1
    ((2, 1), 2),      -- x^1 = x
    ((2, 3), 8),      -- 2^3 = 8
    ((3, 2), 9),      -- 3^2 = 9
    ((3, 3), 27),     -- 3^3 = 27
    ((5, 0), 1),      -- 5^0 = 1
    ((10, 2), 100)    -- 10^2 = 100
  ]
{
  if exp == 0 then 1
  else if exp == 1 then base
  else base * power(base, exp - 1)
}

-- Greatest Common Divisor (GCD)
pure func gcd(a: int, b: int) -> int
  tests [
    ((48, 18), 6),
    ((0, 5), 5),
    ((5, 0), 5),
    ((7, 7), 7),
    ((13, 5), 1),
    ((100, 50), 50),
    ((54, 24), 6)
  ]
{
  if b == 0 then a else gcd(b, a % b)
}

-- Length of a list (recursive)
pure func listLength(xs: [int]) -> int
  tests [
    ([], 0),
    ([1], 1),
    ([1, 2], 2),
    ([1, 2, 3], 3),
    ([1, 2, 3, 4, 5], 5)
  ]
{
  match xs {
    [] => 0,
    _ :: rest => 1 + listLength(rest)
  }
}

-- Sum of all elements in a list
pure func listSum(xs: [int]) -> int
  tests [
    ([], 0),
    ([5], 5),
    ([1, 2, 3], 6),
    ([1, 2, 3, 4], 10),
    ([10, 20, 30], 60)
  ]
{
  match xs {
    [] => 0,
    x :: rest => x + listSum(rest)
  }
}

-- Double factorial
pure func doubleFactorial(n: int) -> int
  tests [
    (0, 1),
    (1, 1),
    (4, 8),      -- 4*2 = 8
    (5, 15)      -- 5*3*1 = 15
  ]
{
  if n <= 0 then 1
  else if n == 1 then 1
  else n * doubleFactorial(n - 2)
}

-- Check if n is a power of 2
pure func isPowerOfTwo(n: int) -> bool
  tests [
    (1, true),      -- 2^0 = 1
    (2, true),      -- 2^1 = 2
    (4, true),      -- 2^2 = 4
    (8, true),      -- 2^3 = 8
    (3, false),
    (5, false),
    (7, false),
    (16, true)      -- 2^4 = 16
  ]
{
  if n <= 0 then false
  else if n == 1 then true
  else if n % 2 == 0 then isPowerOfTwo(n / 2)
  else false
}
