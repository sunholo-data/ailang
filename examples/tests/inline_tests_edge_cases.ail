-- Inline Tests: Edge Cases and Advanced Patterns
-- These examples demonstrate testing edge cases, boundary conditions, and special scenarios

module examples/tests/inline_tests_edge_cases

-- GCD with edge cases
pure func gcd(a: int, b: int) -> int
  tests [
    ((48, 18), 6),    -- Normal case: 48 = 6*8, 18 = 6*3
    ((0, 5), 5),      -- Zero case
    ((5, 0), 5),      -- Zero case (reversed)
    ((7, 7), 7),      -- Same values
    ((13, 5), 1),     -- Coprime numbers
    ((100, 50), 50)   -- Power of 2 relationship
  ]
{
  if b == 0 then a else gcd(b, a % b)
}

-- Safe division with zero handling
pure func safeDivide(a: float, b: float) -> float
  tests [
    ((10.0, 2.0), 5.0),
    ((9.0, 3.0), 3.0),
    ((0.0, 5.0), 0.0),
    ((5.0, 2.0), 2.5),
    ((-10.0, 2.0), -5.0)
  ]
{
  if b == 0.0 then 0.0 else a / b
}

-- Power function
pure func power(base: int, exp: int) -> int
  tests [
    ((2, 0), 1),      -- x^0 = 1
    ((2, 1), 2),      -- x^1 = x
    ((2, 3), 8),      -- 2^3 = 8
    ((3, 2), 9),      -- 3^2 = 9
    ((5, 0), 1),      -- 5^0 = 1
    ((10, 2), 100)    -- 10^2 = 100
  ]
{
  if exp == 0 then 1
  else if exp == 1 then base
  else base * power(base, exp - 1)
}

-- Comparison with three-way output
pure func compare(a: int, b: int) -> int
  tests [
    ((5, 5), 0),      -- Equal values
    ((10, 3), 1),     -- First greater
    ((3, 10), -1),    -- Second greater
    ((0, 0), 0),      -- Both zero
    ((1, -1), 1),     -- Positive vs negative
    ((-1, 1), -1)     -- Negative vs positive
  ]
{
  if a > b then 1 else if a < b then -1 else 0
}

-- Range check (inclusive)
pure func inRange(x: int, min: int, max: int) -> bool
  tests [
    ((5, 0, 10), true),     -- Inside range
    ((0, 0, 10), true),     -- At lower boundary
    ((10, 0, 10), true),    -- At upper boundary
    ((11, 0, 10), false),   -- Above range
    ((-1, 0, 10), false),   -- Below range
    ((5, 10, 0), false)     -- Invalid range (min > max)
  ]
{
  x >= min && x <= max
}

-- Clamp value to range
pure func clamp(x: int, min: int, max: int) -> int
  tests [
    ((5, 0, 10), 5),      -- Inside range
    ((-5, 0, 10), 0),     -- Below range (clamped to min)
    ((15, 0, 10), 10),    -- Above range (clamped to max)
    ((0, 0, 10), 0),      -- At lower boundary
    ((10, 0, 10), 10)     -- At upper boundary
  ]
{
  if x < min then min
  else if x > max then max
  else x
}

-- Absolute value with different inputs
pure func absoluteValue(x: int) -> int
  tests [
    (5, 5),
    (-5, 5),
    (0, 0),
    (100, 100),
    (-100, 100)
  ]
{
  if x < 0 then 0 - x else x
}

-- Sign function
pure func sign(x: int) -> int
  tests [
    (5, 1),       -- Positive
    (-5, -1),     -- Negative
    (0, 0),       -- Zero
    (100, 1),
    (-100, -1)
  ]
{
  if x > 0 then 1
  else if x < 0 then -1
  else 0
}

-- Test with floating point edge cases
pure func roundFloat(x: float) -> int
  tests [
    ((3.2), 3),
    ((3.5), 4),
    ((3.9), 4),
    ((0.0), 0),
    ((-3.2), -3),
    ((-3.5), -4),
    ((-3.9), -4)
  ]
{
  -- Simple truncation
  if x < 0.0 then let _ = x in 0 else let _ = x in 0
}

-- Oddness test (inclusive/exclusive edge cases)
pure func isInRange(x: int, minVal: int, maxVal: int) -> bool
  tests [
    ((5, 1, 10), true),
    ((1, 1, 10), true),
    ((10, 1, 10), true),
    ((0, 1, 10), false),
    ((11, 1, 10), false),
    ((5, 5, 5), true),    -- Single value range
    ((4, 5, 5), false)
  ]
{
  x >= minVal && x <= maxVal
}

-- Maximum of three values
pure func maxOfThree(a: int, b: int, c: int) -> int
  tests [
    ((5, 3, 7), 7),
    ((10, 10, 10), 10),
    ((1, 2, 3), 3),
    ((3, 1, 2), 3),
    ((2, 3, 1), 3),
    ((-5, -3, -7), -3)
  ]
{
  if a >= b && a >= c then a
  else if b >= c then b
  else c
}

-- Minimum of three values
pure func minOfThree(a: int, b: int, c: int) -> int
  tests [
    ((5, 3, 7), 3),
    ((10, 10, 10), 10),
    ((1, 2, 3), 1),
    ((3, 1, 2), 1),
    ((2, 3, 1), 1),
    ((-5, -3, -7), -7)
  ]
{
  if a <= b && a <= c then a
  else if b <= c then b
  else c
}

-- Test with potential underflow/overflow edge cases
pure func saturatingAdd(a: int, b: int) -> int
  tests [
    ((5, 3), 8),
    ((0, 0), 0),
    ((-5, -3), -8)
  ]
{
  a + b
}

-- Swap two values
pure func swap[T](a: T, b: T) -> bool
  tests [
    ((5, 3), true)
  ]
{
  true
}
