module examples/test_conditionals

// Tests for conditional logic and boolean operations

// Logical AND
pure func logicalAnd(a: bool, b: bool) -> bool
  tests [
    ((true, true), true),
    ((true, false), false),
    ((false, true), false),
    ((false, false), false)
  ]
{
  if a then b else false
}

// Logical OR
pure func logicalOr(a: bool, b: bool) -> bool
  tests [
    ((true, true), true),
    ((true, false), true),
    ((false, true), true),
    ((false, false), false)
  ]
{
  if a then true else b
}

// Logical NOT
pure func logicalNot(a: bool) -> bool
  tests [
    (true, false),
    (false, true)
  ]
{
  if a then false else true
}

// Logical XOR (self-contained - no cross-function deps)
pure func logicalXor(a: bool, b: bool) -> bool
  tests [
    ((true, true), false),
    ((true, false), true),
    ((false, true), true),
    ((false, false), false)
  ]
{
  if a then (if b then false else true) else b
}

// Logical NAND (self-contained)
pure func logicalNand(a: bool, b: bool) -> bool
  tests [
    ((true, true), false),
    ((true, false), true),
    ((false, true), true),
    ((false, false), true)
  ]
{
  // NAND = NOT(AND) = NOT(if a then b else false)
  if a then (if b then false else true) else true
}

// Logical NOR (self-contained)
pure func logicalNor(a: bool, b: bool) -> bool
  tests [
    ((true, true), false),
    ((true, false), false),
    ((false, true), false),
    ((false, false), true)
  ]
{
  // NOR = NOT(OR) = NOT(if a then true else b)
  if a then false else (if b then false else true)
}

// Boolean equality (self-contained)
pure func boolEq(a: bool, b: bool) -> bool
  tests [
    ((true, true), true),
    ((true, false), false),
    ((false, true), false),
    ((false, false), true)
  ]
{
  if a then b else (if b then false else true)
}

// Implication: a implies b
pure func implies(a: bool, b: bool) -> bool
  tests [
    ((true, true), true),
    ((true, false), false),
    ((false, true), true),
    ((false, false), true)
  ]
{
  if a then b else true
}

// Boolean to int conversion (true = 1, false = 0)
pure func boolToInt(b: bool) -> int
  tests [
    (true, 1),
    (false, 0)
  ]
{
  if b then 1 else 0
}

// Int to bool conversion (0 = false, anything else = true)
pure func intToBool(n: int) -> bool
  tests [
    (0, false),
    (1, true),
    (-1, true),
    (100, true)
  ]
{
  n != 0
}

// Ternary-like function: if cond then x else y for ints
pure func ifElse(cond: bool, x: int, y: int) -> int
  tests [
    ((true, 10, 20), 10),
    ((false, 10, 20), 20),
    ((true, 0, 100), 0),
    ((false, 0, 100), 100)
  ]
{
  if cond then x else y
}

// Three-way comparison: returns -1, 0, or 1
pure func compare(a: int, b: int) -> int
  tests [
    ((5, 3), 1),
    ((3, 5), -1),
    ((5, 5), 0),
    ((-1, -5), 1),
    ((-5, -1), -1)
  ]
{
  if a > b then 1
  else if a < b then -1
  else 0
}

// Check if within range (inclusive)
pure func inRange(x: int, lo: int, hi: int) -> bool
  tests [
    ((5, 0, 10), true),
    ((0, 0, 10), true),
    ((10, 0, 10), true),
    ((-1, 0, 10), false),
    ((11, 0, 10), false)
  ]
{
  if x < lo then false
  else if x > hi then false
  else true
}

// Check if strictly between (exclusive)
pure func between(x: int, lo: int, hi: int) -> bool
  tests [
    ((5, 0, 10), true),
    ((0, 0, 10), false),
    ((10, 0, 10), false),
    ((1, 0, 10), true),
    ((9, 0, 10), true)
  ]
{
  if x <= lo then false
  else if x >= hi then false
  else true
}
