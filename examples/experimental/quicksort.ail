-- quicksort.ail: Functional sorting demonstration
-- Status: ✅ Working (v0.6.3)
--
-- This example shows two approaches to sorting in AILANG:
-- 1. Custom quicksort using filter and pattern matching
-- 2. Using std/list sortBy (merge sort)
--
-- Note: Property-based testing (test/property blocks) planned for future release.

module examples/experimental/quicksort

import std/io (println)
import std/list (filter, sortBy, length)

-- Custom quicksort using filter
pure func quicksort(list: [int]) -> [int] =
  match list {
    [] => [],
    [x] => [x],
    [pivot, ...rest] => {
      let less = filter(\x. x < pivot, rest);
      let greater = filter(\x. x >= pivot, rest);
      quicksort(less) ++ [pivot] ++ quicksort(greater)
    }
  }

-- Count occurrences (for verification)
pure func count(x: int, list: [int]) -> int =
  match list {
    [] => 0,
    [h, ...t] => if h == x then 1 + count(x, t) else count(x, t)
  }

-- Comparator for sortBy
func cmpInt(a: int, b: int) -> int = a - b

export func main() -> () ! {IO} {
  let input = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5];

  println("Input: " ++ show(input));
  println("");

  -- Custom quicksort
  let qs = quicksort(input);
  println("Custom quicksort: " ++ show(qs));

  -- Using std/list sortBy (merge sort)
  let ms = sortBy(cmpInt, input);
  println("std/list sortBy:  " ++ show(ms));

  -- Verify same length
  println("");
  println("Quicksort length: " ++ show(length(qs)));
  println("sortBy length:    " ++ show(length(ms)));

  -- Count preservation check
  println("Count of 5 in original: " ++ show(count(5, input)));
  println("Count of 5 in sorted:   " ++ show(count(5, qs)))
}
