--
-- quicksort.ail: Functional sorting demonstration
--
-- This example shows how AILANG's Hindley-Milner type inference handles
-- polymorphic functions WITHOUT explicit type parameters. The quicksort
-- function works on ANY orderable type - the Ord constraint is inferred
-- automatically from the use of < and >= operators.
--
-- Type inferred: ∀a. [Ord a] => [a] -> [a]
-- (For all types a that implement Ord, takes a list of a and returns a list of a)

module examples/experimental/quicksort

-- Generic quicksort for any orderable type
-- Note: No [a: Ord] syntax needed - type inference handles it!
-- The Ord constraint is inferred from the < and >= operators below
pure func quicksort(list: [a]) -> [a] {
  match list {
    [] => [],
    [x] => [x],
    [pivot, ...rest] => {
      -- Ord constraint inferred from < operator
      let less = filter(\x. x < pivot, rest);
      -- Ord constraint inferred from >= operator
      let greater = filter(\x. x >= pivot, rest);
      quicksort(less) ++ [pivot] ++ quicksort(greater)
    }
  }
}

-- Helper function to count occurrences
-- Eq constraint inferred from == operator
pure func count(x: a, list: [a]) -> int {
  match list {
    [] => 0,
    [h, ...t] => if h == x then 1 + count(x, t) else count(x, t)
  }
}

