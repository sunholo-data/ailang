module examples/snippets/list_patterns
import std/io (println)
import std/list (length, head, tail)
import std/option (Some, None)

export func main() -> () ! {IO} =
  let xs = [10, 20, 30] in
  let _ = println("LEN=" ++ show(length(xs))) in
  let _ = match head(xs) {
    Some(h) => println("HEAD=" ++ show(h)),
    None => println("HEAD=None")
  } in
  let _ = println("TLEN=" ++ show(length(tail(xs)))) in
  ()
