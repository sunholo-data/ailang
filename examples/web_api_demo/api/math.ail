module api/math

-- Pure math functions exposed as REST endpoints
-- POST /api/api/math/add       Body: {"args": [3, 4]}       -> 7
-- POST /api/api/math/multiply  Body: {"args": [5, 6]}       -> 30
-- POST /api/api/math/factorial Body: {"args": [5]}           -> 120
-- POST /api/api/math/fibonacci Body: {"args": [10]}          -> 55

export pure func add(x: int, y: int) -> int =
  x + y

export pure func multiply(x: int, y: int) -> int =
  x * y

export pure func factorial(n: int) -> int =
  if n <= 1 then 1
  else n * factorial(n - 1)

export pure func fibonacci(n: int) -> int =
  if n <= 0 then 0
  else if n == 1 then 1
  else fibonacci(n - 1) + fibonacci(n - 2)
