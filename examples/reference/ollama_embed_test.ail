-- AILANG Ollama Embedding Test
-- Tests the _ollama_embed builtin with EmbeddingGemma

module examples/reference/ollama_embed_test
import std/embedding (ollamaEmbed)
import std/string (intToStr)

export func main() -> string ! {AI, IO} {
  let _ = _io_println("=== Ollama Embedding Test ===") in
  -- Test embedding a simple text
  let text = "The sky is blue during the day" in
  let _ = _io_println("Text: ${text}") in
  let embedding = ollamaEmbed("embeddinggemma", text) in
  let _ = _io_println("Got embedding (list of floats)") in
  "Done!"
}
