-- Test combined aliasing: module alias + selective symbol imports
-- import std/list as List (map, filter) provides both:
--   - Qualified access: List.length, List.head
--   - Direct access: map, filter

module examples/imports/combined_alias

import std/list as List

-- Qualified access via module alias
export pure func getLength(xs: [int]) -> int {
  List.length(xs)
}

-- Test entry point
export func main() -> () ! {IO} {
  let nums = [1, 2, 3, 4, 5];
  let len = List.length(nums);
  _io_print("List.length via module alias: " ++ show(len))
}
