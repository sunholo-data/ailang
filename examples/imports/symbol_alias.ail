-- Test symbol aliasing feature
-- import std/list (length as listLength) renames on import

module examples/imports/symbol_alias

import std/list (length as listLength, head as listHead)

-- Use aliased symbol names directly
export pure func getLen(xs: [int]) -> int {
  listLength(xs)
}

-- Test entry point
export func main() -> () ! {IO} {
  let nums = [1, 2, 3, 4, 5];
  let len = listLength(nums);
  _io_print("Length via alias: " ++ show(len))
}
