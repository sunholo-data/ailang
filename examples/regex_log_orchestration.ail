-- regex_log_orchestration.ail — the orchestration use case for std/regex.
--
-- A recurring AI-orchestration task: parse semi-structured text emitted by a
-- tool or model (log lines, LLM output), validate each line against a pattern,
-- extract fields, and ROUTE on them. This is exactly what regex is for, and RE2
-- makes it safe to run on untrusted input (linear-time, no ReDoS footgun).
--
-- Here we parse "[LEVEL] message" log lines, extract the level + body, and route
-- ERROR lines to an alert. compile() is called ONCE; the validated Regex drives
-- every line.
--
-- Run: ailang run --caps IO examples/regex_log_orchestration.ail

module examples/regex_log_orchestration

import std/io (println)
import std/regex as R
import std/string (split)
import std/list (nth_or, forEachE)
import std/result (Ok, Err)
import std/option (Some, None)

export func noGroup() -> {start: int, end: int, text: string} = {
  {start: -1, end: -1, text: ""}
}

export func main() -> () ! {IO} = {
  let logs = "[INFO] service started\n[ERROR] disk full\ngarbage line\n[WARN] low memory";
  match R.compile("^\\[([A-Z]+)\\]\\s+(.*)$") {
    Err(e) => println("bad pattern: ${e}"),
    Ok(re) => {
      println("routing log lines:");
      -- Parse "[LEVEL] body", alert on ERROR, drop unparseable lines.
      forEachE(\line. match R.findFirst(re, line) {
        None => println("  (skipped unstructured line: '${line}')"),
        Some(m) => {
          let level = nth_or(m.groups, 1, noGroup()).text;
          let body = nth_or(m.groups, 2, noGroup()).text;
          if level == "ERROR"
            then println("  ALERT [${level}]: ${body}")
            else println("  ok    [${level}]: ${body}")
        }
      }, split(logs, "\n"))
    }
  }
}
