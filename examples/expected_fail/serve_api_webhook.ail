-- serve_api_webhook.ail
-- Demonstrates @raw @route for receiving raw HTTP requests with headers.
-- Use case: webhook handlers that need access to signature headers.
--
-- Run: ailang serve-api examples/runnable/serve_api_webhook.ail
-- Test: curl -X POST http://localhost:8080/webhooks/example \
--         -H "X-Signature: abc123" \
--         -d '{"event": "test"}'

module webhook_example

import std/json (Json, get, getString, getOrElse, asString)

-- A @raw @route handler receives a record with:
--   body: string, headers: Json, method: string, path: string, query: Json
-- Headers and query are JObject — use std/json.get() for key lookup.
-- This handles hyphenated keys like "Stripe-Signature" that dot notation can't.
@raw
@route("POST", "/webhooks/example")
export func handleWebhook(request: {body: string, headers: Json, method: string, path: string}) -> string ! {IO} {
  let sig = match getString(request.headers, "X-Signature") {
    Some(s) => s,
    None => "no-signature"
  }
  "received webhook with signature: " ++ sig ++ " body length: " ++ toString(length(request.body))
}

-- Non-@raw routes continue to work with parsed arguments as before
@route("GET", "/health")
export pure func health() -> string {
  "ok"
}
