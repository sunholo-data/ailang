-- examples/modal_rand.ail
-- Demonstrates parameterised effect syntax (!{E[k=v, ...]}) introduced in
-- M-EFFECT-REFINEMENT Phase 1 (v0.15.0), and the mode-aware RUNTIME dispatch
-- added in M-EFFECT-REPLAY-CONTRACTS (v1.0.0, Rand pilot).
--
-- Rand is the pilot effect: bare !{Rand} desugars to !{Rand[mode=os]} via
-- the per-effect default-mode table. Authors can opt into explicit modes:
--
--   !{Rand}                       -- default (mode=os, OS entropy)
--   !{Rand[mode=os]}              -- explicit form of the default
--   !{Rand[mode=seeded]}          -- deterministic for replay/testing
--   !{Rand[mode=crypto]}          -- cryptographic strength (crypto/rand)
--
-- RUNTIME BEHAVIOUR (v1.0.0, M-EFFECT-REPLAY-CONTRACTS): the three Rand modes
-- now dispatch to three DIFFERENT sources at runtime — os draws from the global
-- OS-entropy source (reseedable via rand_seed), seeded draws from a dedicated
-- deterministic source pinned by the AILANG_SEED environment variable, and
-- crypto draws from crypto/rand. Trace events for moded Rand ops carry the
-- resolved mode and its replay-contract label (deterministic/re-sampleable/
-- opaque). See ailang trace + docs/docs/guides/parameterised-effects.md.
--
-- SEEDING CONTRACT (Mark's decision, 2026-07-24): the seeded-mode source is
-- seeded ONLY by AILANG_SEED (the dedicated explicit path), NEVER by rand_seed.
-- rand_seed keeps its existing contract: it reseeds the os/global source. A
-- seeded-mode draw with no AILANG_SEED is a loud typed error (RAND_SEEDED_NO_SEED),
-- never a silent random fallback.
--
-- Run with:
--   ailang run --caps Rand,IO --entry main examples/modal_rand.ail
--   AILANG_SEED=42 ailang run --caps Rand,IO --entry main_seeded examples/modal_rand.ail
--   ailang run --caps Rand,IO --entry main_crypto examples/modal_rand.ail
--
-- main stays os-mode so example verification can run without AILANG_SEED.
-- Seeded and crypto are separate entrypoints because their modes are
-- incomparable: no single function may declare a mode that covers both.
--
-- See:
--   design_docs/implemented/v0_15_x/m-effect-refinement-phase1.md
--   design_docs/planned/v1_0_0/m-effect-refinement.md (parent, Example 1)
--   design_docs/implemented/v0_30_0/m-effect-replay-contracts.md (Phase 3 dispatch)

module examples/modal_rand

import std/rand (rand_int)

import std/io (println)

-- Bare !{Rand} — desugars to !{Rand[mode=os]} via the default-mode table.
-- Existing programs that wrote !{Rand} continue to type-check unchanged and
-- draw from the global OS-entropy source at runtime.
export func roll_d6() -> int ! {Rand} = rand_int(1, 6)

-- Explicit !{Rand[mode=os]} — same effect signature as bare !{Rand}.
-- Unifies with bare form via the default-desugar match in the unifier; draws
-- from the same global os source.
export func roll_d20() -> int ! {Rand[mode=os]} = rand_int(1, 20)

-- Explicit seeded mode — deterministic across processes for the same
-- AILANG_SEED. The declared mode covers std/rand's bare/os requirement only
-- along the validation path; runtime dispatch remains seeded.
export func seeded_roll() -> int ! {Rand[mode=seeded]} = rand_int(1, 1000000)

-- Explicit crypto mode — draws from crypto/rand and has an opaque replay
-- contract. It does not read AILANG_SEED.
export func crypto_roll() -> int ! {Rand[mode=crypto]} = rand_int(1, 1000000)

-- main demonstrates only os-mode forms end-to-end.
export func main() -> () ! {Rand, IO} = {
  let r1 = roll_d6(()) in println(concat_String("roll_d6 (bare Rand → mode=os): ", show(show(r1))))
  let r2 = roll_d20(()) in println(concat_String("roll_d20 (Rand[mode=os]): ", show(show(r2))))
}

export func main_seeded() -> () ! {Rand[mode=seeded], IO} = {
  let r1 = seeded_roll(()) in println(concat_String("seeded roll 1: ", show(show(r1))))
  let r2 = seeded_roll(()) in println(concat_String("seeded roll 2: ", show(show(r2))))
  let r3 = seeded_roll(()) in println(concat_String("seeded roll 3: ", show(show(r3))))
}

export func main_crypto() -> () ! {Rand[mode=crypto], IO} = {
  let r = crypto_roll(()) in println(concat_String("crypto roll: ", show(show(r))))
}
