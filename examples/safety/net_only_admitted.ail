-- Demo for M-AGENT-SAFE-RUNNER (planned v0.16.0).
--
-- Counter-example: a program whose declared effects are a subset of the
-- policy. `ailang policy-check` admits it. The runner can then invoke it
-- under the policy's caps, sandbox, and budgets.

module examples/safety/net_only_admitted

import std/net (httpGet)

export func main() -> string ! {Net} = httpGet("https://api.example.com/ok")
