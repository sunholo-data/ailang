module examples/string_char_access

-- Total character access on strings.
--
-- charAt is PARTIAL: out of range — including index 0 of the empty string — it
-- aborts the program. Its type, (string, int) -> string, gives no hint of that.
-- Because an abort exits non-zero, a test suite that asserts "bad input is
-- rejected" by checking for a non-zero exit stays GREEN while the program
-- crashes on every input.
--
-- charAtOpt and charAt_or are total. Prefer them whenever the index comes from
-- data rather than from a literal you have already bounds-checked.
import std/string (charAt, charAtOpt, charAt_or, length)
import std/option (Option, Some, None)
import std/list (map)
import std/io (println)

-- SAFE: the index is guarded by the caller, so charAt cannot go out of range.
pure func firstCharGuarded(s: string) -> string = if length(s) > 0 then charAt(s, 0) else ""

-- TOTAL: no guard needed, and the absent case is visible in the type.
pure func describeFirst(s: string) -> string = match charAtOpt(s, 0) {
  Some(c) => "starts with ${c}",
  None => "empty"
}

-- The case that bit a real caller: a field that is sometimes absent arrives as
-- "", and the accessor runs inside a map over every record.
pure func initials(fields: [string]) -> [string] = map(\f. charAt_or(f, 0, "?"), fields)

-- Rune-indexed, not byte-indexed: a multi-byte character is one index.
pure func runeIndexed() -> string = charAt_or("🎉ab", 0, "?")

export func main() -> () ! {IO} {
  println(firstCharGuarded("hello"))
  println(firstCharGuarded(""))
  println(describeFirst("hello"))
  println(describeFirst(""))
  println(show(initials(["alice", "", "carol"])))
  println(runeIndexed())
}
