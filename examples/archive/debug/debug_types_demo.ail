-- Debug Types Demo
-- Run with: ailang run --debug-types --caps IO examples/debug_types_demo.ail
--
-- This demonstrates the --debug-types flag which shows:
--
-- 1. [Substitution Map] - Type variable bindings during unification
--    Shows when type variables (α1, α2, etc.) are bound to concrete types.
--    Example: α1 → int (direct), or α1 → α2 → float (CHAIN)
--
-- 2. [Constraints] - Type class constraint events (M-DX11-PHASE2)
--    - Added: when constraints like Num, Eq, Ord are added during inference
--    - Resolved: when constraints are satisfied by type class instances
--
-- 3. [CoreTI Entries] - Type information for each Core AST node
--    - NodeID: Unique identifier for the node
--    - Type: The inferred type (e.g., int, float, α22 -> α22 -> α22)
--    - Constraint: Resolved method (e.g., Num → add means + uses add method)
--    - Origins: WHERE the type came from (provenance tracking)
--
-- Origins/Provenance kinds:
--    - inferred: fresh type variable created during inference
--    - defaulted: type variable defaulted (e.g., Num → int)
--    - annotation: explicit type annotation
--    - literal: inferred from literal value
--
-- Filter to specific node: ailang run --debug-types --node 42 ...
--
-- === DEBUGGING SCENARIOS ===
--
-- Q: "Why did my polymorphic function get type int?"
-- A: Look for Origins showing "defaulted" - Num defaults to int
--
-- Q: "Which nodes share the same type variable?"
-- A: Search for the same α name (e.g., α22) across multiple nodes
--
-- Q: "Which builtin is being called for + operator?"
-- A: Look for "Constraint: Num → add" showing method resolution

module examples/debug_types_demo

-- Numeric operations trigger Num constraints
let add = \x. \y. x + y
let mul = \a. \b. a * b

-- Using numeric functions with concrete types
let sum = add(10)(20)
let product = mul(3)(4)

-- Comparison triggers Ord constraint
let maximum = \x. \y. if x > y then x else y
let bigger = maximum(100)(50)

-- Equality triggers Eq constraint
let same = \a. \b. a == b
let equal = same(42)(42)

-- Float literals
let pi = 3.14159
let area = pi * 2.0 * 2.0

-- String operations
let greeting = "Hello, " ++ "World!"

-- Main entrypoint
export func main() -> () ! {IO} =
  print(greeting)
