module examples/chess/perft
import examples/chess/board (Position)
import examples/chess/fen (parseFen, startFen)
import examples/chess/movegen (Child, AttackTables, attackTables, legalChildrenWith, countLegalWith, moveName)
import std/list (map)
import std/result (Result, Ok, Err)

-- Perft counts legal move paths of exactly depth plies.
func perftWith(tables: AttackTables, p: Position, depth: int) -> int ! {} =
  if depth <= 0 then 1 else if depth == 1 then countLegalWith(tables, p) else countChildren(tables, legalChildrenWith(tables, p), depth - 1, 0)

func countChildren(tables: AttackTables, children: [Child], depth: int, total: int) -> int ! {} = match children {
  [] => total,
  child :: rest => countChildren(tables, rest, depth, total + perftWith(tables, child.pos, depth))
}

export func perft(p: Position, depth: int) -> int ! {} = perftWith(attackTables(), p, depth)

export func divide(p: Position, depth: int) -> [(string, int)] ! {} = if depth <= 0 then [] else {
  let tables = attackTables()
  map(\child. (moveName(child.move), perftWith(tables, child.pos, depth - 1)), legalChildrenWith(tables, p))
}

export func countFen(fen: string, depth: int) -> Result[int, string] ! {} =
  if depth < 0 then Err("perft depth must be nonnegative") else match parseFen(fen) {
    Ok(p) => Ok(perft(p, depth)),
    Err(msg) => Err(msg)
  }

export func startCount(depth: int) -> Result[int, string] ! {} = countFen(startFen(), depth)

func fixture(fen: string, depth: int) -> int ! {}
  tests [
    (("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1", 0), 1),
    (("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1", 1), 20),
    (("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1", 2), 400),
    (("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1", 3), 8902),
    (("r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1", 1), 48),
    (("r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1", 2), 2039),
    (("8/2p5/3p4/KP5r/1R3p1k/8/4P1P1/8 w - - 0 1", 1), 14),
    (("8/2p5/3p4/KP5r/1R3p1k/8/4P1P1/8 w - - 0 1", 2), 191),
    (("r3k2r/Pppp1ppp/1b3nbN/nP6/BBP1P3/q4N2/Pp1P2PP/R2Q1RK1 w kq - 0 1", 1), 6),
    (("r3k2r/Pppp1ppp/1b3nbN/nP6/BBP1P3/q4N2/Pp1P2PP/R2Q1RK1 w kq - 0 1", 2), 264),
    (("rnbq1k1r/pp1Pbppp/2p5/8/2B5/8/PPP1NnPP/RNBQK2R w KQ - 1 8", 1), 44),
    (("rnbq1k1r/pp1Pbppp/2p5/8/2B5/8/PPP1NnPP/RNBQK2R w KQ - 1 8", 2), 1486)
  ] {
  match countFen(fen, depth) {
    Ok(n) => n,
    Err(_) => -1
  }
}
