-- Pipe Operator (`|>`)
-- Demonstrates left-associative value pipelines with named functions, lambdas,
-- curried calls and the explicit `_` placeholder for multi-arg calls.

module examples/runnable/pipe_operator
import std/list (filter, foldl, map)

pure func double(x: int) -> int
  tests [(5, 10), (0, 0), (-3, -6)]
{
  x * 2
}

pure func addOne(x: int) -> int
  tests [(10, 11), (-1, 0)]
{
  x + 1
}

pure func makeAdder(n: int) -> (int -> int) = \x. x + n

pure func sumInts(xs: [int]) -> int
  tests [([2, 6, 8], 16), ([], 0)]
{
  foldl(\acc x. acc + x, 0, xs)
}

export func main() -> () ! {IO} {
  -- Simple pipeline with named unary functions
  let n = 5 |> double |> addOne
  println("5 |> double |> addOne = ${show(n)}")
  -- List pipeline with parenthesized lambda stages
  let nums = [-2, 1, 3, -1, 4]
  let total = nums |> (\xs. filter(\x. x > 0, xs)) |> (\xs. map(double, xs)) |> sumInts
  println("positive doubled sum = ${show(total)}")
  -- Curried call: `5 |> makeAdder(1)` is `makeAdder(1)(5)`
  let bumped = 5 |> makeAdder(1)
  println("5 |> makeAdder(1) = ${show(bumped)}")
  -- `_` marks where the piped value goes in a multi-arg call
  let placeholder = nums |> filter(\x. x > 0, _) |> map(double, _) |> sumInts
  println("placeholder pipeline sum = ${show(placeholder)}")
}
