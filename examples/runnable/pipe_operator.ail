-- Pipe Operator (`|>`)
-- Demonstrates left-associative value pipelines with named functions and lambdas.

module examples/runnable/pipe_operator
import std/list (filter, foldl, map)

pure func double(x: int) -> int = x * 2

pure func addOne(x: int) -> int = x + 1

pure func sumInts(xs: [int]) -> int = foldl(\acc x. acc + x, 0, xs)

export func main() -> () ! {IO} {
  -- Simple pipeline with named unary functions
  let n = 5 |> double |> addOne
  println("5 |> double |> addOne = ${show(n)}")
  -- List pipeline with parenthesized lambda stages
  let nums = [-2, 1, 3, -1, 4]
  let total = nums |> (\xs. filter(\x. x > 0, xs)) |> (\xs. map(double, xs)) |> sumInts
  println("positive doubled sum = ${show(total)}")
}
