-- XML builder example
-- Build XML documents programmatically with xmlElement, xmlText, xmlComment

module examples/runnable/xml_build

import std/xml (xmlElement, xmlText, xmlComment, serialize)

export func main() -> unit ! {IO} = {
    let greeting = xmlElement("greeting", [{name: "lang", value: "en"}], [
        xmlText("Hello, World!")
    ]);

    let doc = xmlElement("root", [], [
        xmlComment(" Generated by AILANG "),
        greeting,
        xmlElement("items", [], [
            xmlElement("item", [{name: "id", value: "1"}], [xmlText("First")]),
            xmlElement("item", [{name: "id", value: "2"}], [xmlText("Second")])
        ])
    ]);

    println(serialize(doc))
}
