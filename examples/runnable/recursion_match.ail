-- recursion_match.ail
-- Demonstrates recursion with pattern matching (match expression)
-- Status: ✅ Working (v0.4.9 - M-BUG-RECURSION-DEPTH fix)

module examples/runnable/recursion_match

import std/io (println)

-- Count using match expression (previously broken, now fixed)
-- This tests the int64 literal pattern matching fix
pure func count(n: int) -> int {
  match n {
    0 => 0,
    _ => 1 + count(n-1)
  }
}

-- Sum using match expression
pure func sum(n: int) -> int {
  match n {
    0 => 0,
    _ => n + sum(n-1)
  }
}

-- Factorial using match expression
pure func factorial(n: int) -> int {
  match n {
    0 => 1,
    1 => 1,
    _ => n * factorial(n-1)
  }
}

-- Fibonacci using match (non-tail-recursive)
pure func fib(n: int) -> int {
  match n {
    0 => 0,
    1 => 1,
    _ => fib(n-1) + fib(n-2)
  }
}

export func main() -> () ! {IO} {
  println("=== Recursion with Match Expressions ===");

  -- Test count
  println("count(10) = " ++ show(count(10)));
  println("count(100) = " ++ show(count(100)));

  -- Test sum
  println("sum(10) = " ++ show(sum(10)));
  println("sum(100) = " ++ show(sum(100)));

  -- Test factorial
  println("factorial(5) = " ++ show(factorial(5)));
  println("factorial(10) = " ++ show(factorial(10)));

  -- Test fibonacci (small values due to exponential complexity)
  println("fib(10) = " ++ show(fib(10)));
  println("fib(15) = " ++ show(fib(15)))
}
