-- guards_module.ail - Pattern guards with module structure
module examples/runnable/guards_module

-- Test basic integer guards
func testBasicGuard() -> string =
  match 5 {
    x if x > 10 => "big",
    x if x > 0 => "positive",
    x => "other"
  }

-- Test equality guard
func testEqualityGuard() -> string =
  match 42 {
    x if x == 42 => "the answer",
    x => "not the answer"
  }

-- Test multiple guards falling through
func testMultipleGuards() -> string =
  match -3 {
    x if x > 0 => "positive",
    x if x == 0 => "zero",
    x if x < 0 => "negative",
    _ => "impossible"
  }

-- Test tuple pattern with guards
func testTupleGuard() -> string =
  match (10, 20) {
    (x, y) if x > y => "x bigger",
    (x, y) if x < y => "y bigger",
    (x, y) => "equal"
  }

-- Main entry point
export func main() -> () ! {IO} =
  {
    println(testBasicGuard());
    println(testEqualityGuard());
    println(testMultipleGuards());
    println(testTupleGuard())
  }
