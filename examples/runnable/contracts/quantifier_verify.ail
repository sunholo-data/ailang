-- examples/runnable/contracts/quantifier_verify.ail
-- Bounded quantifier examples demonstrating forall in ensures clauses
-- M6: Bounded quantifiers for element-wise contract verification

module examples/runnable/contracts/quantifier_verify

-- Simple bounded quantifier: all elements in range are non-negative
-- The forall clause asserts that for every index i in [0, n),
-- some property holds.
export func positiveRange(n: int) -> int ! {}
requires { n >= 0 }
ensures { forall i: 0..n => i >= 0 }
{
  n
}

-- Bounded quantifier with result reference
-- Verifies that the result is always >= every index in the range
export func doubleRange(n: int) -> int ! {}
requires { n >= 0 }
ensures { result >= n }
{
  n * 2
}

-- Combining requires and ensures with forall
-- Multiple contract predicates work alongside forall
export func clampedAdd(x: int, y: int) -> int ! {}
requires { x >= 0, y >= 0 }
ensures { result >= x }
{
  x + y
}
