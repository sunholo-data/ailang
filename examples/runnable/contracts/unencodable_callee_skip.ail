-- examples/runnable/contracts/unencodable_callee_skip.ail
-- Cross-function contract where the callee is generic (`firstOr[a]`). A type
-- variable has no SMT sort, so static verification of `gradeNumeric` is OUTSIDE
-- the encodable fragment: `ailang verify` SKIPS it with a structured
-- UNENCODABLE_TYPE reason (naming the callee + offending type) rather than
-- crashing Z3 — see M-SMT-CALLEE-SORT-GATE. (An Option[float] callee, then a
-- tuple-returning one, used to be the example; Option, Result, other ADTs at a
-- concrete type, and tuples now verify.)
-- Runtime contracts still hold; this program runs normally.
module examples/runnable/contracts/unencodable_callee_skip

-- Callee is generic in its element type — a type with no SMT encoding.
export func firstOr[a](xs: [a], d: a) -> a ! {} {
  match xs { [] => d, [x, ..._] => x }
}

-- Contracted caller. `ailang verify` reports: SKIPPED (UNENCODABLE_TYPE) because
-- `firstOr`'s signature uses the type variable a. It does NOT emit a Z3 error.
export func gradeNumeric(x: float) -> float ! {}
requires { x >= 0.0 }
ensures { result >= 0.0 } {
  firstOr([x * 2.0], 0.0)
}

export func main() -> () ! {IO} {
  println("gradeNumeric(3.5) = ${show(gradeNumeric(3.5))}")
}
