-- examples/runnable/contracts/nested_record_verify.ail
-- Nested record contract verification demonstration
-- Shows Z3 proving properties about nested record field access
-- Demonstrates: nested record params, nested field access in requires/ensures,
--               dependency-ordered SMT-LIB declarations
--
-- Run:    ailang verify examples/runnable/contracts/nested_record_verify.ail
-- Expect: 2 verified

module examples/runnable/contracts/nested_record_verify

-- ============================================================================
-- Nested record: access inner fields through outer record
-- ============================================================================

-- Extract the X coordinate from a nested position record
-- Z3 proves: if inner.x >= 0, then result >= 0
export func getInnerX(o: {name: string, pos: {x: int, y: int}}) -> int ! {}
requires { o.pos.x >= 0 }
ensures { result >= 0 }
{
  o.pos.x
}

-- Compute manhattan distance from nested position
-- Z3 proves: if both inner coords are non-negative, sum is non-negative
export func nestedManhattan(o: {name: string, pos: {x: int, y: int}}) -> int ! {}
requires { o.pos.x >= 0, o.pos.y >= 0 }
ensures { result >= 0 }
{
  o.pos.x + o.pos.y
}

-- Entry point
export func main() -> int ! {}
{
  let obj = {name: "origin", pos: {x: 3, y: 4}};
  let x = getInnerX(obj);
  let m = nestedManhattan(obj);
  x + m
}
