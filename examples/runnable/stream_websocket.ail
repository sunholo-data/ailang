-- examples/runnable/stream_websocket.ail
-- Demonstrates bidirectional WebSocket streaming with std/stream
-- Requires: --caps Stream,IO
--
-- Usage:
--   ailang run --caps Stream,IO --entry main examples/runnable/stream_websocket.ail
--
-- Shows both the low-level API (connect/transmit/disconnect) and the
-- high-level withStream helper. Uses typed ADTs for events.

module examples/runnable/stream_websocket

import std/stream (connect, transmit, onEvent, runEventLoop, disconnect, defaultConfig, withStream, StreamConn, StreamEvent, Message, Closed, StreamError, StreamErrorKind)
import std/result (Result, Ok, Err)

-- Event handler: pattern match on stream events
export func handler(event: StreamEvent) -> bool {
  match event {
    Message(msg) => false,
    Closed(code, reason) => false,
    StreamError(err) => false,
    _ => true
  }
}

-- Low-level API: explicit connect/send/disconnect with Result unwrapping
export func main() -> unit ! {Stream, IO} {
  let config = defaultConfig(());
  let result = connect("wss://echo.websocket.events", config);
  match result {
    Ok(conn) => {
      _io_println("connected");
      let sent = transmit(conn, "Hello from AILANG!");
      _io_println("message sent");
      onEvent(conn, handler);
      runEventLoop(conn);
      disconnect(conn);
      _io_println("done")
    },
    Err(e) => _io_println("connection failed")
  }
}

-- High-level API: withStream manages the full lifecycle
export func mainSimple() -> unit ! {Stream, IO} {
  let result = withStream("wss://echo.websocket.events", handler);
  _io_println("done")
}
