-- persistent_collections.ail - the competitive-programming toolkit in pure AILANG
--
-- Three structures from M-PERSISTENT-COLLECTIONS Phase 1:
--   1. a visited Set over structured states, Set[(int, int, Dir)]
--   2. a difference array built with std/array.accumulate (one copy)
--   3. a Map keyed by tuples and records
--
-- Cost note: Set.insert / Map.insert copy the structure today (O(n) per call),
-- so these are the right shapes but not yet the right constants for very large
-- searches; see docs/LIMITATIONS.md.

module examples/runnable/persistent_collections
import std/io (println)
import std/set as S
import std/set (Set)
import std/map as M
import std/array as A

type Dir = N | E | S | W

func turn(d: Dir) -> Dir = match d {
  N => E,
  E => S,
  S => W,
  W => N
}

func step(r: int, c: int, d: Dir) -> (int, int) = match d {
  N => (r - 1, c),
  E => (r, c + 1),
  S => (r + 1, c),
  W => (r, c - 1)
}

-- A robot on a w x h grid moves forward, turning right at a wall or a block.
-- It never leaves the grid, so it must eventually repeat a state; count the
-- moves until the first repeated (row, col, dir), the way a Python solution
-- would with `visited = set()`.
func walk(w: int, h: int, blocks: Set[(int, int)], r: int, c: int, d: Dir, seen: Set[(int, int, Dir)], moves: int) -> int =
  if S.member(seen, (r, c, d)) then moves else match step(r, c, d) {
    (r2, c2) => if r2 < 0 || r2 >= h || c2 < 0 || c2 >= w || S.member(blocks, (r2, c2)) then walk(w, h, blocks, r, c, turn(d), S.insert(seen, (r, c, d)), moves + 1) else walk(w, h, blocks, r2, c2, d, S.insert(seen, (r, c, d)), moves + 1)
  }

-- Running sum of a list: turns a difference array into the values.
func prefix(xs: [int], run: int) -> [int] = match xs {
  [] => [],
  x :: rest => run + x :: prefix(rest, run + x)
}

-- Cover cells [lo, hi) for each interval: +1 at lo, -1 at hi, with ONE copy.
func coverage(n: int, intervals: [(int, int)]) -> [int] {
  let diff = A.accumulate(A.make(n + 1, 0), flatten(intervals), \a b. a + b)
  prefix(A.toList(diff), 0)
}

func flatten(ivs: [(int, int)]) -> [(int, int)] = match ivs {
  [] => [],
  (lo, hi) :: rest => (lo, 1) :: (hi, -1) :: flatten(rest)
}

export func main() -> () ! {IO} {
  let blocks = S.fromList([(0, 2), (2, 1)])
  println("moves before a repeated state: ${show(walk(3, 3, blocks, 0, 0, E, S.empty(), 0))}")
  println("coverage: ${show(coverage(6, [(0, 3), (2, 5), (4, 6)]))}")
  let dist = M.fromList([((0, 0), 0), ((0, 1), 1), ((1, 1), 2)])
  let tags = M.insert(M.empty(), { name: "alice", team: 1 }, "lead")
  println("dist to (1, 1): ${show(M.lookup(dist, (1, 1)))}")
  println("keys in canonical order: ${show(M.keys(dist))}")
  println("record key: ${show(M.lookup(tags, { team: 1, name: "alice" }))}")
  println("union: ${show(S.toList(S.union(S.fromList([1, 2]), S.fromList([2, 3]))))}")
}
