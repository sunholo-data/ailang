-- exit_code.ail: Demonstrate process exit with explicit exit code
--
-- Usage:
--   ailang run --caps IO examples/runnable/exit_code.ail
--   echo $?  -- prints 42
--
-- The exit() function terminates the process immediately with the given code.
-- Code after exit() is unreachable. Requires IO capability.

module examples/runnable/exit_code

import std/io (println, exit)

export func main() -> () ! {IO} =
  let _ = println("Exiting with code 42") in
  exit(42)
