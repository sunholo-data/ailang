-- Property-based differential testing: check a fast algorithm against a slow,
-- obviously-correct reference on generated inputs, before trusting it.
-- `ailang test` runs each `property` on 100 generated cases and prints the
-- failing input as a counterexample (replay with --seed). Python's stdlib has no equivalent.
module examples/runnable/property_differential_testing

import std/list (foldl, length)
import std/io (println)

-- Brute force: the best sum over every non-empty contiguous slice. O(n^2), easy to trust.
func bestFrom(xs: [int], acc: int, best: int) -> int =
  match xs {
    [] => best,
    x :: rest =>
      let s = acc + x in
      bestFrom(rest, s, if s > best then s else best)
  }

func bruteMaxSlice(xs: [int]) -> int =
  match xs {
    [] => 0,
    x :: rest =>
      let here = bestFrom(rest, x, x) in
      let later = bruteMaxSlice(rest) in
      if length(rest) == 0 then here else if here > later then here else later
  }

-- Fast: Kadane's algorithm, one pass. This is the version to submit.
export func maxSlice(xs: [int]) -> int =
  match xs {
    [] => 0,
    x :: rest =>
      let step = \st y.
        match st { (cur, best) =>
          let c = if cur + y > y then cur + y else y in
          (c, if c > best then c else best) } in
      match foldl(step, (x, x), rest) { (_, best) => best }
  }

test "known case" { maxSlice([-2, 1, -3, 4, -1, 2, 1, -5, 4]) == 6 }

property "fast agrees with brute force" {
  forall(xs: [int]) => maxSlice(xs) == bruteMaxSlice(xs)
}

export func main() -> () ! {IO} =
  println("maxSlice = ${show(maxSlice([-2, 1, -3, 4, -1, 2, 1, -5, 4]))}")
