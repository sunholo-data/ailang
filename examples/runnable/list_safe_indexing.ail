-- list_safe_indexing.ail - Safe list indexing helpers (v0.27.0+)
-- Demonstrates nthOr / headOr / lastOr: total versions of nth/head/last that
-- return a caller-supplied default instead of Option, removing the Some/None
-- unwrap boilerplate at every indexing call site while staying crash-free.

module examples/runnable/list_safe_indexing
import std/io (println)
import std/list (nthOr, headOr, lastOr)

export func main() -> () ! {IO} {
  let xs = [10, 20, 30]
  -- In bounds → the element; out of bounds / negative → the default.
  println("nthOr(xs, 1)   = ${show(nthOr(xs, 1, 0))}")  -- 20
  println("nthOr(xs, 9)   = ${show(nthOr(xs, 9, 0))}")  -- 0 (default)
  println("nthOr(xs, -1)  = ${show(nthOr(xs, -1, 0))}")  -- 0 (default)
  println("headOr(xs)     = ${show(headOr(xs, 0))}")  -- 10
  println("headOr([])     = ${show(headOr([], 0))}")  -- 0 (default)
  println("lastOr(xs)     = ${show(lastOr(xs, 0))}")  -- 30
}
