-- Type inference regression T4: flatMapE list expansion
-- Verifies: flatMapE infers (a) -> [b] ! {IO} for expansion lambda
-- Expected: each element expands to a pair, with IO side-effects
module examples/runnable/effectful_list_t4_flatMapE_expand

import std/io (println)
import std/list (flatMapE)

export func main() -> () ! {IO} {
  let result = flatMapE(\x. {
    println("  expand " ++ show(x));
    [x, x * x]
  }, [2, 3, 4]);
  println("T4 flatMapE: " ++ show(result))
}
