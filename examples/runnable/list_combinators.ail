-- Standard Library List, Map & Result Combinators
-- Demonstrates std/list (all, enumerate, filterMap, partition, find, span, chunk, groupBy),
-- std/map (update, mapValues, filter), and std/result (getOrElse).

module examples/runnable/list_combinators
import std/list (all, chunk, enumerate, filterMap, find, groupBy, partition, span)
import std/map as M
import std/option (None, Some)
import std/result (Err, Ok, getOrElse)
import std/string (stringToInt)

export func main() -> () ! {IO} {
  let nums = [2, 4, 6, 8]
  println("all even: ${show(all(\x. x % 2 == 0, nums))}")
  -- enumerate pairs each element with its 0-based index
  let indexed = enumerate(["a", "b", "c"])
  println("enumerate: ${show(indexed)}")
  -- filterMap parses valid ints and drops non-numeric strings in one O(n) pass
  let parsed = filterMap(stringToInt, ["10", "oops", "20", "30"])
  println("filterMap: ${show(parsed)}")
  -- partition splits into (matching, nonMatching) in one O(n) pass
  let (evens, odds) = partition(\x. x % 2 == 0, [1, 2, 3, 4, 5, 6])
  println("partition evens=${show(evens)} odds=${show(odds)}")
  -- span splits at the first element failing the predicate
  let (prefix, rest) = span(\x. x < 4, [1, 2, 3, 4, 1, 2])
  println("span prefix=${show(prefix)} rest=${show(rest)}")
  -- chunk splits into contiguous sublists of length n
  let chunks = chunk(2, [1, 2, 3, 4, 5])
  println("chunk: ${show(chunks)}")
  -- groupBy groups elements by key while preserving relative order
  let grouped = groupBy(\x. x % 2, [1, 2, 3, 4, 5])
  println("groupBy mod 2: ${show(M.toList(grouped))}")
  -- std/map update, mapValues, filter
  let base = M.fromList([("a", 1), ("b", 2), ("c", 3)])
  let updated = M.update(M.update(base, "a", 10, \v. v + 10), "d", 4, \v. v + 10)
  let doubled = M.mapValues(\v. v * 2, updated)
  let large = M.filter(\_ v. v >= 6, doubled)
  println("map filtered: ${show(M.toList(large))}")
  -- find returns the first matching element as Option[a]
  match find(\x. x > 4, [1, 3, 5, 7]) {
    Some(x) => println("find > 4: Some(${show(x)})"),
    None => println("find > 4: None")
  }
  -- std/result.getOrElse extracts Ok or falls back on Err
  let good = getOrElse(Ok(42), 0)
  let fallback = getOrElse(Err("missing"), -1)
  println("result getOrElse: good=${show(good)} fallback=${show(fallback)}")
}
