-- examples/runnable/secrets/sink_function_value.ail
--
-- M-IFC-FUNCTION-VALUE-SINKS (#1719): three leaks the type system REJECTS.
--
-- Before #1719 a {not email} sink was enforced only when called by its own
-- name. Renaming it, passing it to a higher-order function, or wrapping it in
-- a lambda dropped the requirement, and all three functions below compiled.
-- The requirement now travels with the function value.
--
-- This file is EXPECTED TO FAIL `ailang check`, with one diagnostic per leak:
--
--   $ ailang check examples/runnable/secrets/sink_function_value.ail
--   information-flow violation: value labelled <email> reaches parameter
--     "body" of deliver (via out) which forbids it (string{not email})
--   ... "body" of deliver (via apply1 → f) ...
--   ... "body" of deliver (via w) ...
--
-- sink_function_value_ok.ail is the accepted twin: clean data, or <email>
-- data declassified before it reaches the sink.
module examples/runnable/secrets/sink_function_value

-- Untrusted source: everything read from the inbox carries <email>.
pure func fromInbox(s: string) -> string<email> {
  s
}

-- Outbound sink: refuses anything labelled <email>.
pure func deliver(body: string{not email}) -> string {
  "sent:${body}"
}

pure func apply1(f: string -> string, x: string) -> string {
  f(x)
}

-- ✗ alias: `out` is `deliver`, so it forbids <email> too
export func leakViaAlias() -> string {
  let out = deliver in out(fromInbox("customer text"))
}

-- ✗ higher-order: apply1 applies its f to x, so x reaches deliver
export func leakViaHof() -> string {
  apply1(deliver, fromInbox("customer text"))
}

-- ✗ wrapper lambda: w forwards its argument to deliver
export func leakViaWrapper() -> string {
  let w = \y. deliver(y) in w(fromInbox("customer text"))
}
