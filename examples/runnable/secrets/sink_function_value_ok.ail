-- examples/runnable/secrets/sink_function_value_ok.ail
--
-- M-IFC-FUNCTION-VALUE-SINKS (#1719): sinks are ordinary function values.
--
-- A {not email} sink can be aliased, passed to a higher-order function,
-- mapped over a list and stored in a record. The requirement travels with the
-- value, so every one of those uses is checked against the data actually
-- applied. Clean data passes; <email> data must be declassified first.
-- sink_function_value.ail is the rejected twin of this file.
--
-- Check: ailang check examples/runnable/secrets/sink_function_value_ok.ail
-- Run:   ailang run --caps IO,Declassify --entry main examples/runnable/secrets/sink_function_value_ok.ail
module examples/runnable/secrets/sink_function_value_ok

import std/io (println)
import std/list (map)
import std/string (join)

-- Untrusted source: everything read from the inbox carries <email>.
pure func fromInbox(s: string) -> string<email> { s }

-- Outbound sink: refuses anything labelled <email>.
pure func deliver(body: string{not email}) -> string { "sent:${body}" }

-- The only way down from <email>: an explicit Declassify step.
pure func redact(raw: string<email>) -> string<redacted> ! {Declassify} { "[redacted]" }

pure func apply1(f: string -> string, x: string) -> string { f(x) }

export func main() -> () ! {IO, Declassify} {
  let out = deliver in
  let viaAlias = out("hello") in
  let viaHof = apply1(deliver, "status ok") in
  let mapped = join(",", map(deliver, ["a", "b"])) in
  let hooks = { onReply: deliver, retries: 3 } in
  let viaField = hooks.onReply(redact(fromInbox("customer text"))) in
  {
    println(viaAlias);
    println(viaHof);
    println(mapped);
    println(viaField)
  }
}
