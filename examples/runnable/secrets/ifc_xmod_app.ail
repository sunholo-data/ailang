-- examples/runnable/secrets/ifc_xmod_app.ail
--
-- M-IFC-CROSS-MODULE (#1134): an importer bound by its library's taint sink.
--
-- ifc_xmod_lib.deliver declares body: string{not email}. This module passes inbox
-- mail to it only through the library's redact declassifier, so it checks clean.
--
-- Replace forward's body with  deliver(fromInbox(raw))  and `ailang check` rejects it:
--
--   information-flow violation: value labelled <email> reaches parameter "body"
--   of imported function examples/runnable/secrets/ifc_xmod_lib.deliver (via deliver)
--   which forbids it (string{not email})
--
-- Until the #1134 fix that leak compiled clean: refinements did not cross a
-- module boundary.
--
-- Check: ailang check examples/runnable/secrets/ifc_xmod_app.ail
-- Run:   ailang run --caps Declassify --entry main examples/runnable/secrets/ifc_xmod_app.ail

module examples/runnable/secrets/ifc_xmod_app
import examples/runnable/secrets/ifc_xmod_lib (deliver, fromInbox, redact)

export func forward(raw: string) -> string ! {Declassify[label=email]} {
  deliver(redact(fromInbox(raw)))
}

export func main() -> string ! {Declassify[label=email]} {
  forward("mark@example.com: please book the room")
}
