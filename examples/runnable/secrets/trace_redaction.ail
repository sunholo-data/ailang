-- Check: ailang check examples/runnable/secrets/trace_redaction.ail
-- Run: AILANG_TRACE=deep ailang run --caps IO --emit-trace jsonl --entry main examples/runnable/secrets/trace_redaction.ail
--
-- M-TRACE-LABEL-AWARE: a <secret> value never reaches the execution trace.
-- Every traced call that receives, captures or returns it records
-- <redacted:secret> in place of its arguments and result; names, arity and
-- the span tree are kept. The program's own output is unchanged. The value
-- below is an obvious fake.
module examples/runnable/secrets/trace_redaction
import std/io (println)
import std/string (substring)

func classify(raw: string) -> string<secret> ! {} = raw

func masked(token: string<secret>) -> string ! {} = "${substring(token, 0, 4)}..."

export func main() -> () ! {IO} {
  let token = classify("FAKE_TOKEN_NOT_A_REAL_SECRET")
  println("token starts: ${masked(token)}")
}
