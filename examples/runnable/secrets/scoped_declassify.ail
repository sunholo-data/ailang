-- Check: ailang check examples/runnable/secrets/scoped_declassify.ail
-- Run: ailang run --caps Declassify --entry main examples/runnable/secrets/scoped_declassify.ail
module examples/runnable/secrets/scoped_declassify

export func redact(raw: string<email>) -> string<clean> ! {Declassify[label=email]} {
  "[redacted]"
}

export func main() -> string<clean> ! {Declassify[label=email]} {
  redact("private email")
}
