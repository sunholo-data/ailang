-- examples/runnable/secrets/leak_attempt.ail
--
-- M-SECRET-EFFECT (M5/M6): a secret leak the type system REJECTS.
--
-- secret("op://...") returns a value labelled <secret>. Passing it directly to
-- transmit — whose parameter is string{not secret} — is an information-flow
-- violation: the secret reaches a sink that forbids it, with no declassify step.
--
-- This file is EXPECTED TO FAIL `ailang check`:
--
--   $ ailang check examples/runnable/secrets/leak_attempt.ail
--   Error: type error in ...: information-flow violation: value labelled <secret>
--          reaches parameter "body" which forbids it (string{not secret})
--          Suggestion: declassify the value through a function declaring
--          ! {Declassify} before passing it to a {not secret} sink
--
-- gated_secret.ail shows the fix (route through a ! {Declassify} gate).

module examples/runnable/secrets/leak_attempt

import std/secret (secret)

-- A network/log boundary that refuses secret-labelled values.
export func transmit(body: string{not secret}) -> string ! {} { body }

export func main() -> string ! {Secret} {
  let key = secret("op://Prod/stripe/api-key", "transmit the key");
  transmit(key)   -- ✗ SINK VIOLATION: <secret> reaches {not secret}
}
