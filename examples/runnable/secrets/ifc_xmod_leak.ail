-- examples/runnable/secrets/ifc_xmod_leak.ail
--
-- M-IFC-CROSS-MODULE (#1134): the leak a library's sink now REJECTS across modules.
--
-- fromInbox returns <email>; ifc_xmod_lib.deliver declares body: string{not email}.
-- Passing one straight to the other, with no declassify step, is an
-- information-flow violation even though the sink lives in another module.
--
-- This file is EXPECTED TO FAIL `ailang check`:
--
--   $ ailang check examples/runnable/secrets/ifc_xmod_leak.ail
--   Error: ... information-flow violation: value labelled <email> reaches
--          parameter "body" of imported function
--          examples/runnable/secrets/ifc_xmod_lib.deliver (via deliver) which
--          forbids it (string{not email})
--
-- ifc_xmod_app.ail shows the fix (route through the library's redact gate).

module examples/runnable/secrets/ifc_xmod_leak
import examples/runnable/secrets/ifc_xmod_lib (deliver, fromInbox)

export func main() -> string {
  deliver(fromInbox("mark@example.com: forwarded body"))
}
