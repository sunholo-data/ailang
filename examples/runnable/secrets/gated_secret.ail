-- examples/runnable/secrets/gated_secret.ail
--
-- M-SECRET-EFFECT (M5/M6): the SAFE pattern for consuming a secret.
--
-- secret("op://...") resolves a 1Password reference to a value labelled <secret>
-- (M-TAINT-TYPES). The static information-flow check (CheckModuleIFC) forbids a
-- <secret> value from reaching a {not secret} sink — but `redact` declares
-- ! {Declassify}, which authorises lowering the label. After declassification
-- the value is safe to transmit.
--
-- Compare with leak_attempt.ail, which omits the declassify gate and is rejected
-- by `ailang check` at compile time.
--
-- Check:  ailang check examples/runnable/secrets/gated_secret.ail   (passes)
-- Run:    needs the Secret capability + 1Password `op` CLI + an approval, so it
--         is check-only in CI (see scripts/verify_examples.go skip list).

module examples/runnable/secrets/gated_secret

import std/secret (secret)

-- transmit models a network/log boundary that refuses secret-labelled values:
-- its parameter is string{not secret}, a sink refinement.
export func transmit(body: string{not secret}) -> string ! {} { body }

-- redact is the declassify gate. It takes a <secret> value and returns a value
-- whose label is lowered. ! {Declassify} is the explicit authority to do so;
-- it replaces the raw value with a constant so nothing secret survives.
export func redact(s: string<secret>) -> string ! {Declassify} { "[redacted]" }

-- main resolves a secret, declassifies it, then transmits the redacted result.
export func main() -> string ! {Secret, Declassify} {
  let key = secret("op://Prod/stripe/api-key", "charge a customer card");
  let safe = redact(key);
  transmit(safe)
}
