-- examples/runnable/secrets/ifc_xmod_lib.ail
--
-- M-IFC-CROSS-MODULE (#1134): a LIBRARY that enforces a taint sink for its callers.
--
-- deliver's body parameter is string{not email}: an <email>-labelled value must not
-- reach it. The refinement is part of this module's exported interface, so every
-- importer is checked against it — exactly as a caller in this module would be.
-- redact is the library's scoped declassifier: the one sanctioned way across.
--
-- Check: ailang check examples/runnable/secrets/ifc_xmod_lib.ail
-- Used by: examples/runnable/secrets/ifc_xmod_app.ail

module examples/runnable/secrets/ifc_xmod_lib

-- The sink: forwarded mail bodies must not reach it unredacted.
export func deliver(body: string{not email}) -> string ! {} {
  "sent: ${body}"
}

-- A source: mail read from the inbox is labelled <email>.
export func fromInbox(raw: string) -> string<email> ! {} {
  raw
}

-- The gate: drops the <email> label under scoped Declassify authority.
export func redact(raw: string<email>) -> string ! {Declassify[label=email]} {
  "[redacted]"
}
