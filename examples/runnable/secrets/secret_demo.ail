-- examples/runnable/secrets/secret_demo.ail
--
-- M-SECRET-EFFECT: a RUNNABLE end-to-end demo of gated secret resolution.
--
-- Unlike gated_secret.ail (which only type-checks the safe pattern), this one
-- prints, so you can watch a secret get resolved, declassified, and emitted
-- safely. It needs the Secret capability + a 1Password `op` CLI at runtime.
--
--   Real 1Password:   ailang run --caps Secret,IO --entry main secret_demo.ail
--   Local (no op):    use a fake `op` on PATH — see demo.sh in this directory.
--
-- The raw value is labelled <secret>; redact() is the ! {Declassify} gate that
-- lowers the label. Try deleting the redact() call and passing `key` straight to
-- println of a {not secret} sink — `ailang check` rejects it (see leak_attempt.ail).

module examples/runnable/secrets/secret_demo

import std/secret (secret)
import std/io (println)

-- redact is the declassify gate: it consumes a <secret> value and returns a
-- value whose label is lowered. ! {Declassify} is the explicit authority for
-- that; it emits only a masked form, so nothing secret survives.
export func redact(s: string<secret>) -> string ! {Declassify} { "sk-live-****" }

export func main() -> () ! {Secret, Declassify, IO} {
  let key = secret("op://Prod/stripe/api-key");  -- resolved just-in-time via op
  println("resolved a secret, emitting only the declassified form:");
  println(redact(key))
}
