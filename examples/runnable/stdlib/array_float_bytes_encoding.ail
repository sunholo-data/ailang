-- Serialize a float vector to little-endian bytes and back with std/array:
-- encodeF32LE packs 4 bytes per value (lossy), encodeF64LE packs 8 (exact),
-- and decodeF32LE/decodeF64LE return Err when the byte length is not a
-- multiple of the element size. Shows the wire bytes of one value, the
-- round-trip results, and the size of each encoding.
module examples/runnable/stdlib/array_float_bytes_encoding
import std/array (fromList, toList, encodeF32LE, decodeF32LE, encodeF64LE, decodeF64LE)
import std/bytes (length, toInts, slice)
import std/option (Some, None)

func showDecoded(label: string, r: Result[Array[float], string]) -> () ! {IO} = match r {
  Ok(arr) => println("${label}: ${show(toList(arr))}"),
  Err(_) => println("${label}: rejected")
}

export func main() -> () ! {IO} {
  let v = fromList([1.5, -2.25, 0.1])
  let f32 = encodeF32LE(v)
  let f64 = encodeF64LE(v)
  println("f32 size: ${show(length(f32))} bytes, f64 size: ${show(length(f64))} bytes")
  -- 1.5 as IEEE-754 single precision is 0x3FC00000; little-endian puts the low byte first
  println("1.5 as f32 LE: ${show(toInts(encodeF32LE(fromList([1.5]))))}")
  -- 1.5 and -2.25 are exact in f32; 0.1 is not, so only f64 round-trips it unchanged
  showDecoded("f32 round-trip", decodeF32LE(f32))
  showDecoded("f64 round-trip", decodeF64LE(f64))
  -- A truncated buffer is an error, not a partial array
  match slice(f32, 0, 6) {
    Some(cut) => showDecoded("6 bytes as f32", decodeF32LE(cut)),
    None => println("slice out of range")
  }
  -- 8 valid f32 bytes decode as two floats
  match slice(f32, 0, 8) {
    Some(two) => showDecoded("first 8 bytes as f32", decodeF32LE(two)),
    None => println("slice out of range")
  }
}
