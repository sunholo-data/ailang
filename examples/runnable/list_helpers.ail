-- List Helper Functions (v0.6.5)
-- Demonstrates nth, last, any, and findIndex functions

module examples/runnable/list_helpers

import std/list (nth, last, any, findIndex)
import std/option (Option, Some, None)

export func main() -> () ! {IO} {
  let nums = [10, 20, 30, 40, 50];

  -- nth: Get element at index (0-based)
  print("=== nth function ===");
  match nth(nums, 0) {
    Some(x) => print("nth(nums, 0) = " ++ show(x)),
    None => print("nth(nums, 0) = None")
  };
  match nth(nums, 2) {
    Some(x) => print("nth(nums, 2) = " ++ show(x)),
    None => print("nth(nums, 2) = None")
  };
  match nth(nums, 10) {
    Some(x) => print("nth(nums, 10) = " ++ show(x)),
    None => print("nth(nums, 10) = None (out of bounds)")
  };
  match nth(nums, -1) {
    Some(x) => print("nth(nums, -1) = " ++ show(x)),
    None => print("nth(nums, -1) = None (negative index)")
  };

  -- last: Get last element
  print("");
  print("=== last function ===");
  match last(nums) {
    Some(x) => print("last(nums) = " ++ show(x)),
    None => print("last(nums) = None")
  };
  let emptyList: [int] = [];
  match last(emptyList) {
    Some(x) => print("last([]) = " ++ show(x)),
    None => print("last([]) = None (empty list)")
  };

  -- any: Check if any element matches predicate
  print("");
  print("=== any function ===");
  let hasEven = any(\x. x % 2 == 0, nums);
  print("any(isEven, nums) = " ++ show(hasEven));
  let hasNegative = any(\x. x < 0, nums);
  print("any(isNegative, nums) = " ++ show(hasNegative));
  let hasGreaterThan45 = any(\x. x > 45, nums);
  print("any(>45, nums) = " ++ show(hasGreaterThan45));

  -- findIndex: Find index of first matching element
  print("");
  print("=== findIndex function ===");
  match findIndex(\x. x > 25, nums) {
    Some(i) => print("findIndex(>25, nums) = " ++ show(i)),
    None => print("findIndex(>25, nums) = None")
  };
  match findIndex(\x. x > 100, nums) {
    Some(i) => print("findIndex(>100, nums) = " ++ show(i)),
    None => print("findIndex(>100, nums) = None (not found)")
  }
}
