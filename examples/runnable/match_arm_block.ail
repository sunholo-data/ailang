module examples/runnable/match_arm_block
import std/io (println)

// Match arm with explicit block containing match

export func test() -> int {
  let x = (1, 2)
  match x {
    (a, b) => {
      let y = (3, 4)
      match y {
        (c, d) => c
      }
    }
  }
}

export func main() -> () ! {IO} {
  println(show(test()))
}
