-- serve_api_mcp_identity.ail - a tool that knows who signed in
-- The @mcp_token_verifier returns the token's identity instead of a bool.
-- A tool that declares `_auth: McpIdentity` gets that identity from the
-- Bearer gate:
--   * _auth is never in the tool's inputSchema, and whatever a client sends
--     under that name is overwritten;
--   * the tool is served only on the gated /mcp/connect/ surface. It is not on
--     /mcp/, REST, OpenAPI or A2A, because no other path has a verified identity;
--   * None, or Some with an empty subject, is a rejected token (HTTP 401).
-- --mcp-subject-rpm limits calls per signed-in subject (429 + Retry-After).
-- Run with:
--   ailang serve-api --mcp-http --caps IO,SharedMem --oauth-issuer https://auth.example.com \
--     --mcp-subject-rpm 60 examples/runnable/serve_api_mcp_identity.ail
-- Then call whoami on /mcp/connect/ with "Authorization: Bearer demo_alice".
module examples/runnable/serve_api_mcp_identity
import std/io (println)
import std/option (Option, Some, None)
import std/string (length, startsWith, substring)

-- The identity record. Its three fields are fixed; inline or a type in this
-- module both work.
export type McpIdentity = { subject: string, client_id: string, scopes: [string] }

-- True for a non-empty subject: serve-api refuses the token otherwise.
-- Helpers: neither tools nor HTTP endpoints.
@noexpose
@nomcp
export pure func isSignedIn(subject: string) -> bool
  tests [
    ("", false),
    ("u1", true)
  ] {
  length(subject) > 0
}

-- The subject a demo token names ("demo_alice" -> "alice"; "" for anything else).
@noexpose
@nomcp
export pure func demoSubject(token: string) -> string
  tests [
    ("demo_alice", "alice"),
    ("demo_", ""),
    ("x", "")
  ] {
  if startsWith(token, "demo_") then substring(token, 5, length(token)) else ""
}

-- A real service looks the token up in its store (as sunholo/mcp_oauth's
-- adopters do) and returns the account it was issued to.
@mcp_token_verifier
export func verifyToken(token: string) -> Option[McpIdentity] ! {SharedMem} {
  let subject = demoSubject(token)
  if isSignedIn(subject) then Some({ subject: subject, client_id: "https://client.example/metadata.json", scopes: ["read"] }) else None
}

-- Who am I? The answer comes from the verified token, never from the client.
@mcp_title("Who am I")
@mcp_hints("readOnly", "idempotent")
@mcp_auth("oauth2")
export pure func whoami(_auth: McpIdentity) -> string = "signed in as ${_auth.subject} via ${_auth.client_id}"

-- Entry point for `ailang run`; not a tool on either MCP surface.
@nomcp
export func main() -> unit ! {IO} {
  println(whoami({ subject: "alice", client_id: "https://client.example/metadata.json", scopes: [] }))
  println(show(isSignedIn(demoSubject("demo_alice"))))
}
