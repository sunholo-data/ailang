-- serve_api_webhook.ail
-- Demonstrates @raw @route for receiving raw HTTP requests with headers.
-- Use case: webhook handlers that need access to signature headers.
--
-- Run as a server: ailang serve-api examples/runnable/serve_api_webhook.ail
-- Test: curl -X POST http://localhost:8080/webhooks/example \
--         -H "X-Signature: abc123" \
--         -d '{"event": "test"}'
--
-- Regression guard: a `let x = <block-expr>` binding needs a `;` before the
-- next expression, and string joining uses "${expr}" interpolation (`++` is
-- list-only since v0.13.0).

module examples/runnable/serve_api_webhook

import std/json (Json, getString, decode)
import std/string (length)

-- A @raw @route handler receives a record with:
--   body: string, headers: Json, method: string, path: string, query: Json
-- Headers and query are JObject — use std/json.get() for key lookup.
-- This handles hyphenated keys like "Stripe-Signature" that dot notation can't.
@raw
@route("POST", "/webhooks/example")
export func handleWebhook(request: {body: string, headers: Json, method: string, path: string}) -> string ! {IO} {
  let sig = match getString(request.headers, "X-Signature") {
    Some(s) => s,
    None => "no-signature"
  };
  "received webhook with signature: ${sig} body length: ${show(length(request.body))}"
}

-- Non-@raw routes continue to work with parsed arguments as before
@route("GET", "/health")
export pure func health() -> string {
  "ok"
}

-- @nomcp hides this handler from the MCP tool surface (tools/list AND
-- tools/call) while keeping it fully served over HTTP, OpenAPI, and the A2A
-- card. Use it for internal/observability endpoints you want reachable by curl
-- but NOT advertised as an agent-callable tool. Unlike @noexpose (which hides
-- from HTTP too), @nomcp is MCP-only and is NOT reset by @route.
@nomcp
@route("GET", "/internal/metrics")
export pure func metrics() -> string {
  "requests=0"
}

-- Demo entrypoint for verify-examples: exercises handleWebhook with a
-- synthetic request so the file both type-checks and runs cleanly.
export func main() -> () ! {IO} {
  let response = match decode("{\"X-Signature\": \"abc123\"}") {
    Ok(headers) => handleWebhook({
      body: "{\"event\": \"test\"}",
      headers: headers,
      method: "POST",
      path: "/webhooks/example"
    }),
    Err(e) => "could not decode headers: ${e}"
  };
  println(response)
}
