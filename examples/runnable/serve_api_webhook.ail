-- serve_api_webhook.ail
-- Demonstrates @raw @route for receiving raw HTTP requests with headers.
-- Use case: webhook handlers that need access to signature headers.
--
-- Run: ailang serve-api examples/runnable/serve_api_webhook.ail
-- Test: curl -X POST http://localhost:8080/webhooks/example \
--         -H "X-Signature: abc123" \
--         -d '{"event": "test"}'

module webhook_example

-- A @raw @route handler receives a single record argument with fields:
--   body: string, headers: {..}, method: string, path: string, query: {..}
-- Headers and query are records with dynamic fields (accessed via dot notation).
@raw
@route("POST", "/webhooks/example")
export func handleWebhook(request: {body: string, method: string, path: string}) -> string ! {IO} {
  let body = request.body
  "received webhook: " ++ request.method ++ " " ++ request.path ++ " body length: " ++ toString(length(body))
}

-- Non-@raw routes continue to work with parsed arguments as before
@route("GET", "/health")
export pure func health() -> string {
  "ok"
}
