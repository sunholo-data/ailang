-- json_parsing.ail - JSON parsing example
-- Demonstrates JSON decode and pattern matching
module examples/runnable/json_parsing

import std/io (println)
import std/json (Json, JNull, JString, JNumber, JObject, JArray, decode, get, asString)
import std/result (Result, Ok, Err)
import std/option (Option, Some, None)

-- Parse JSON and extract values
export func main() -> () ! {IO} {
  let jsonStr = "{\"name\": \"AILANG\", \"version\": 0.6}";

  match decode(jsonStr) {
    Ok(obj) => {
      println("Parsed JSON successfully!");

      -- Extract name field
      match get(obj, "name") {
        Some(nameVal) => match asString(nameVal) {
          Some(name) => println("Name: " ++ name),
          None => println("Name is not a string")
        },
        None => println("Name not found")
      }
    },
    Err(e) => println("Parse error: " ++ e)
  }
}
