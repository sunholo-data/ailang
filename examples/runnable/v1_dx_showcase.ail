-- v1.0.0-rc.1 DX showcase: contracts, an effect budget, the `_` pipe placeholder,
-- std/result.mapResult and inline multi-arg tests in one small program.
-- Run: ailang run --entry main --caps IO examples/runnable/v1_dx_showcase.ail
-- Same program on the bytecode VM: ailang run --strict-bytecode --entry main --caps IO examples/runnable/v1_dx_showcase.ail
-- Effect budget: ailang run --entry budgeted --caps IO examples/runnable/v1_dx_showcase.ail
-- Verify contracts: ailang check --verify examples/runnable/v1_dx_showcase.ail
-- Run inline tests: ailang test examples/runnable/v1_dx_showcase.ail

module examples/runnable/v1_dx_showcase
import std/list (filter, map)
import std/option (Option, Some, None)
import std/result (Result, Ok, Err, mapResult)
import std/string (stringToInt)

-- Contracts: `requires` is the caller's obligation, `ensures` the callee's promise.
-- Inline tests take `(input, expected)` pairs; a multi-arg function takes a tuple of args.
pure func addBounded(a: int, b: int) -> int
  requires { a >= 0 && a <= 1000 && b >= 0 && b <= 1000 }
  ensures { result >= a }
  tests [((1, 2), 3), ((0, 0), 0), ((1000, 1000), 2000)]
{
  a + b
}

pure func clampNonNegative(x: int) -> int
  requires { x >= -1000 && x <= 1000 }
  ensures { result >= 0 }
  tests [(-5, 0), (7, 7), (0, 0)]
{
  if x > 0 then x else 0
}

pure func parseInt(s: string) -> Result[int, string] =
  match stringToInt(s) {
    Some(n) => Ok(n),
    None => Err("not an int: ${s}")
  }

-- `_` marks where the piped value goes in a multi-arg call.
pure func positiveDoubled(xs: [int]) -> [int] =
  xs |> filter(\x. x > 0, _) |> map(\x. x * 2, _)

-- mapResult(f, xs) stops at the first Err and keeps order on success.
pure func parseAll(items: [string]) -> Result[[int], string] = mapResult(parseInt, items)

func report(label: string, r: Result[[int], string]) -> () ! {IO} =
  match r {
    Ok(ns) => println("${label}: ok ${show(ns)}"),
    Err(e) => println("${label}: error ${e}")
  }

export func main() -> () ! {IO} {
  println("addBounded(2, 3) = ${show(addBounded(2, 3))}")
  println("positive doubled = ${show(positiveDoubled([-2, 1, 3, -1, 4]))}")
  report("good", parseAll(["1", "2", "3"]))
  report("bad", parseAll(["1", "x", "3"]))
}

-- The budget allows at most 5 IO operations; main prints exactly 4 lines.
-- Budget frames are enforced by the evaluator (the bytecode VM cannot push one),
-- so this entry is kept separate from main and runs on the default engine.
export func budgeted() -> () ! {IO @limit=5} {
  main()
}
