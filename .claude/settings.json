{
  "env": {
    "OTEL_LOG_USER_PROMPTS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(ailang:*)",
      "Bash(./bin/ailang:*)",
      "Bash(.claude/skills/agent-inbox/scripts/:*)",
      "Bash(.claude/skills/benchmark-manager/scripts/:*)",
      "Bash(.claude/skills/builtin-developer/scripts/:*)",
      "Bash(.claude/skills/cloud-setup/scripts/:*)",
      "Bash(.claude/skills/coordinator-helper/scripts/:*)",
      "Bash(.claude/skills/design-doc-creator/scripts/:*)",
      "Bash(.claude/skills/docs-sync/scripts/:*)",
      "Bash(.claude/skills/eval-analyzer/scripts/:*)",
      "Bash(.claude/skills/github-issue-triage/scripts/:*)",
      "Bash(.claude/skills/headless-runner/scripts/:*)",
      "Bash(.claude/skills/model-manager/scripts/:*)",
      "Bash(.claude/skills/parser-developer/scripts/:*)",
      "Bash(.claude/skills/perf-reviewer/scripts/:*)",
      "Bash(.claude/skills/post-release/scripts/:*)",
      "Bash(.claude/skills/prompt-manager/scripts/:*)",
      "Bash(.claude/skills/release-manager/scripts/:*)",
      "Bash(.claude/skills/sprint-executor/scripts/:*)",
      "Bash(.claude/skills/sprint-planner/scripts/:*)",
      "Bash(.claude/skills/trace-debugger/scripts/:*)",
      "Bash(.claude/skills/use-ailang/scripts/:*)",
      "Skill(design-doc-creator)",
      "Skill(sprint-executor)",
      "Skill(sprint-planner)",
      "Skill(release-manager)",
      "Skill(post-release)",
      "Skill(builtin-developer)",
      "Skill(model-manager)",
      "Skill(prompt-manager)",
      "Skill(use-ailang)",
      "Skill(github-issue-triage)",
      "Skill(eval-analyzer)",
      "Skill(design-spec-auditor)",
      "Skill(skill-builder)",
      "Skill(perf-reviewer)",
      "Skill(trace-debugger)",
      "Bash(.claude/skills/gemini-cli-helper/scripts/:*)",
      "Skill(gemini-cli-helper)",
      "Bash(.claude/skills/eval-gap-finder/scripts/:*)",
      "Skill(eval-gap-finder)",
      "Bash(.claude/skills/cli-doc-maintainer/scripts/:*)",
      "Skill(cli-doc-maintainer)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/session_start.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/cloud_setup.sh"
          },
          {
            "type": "command",
            "command": "~/.ailang/hooks/claude_telemetry.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.ailang/hooks/claude_telemetry.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/agent_handoff.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "~/.ailang/hooks/claude_telemetry.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/format_go.sh"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.ailang/hooks/claude_telemetry.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
