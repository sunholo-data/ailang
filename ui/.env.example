# Firebase Configuration for AILANG Dashboard
# Copy this to .env.local and fill in your values
# Get these from Firebase Console > Project Settings > Your Apps > Web App

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=ailang-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ailang-dev
VITE_FIREBASE_STORAGE_BUCKET=ailang-dev.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# To get these values:
# 1. Go to https://console.firebase.google.com/project/ailang-dev/settings/general
# 2. Scroll down to "Your apps"
# 3. Click "Add app" > Web
# 4. Copy the firebaseConfig values
