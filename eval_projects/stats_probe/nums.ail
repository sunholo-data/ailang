module eval_projects/stats_probe/nums

-- Sum a list of ints via recursion (AILANG has no loops). REFERENCE PATTERN — copy this shape.
export pure func sumList(xs: [int]) -> int =
  match xs {
    [] => 0,
    x :: rest => x + sumList(rest)
  }

