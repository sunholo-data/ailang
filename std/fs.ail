-- std/fs - File system operations (sandboxed)
--
-- Read and write files with capability-based security.
-- Respects AILANG_FS_SANDBOX environment variable for sandboxing.
--
-- Requires: FS capability (--caps FS)

module std/fs

-- Effect marker
-- export effect FS  -- Will be added when effect declarations are supported

-- File reading
-- Reads entire file contents as a string
-- @requires FS capability
-- @sandbox Respects AILANG_FS_SANDBOX
export func readFile(path: string) -> string ! {FS} = _fs_readFile(path)

-- Binary file reading
-- Reads entire file contents as a base64-encoded string
-- Use for PDF, images, or other binary files
-- @requires FS capability
-- @sandbox Respects AILANG_FS_SANDBOX
export func readFileBytes(path: string) -> Result[string, string] ! {FS} = _fs_readFileBytes(path)

-- File writing
-- Writes string content to file (truncates if exists)
-- Creates parent directories if needed (future enhancement)
-- @requires FS capability
-- @sandbox Respects AILANG_FS_SANDBOX
-- @permissions 0644 (owner: rw, group: r, others: r)
export func writeFile(path: string, content: string) -> () ! {FS} = _fs_writeFile(path, content)

-- Binary file writing
-- Writes raw bytes to file (truncates if exists)
-- Use for PCM audio, images, WAV files, or other binary data
-- @requires FS capability
-- @sandbox Respects AILANG_FS_SANDBOX
-- @permissions 0644 (owner: rw, group: r, others: r)
export func writeFileBytes(path: string, data: bytes) -> () ! {FS} = _fs_writeFileBytes(path, data)

-- File append (string)
-- Appends string content to file (creates if not exists)
-- O(1) per call — does not read existing contents
-- @requires FS capability
-- @sandbox Respects AILANG_FS_SANDBOX
-- @permissions 0644 (owner: rw, group: r, others: r)
export func appendFile(path: string, content: string) -> () ! {FS} = _fs_appendFile(path, content)

-- Binary file append
-- Appends raw bytes to file (creates if not exists)
-- O(1) per call — ideal for streaming binary data to disk (e.g., PCM audio frames)
-- @requires FS capability
-- @sandbox Respects AILANG_FS_SANDBOX
-- @permissions 0644 (owner: rw, group: r, others: r)
export func appendFileBytes(path: string, data: bytes) -> () ! {FS} = _fs_appendFileBytes(path, data)

-- File existence check
-- Returns true if file or directory exists
-- @requires FS capability
-- @sandbox Respects AILANG_FS_SANDBOX
export func fileExists(path: string) -> bool ! {FS} = _fs_exists(path)

-- M-DOCPARSE-DX M3: Directory listing
-- Returns sorted list of entry names (files and directories)
-- @requires FS capability
-- @sandbox Respects AILANG_FS_SANDBOX
export func listDir(path: string) -> [string] ! {FS} = _fs_listDir(path)

-- Create a single directory (parent must exist)
-- @requires FS capability
-- @sandbox Respects AILANG_FS_SANDBOX
-- @permissions 0755 (owner: rwx, group: rx, others: rx)
export func mkdir(path: string) -> () ! {FS} = _fs_mkdir(path)

-- Create a directory and all parent directories (mkdir -p)
-- No error if directory already exists
-- @requires FS capability
-- @sandbox Respects AILANG_FS_SANDBOX
-- @permissions 0755 (owner: rwx, group: rx, others: rx)
export func mkdirAll(path: string) -> () ! {FS} = _fs_mkdirAll(path)

-- Check if path is a directory
-- Returns false for non-existent paths (no error)
-- @requires FS capability
-- @sandbox Respects AILANG_FS_SANDBOX
export func isDir(path: string) -> bool ! {FS} = _fs_isDir(path)

-- Check if path is a regular file
-- Returns false for non-existent paths, directories, symlinks (no error)
-- @requires FS capability
-- @sandbox Respects AILANG_FS_SANDBOX
export func isFile(path: string) -> bool ! {FS} = _fs_isFile(path)

-- Remove a file or empty directory
-- Fails if directory is not empty
-- @requires FS capability
-- @sandbox Respects AILANG_FS_SANDBOX
export func removeFile(path: string) -> () ! {FS} = _fs_removeFile(path)

-- ============================================================================
-- Result-returning variants (M-AILANG-FS-RESULT, since v0.16.0)
-- ============================================================================
-- These wrap fs syscall failures as Err(string) instead of escaping as a
-- runtime panic. Use these in agent runtimes or anywhere a fs operation may
-- fail in user-supplied paths and the caller wants to recover gracefully.

-- Read file contents as a UTF-8 string, returning Result instead of panicking
-- @example match readFileResult("config.yaml") { Ok(c) => c, Err(_) => "" }
-- @requires FS capability
-- @sandbox Respects AILANG_FS_SANDBOX
export func readFileResult(path: string) -> Result[string, string] ! {FS} = _fs_readFileResult(path)

-- Write string content to a file, returning Result instead of panicking
-- @example match writeFileResult("out.txt", "hi") { Ok(_) => true, Err(_) => false }
-- @requires FS capability
-- @sandbox Respects AILANG_FS_SANDBOX
export func writeFileResult(path: string, content: string) -> Result[(), string] ! {FS} = _fs_writeFileResult(path, content)

-- Append string content to a file, returning Result instead of panicking
-- @example match appendFileResult("log.txt", "entry\n") { Ok(_) => true, Err(_) => false }
-- @requires FS capability
-- @sandbox Respects AILANG_FS_SANDBOX
export func appendFileResult(path: string, content: string) -> Result[(), string] ! {FS} = _fs_appendFileResult(path, content)

-- Remove a file, returning Result instead of panicking
-- @example match removeFileResult("/tmp/old.txt") { Ok(_) => true, Err(_) => false }
-- @requires FS capability
-- @sandbox Respects AILANG_FS_SANDBOX
export func removeFileResult(path: string) -> Result[(), string] ! {FS} = _fs_removeFileResult(path)

-- Create directory and all parent directories, returning Result instead of panicking
-- @example match mkdirAllResult("a/b/c") { Ok(_) => true, Err(_) => false }
-- @requires FS capability
-- @sandbox Respects AILANG_FS_SANDBOX
export func mkdirAllResult(path: string) -> Result[(), string] ! {FS} = _fs_mkdirAllResult(path)
