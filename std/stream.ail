-- std/stream.ail
-- Streaming primitives: WebSocket (bidirectional) and SSE (read-only)
-- Provides typed connections with event-driven dispatch.
--
-- Usage:
--   import std/stream (connect, transmit, onEvent, runEventLoop, disconnect)
--   import std/stream (transmitBinary)                         -- binary data (bytes)
--   import std/stream (sseConnect, ssePost, withSSE)           -- SSE connections
--   import std/stream (StreamEvent, Message, Closed, StreamError, SSEData)
--
-- SSE event handling:
--   onEvent(conn, \event. match event {
--     SSEData(eventType, data) => { handleChunk(eventType, data); true },
--     StreamError(err) => { handleError(err); false },
--     Closed(code, reason) => false,
--     _ => true
--   })
--
-- Requires: --caps Stream

module std/stream

import std/result (Result, Ok, Err)

-- ============================================================================
-- Stream Types
-- ============================================================================

-- Connection handle (opaque, holds integer ID)
export type StreamConn = StreamConn(int)

-- Stream event union — received by event handlers
export type StreamEvent =
  | Message(string)
  | Binary(string)
  | Opened(string)
  | Closed(int, string)
  | StreamError(StreamErrorKind)
  | Ping(string)
  | SSEData(string, string)

-- Stream error variants
export type StreamErrorKind =
  | ConnectionFailed(string)
  | Timeout(string)
  | BudgetExhausted(string)
  | ProtocolError(string)
  | MessageTooLarge(string)

-- Message type for transmit
export type StreamMessage = Text(string) | Bin(string)

-- Connection status
export type StreamStatus = Connecting | Open | Closing | StreamClosed

-- Header entry for connection config
export type StreamHeader = { name: string, value: string }

-- Configuration for stream connections
export type StreamConfig = { headers: [StreamHeader] }

-- ============================================================================
-- Stream Effect Wrappers
-- ============================================================================

-- Open a WebSocket connection
-- url: WebSocket URL (wss:// or ws:// with AllowHTTP)
-- config: record with headers list, e.g. {headers: [{name: "Authorization", value: "Bearer TOKEN"}]}
-- Returns Ok(StreamConn(id)) or Err(StreamErrorKind)
export func connect(url: string, config: {headers: [{name: string, value: string}]}) -> Result[StreamConn, StreamErrorKind] ! {Stream} {
  _stream_connect(url, config)
}

-- Send a text message on a connection
-- conn: StreamConn handle (unwrap from connect result first)
-- msg: plain string (auto-wrapped as Text in Go runtime)
export func transmit(conn: StreamConn, msg: string) -> Result[unit, StreamErrorKind] ! {Stream} {
  _stream_send(conn, msg)
}

-- Send binary data (bytes) on a WebSocket connection
-- Use for PCM audio, images, or binary protocols without base64 encoding overhead.
-- conn: StreamConn handle
-- data: bytes to send as WebSocket binary frame
export func transmitBinary(conn: StreamConn, data: bytes) -> Result[unit, StreamErrorKind] ! {Stream} {
  _stream_transmit_binary(conn, data)
}

-- Register an event handler callback
-- conn: StreamConn handle (unwrap from connect result first)
-- handler: function receiving StreamEvent, returning bool (true=continue, false=stop)
export func onEvent(conn: StreamConn, handler: (StreamEvent) -> bool) -> unit ! {Stream} {
  _stream_onEvent(conn, handler)
}

-- Run the event loop (blocks until handler returns false or timeout)
-- conn: StreamConn handle (unwrap from connect result first)
export func runEventLoop(conn: StreamConn) -> unit ! {Stream} {
  _stream_runEventLoop(conn)
}

-- Close a connection gracefully (idempotent)
-- conn: StreamConn handle (unwrap from connect result first)
export func disconnect(conn: StreamConn) -> unit ! {Stream} {
  _stream_close(conn)
}

-- Get connection status
-- Returns Connecting, Open, Closing, or StreamClosed
export func status(conn: StreamConn) -> StreamStatus ! {Stream} {
  _stream_status(conn)
}

-- ============================================================================
-- Convenience Helpers
-- ============================================================================

-- Create a default empty config (no custom headers).
-- For custom headers: {headers: [{name: "Authorization", value: "Bearer TOKEN"}]}
export pure func defaultConfig(u: unit) -> {headers: [{name: string, value: string}]} {
  {headers: []}
}

-- High-level lifecycle helper: connect, register handler, run event loop, disconnect.
-- Manages the full WebSocket lifecycle in one call.
-- url: WebSocket URL
-- handler: event handler function receiving StreamEvent, returning bool (true=continue, false=stop)
-- Returns Ok(StreamConn) on success or Err(StreamErrorKind) on connection failure
export func withStream(url: string, handler: (StreamEvent) -> bool) -> Result[StreamConn, StreamErrorKind] ! {Stream} {
  let result = connect(url, {headers: []});
  match result {
    Ok(conn) => {
      onEvent(conn, handler);
      runEventLoop(conn);
      disconnect(conn);
      Ok(conn)
    },
    Err(e) => Err(e)
  }
}

-- ============================================================================
-- SSE (Server-Sent Events)
-- ============================================================================

-- Open an SSE connection via HTTP GET (read-only HTTP streaming)
-- Used for consuming streaming APIs that use GET+SSE
-- url: HTTPS endpoint URL
-- config: record with headers list
-- Returns Ok(StreamConn(id)) or Err(StreamErrorKind)
-- Events are delivered as SSEData(eventType, data) to the handler
export func sseConnect(url: string, config: {headers: [{name: string, value: string}]}) -> Result[StreamConn, StreamErrorKind] ! {Stream} {
  _stream_sse_connect(url, config)
}

-- Open an SSE connection via HTTP POST (for AI API streaming)
-- Claude, OpenAI, and Gemini all use POST+SSE: the request body contains the
-- prompt/config and the response is streamed back as Server-Sent Events.
-- url: HTTPS endpoint URL
-- body: request body (typically JSON)
-- config: record with headers list (e.g. Authorization: Bearer)
-- Content-Type defaults to application/json.
-- Returns Ok(StreamConn(id)) or Err(StreamErrorKind)
export func ssePost(url: string, body: string, config: {headers: [{name: string, value: string}]}) -> Result[StreamConn, StreamErrorKind] ! {Stream} {
  _stream_sse_post(url, body, config)
}

-- High-level SSE lifecycle: connect, register handler, run event loop, disconnect.
-- url: SSE endpoint URL
-- handler: event handler function receiving StreamEvent, returning bool (true=continue, false=stop)
-- Returns Ok(StreamConn) on success or Err(StreamErrorKind) on connection failure
-- Events are delivered as SSEData(eventType, data) to the handler.
export func withSSE(url: string, handler: (StreamEvent) -> bool) -> Result[StreamConn, StreamErrorKind] ! {Stream} {
  let result = sseConnect(url, {headers: []});
  match result {
    Ok(conn) => {
      onEvent(conn, handler);
      runEventLoop(conn);
      disconnect(conn);
      Ok(conn)
    },
    Err(e) => Err(e)
  }
}
