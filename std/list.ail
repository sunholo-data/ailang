-- std/list - Linked list operations
--
-- Functional list operations: map, filter, fold, etc.
-- Lists are immutable linked lists with O(1) prepend, O(n) append.
--
-- Pure functions (no effects required)

module std/list
import std/option (Option, Some, None)

export pure func length[a](xs: [a]) -> int {
  match xs {
    [] => 0,
    [_, ...rest] => 1 + length(rest)
  }
}

export pure func head[a](xs: [a]) -> Option[a] {
  match xs {
    [] => None,
    [x, ..._] => Some(x)
  }
}

export pure func tail[a](xs: [a]) -> [a] {
  match xs {
    [] => [],
    [_, ...rest] => rest
  }
}

export pure func reverse[a](xs: [a]) -> [a] {
  -- Simple recursive reverse (not tail-recursive)
  match xs {
    [] => [],
    [x, ...rest] => concat(reverse(rest), [x])
  }
}

export pure func concat[a](xs: [a], ys: [a]) -> [a] {
  match xs {
    [] => ys,
    [x, ...rest] => [x] ++ concat(rest, ys)
  }
}

export pure func zip[a, b](xs: [a], ys: [b]) -> [(a, b)] {
  match xs {
    [] => [],
    [xh, ...xr] => match ys {
      [] => [],
      [yh, ...yr] => [(xh, yh)] ++ zip(xr, yr)
    }
  }
}

-- Apply a function to each element, returning a new list.
export pure func map[a, b](f: (a) -> b, xs: [a]) -> [b] {
  match xs { [] => [], [x, ...rest] => [f(x)] ++ map(f, rest) }
}

export pure func filter[a](p: (a) -> bool, xs: [a]) -> [a] {
  match xs {
    [] => [],
    [x, ...rest] => if p(x) then [x] ++ filter(p, rest) else filter(p, rest)
  }
}

export pure func foldl[a, b](f: (b, a) -> b, acc: b, xs: [a]) -> b {
  match xs { [] => acc, [x, ...rest] => foldl(f, f(acc, x), rest) }
}

export pure func foldr[a, b](f: (a, b) -> b, acc: b, xs: [a]) -> b {
  match xs { [] => acc, [x, ...rest] => f(x, foldr(f, acc, rest)) }
}

-- ============================================================================
-- Sorting (v0.6.3) - Merge sort with custom comparator
-- ============================================================================

-- sortBy: Sort list using a comparison function
-- cmp(a, b) should return: negative if a < b, 0 if equal, positive if a > b
export pure func sortBy[a](cmp: (a, a) -> int, xs: [a]) -> [a] {
  match xs {
    [] => [],
    [x] => [x],
    _ => {
      let mid = length(xs) / 2;
      let left = take(mid, xs);
      let right = drop(mid, xs);
      mergeBy(cmp, sortBy(cmp, left), sortBy(cmp, right))
    }
  }
}

-- mergeBy: Merge two sorted lists using comparison function
pure func mergeBy[a](cmp: (a, a) -> int, xs: [a], ys: [a]) -> [a] {
  match xs {
    [] => ys,
    [x, ...xr] => match ys {
      [] => xs,
      [y, ...yr] => if cmp(x, y) <= 0
        then [x] ++ mergeBy(cmp, xr, ys)
        else [y] ++ mergeBy(cmp, xs, yr)
    }
  }
}

-- take: Take first n elements
export pure func take[a](n: int, xs: [a]) -> [a] {
  if n <= 0 then []
  else match xs {
    [] => [],
    [x, ...rest] => [x] ++ take(n - 1, rest)
  }
}

-- drop: Drop first n elements
export pure func drop[a](n: int, xs: [a]) -> [a] {
  if n <= 0 then xs
  else match xs {
    [] => [],
    [_, ...rest] => drop(n - 1, rest)
  }
}

-- ============================================================================
-- Index Access (v0.6.5) - Element access by index
-- ============================================================================

-- nth: Get element at index (0-based). Returns None for negative or out-of-bounds.
export pure func nth[a](xs: [a], idx: int) -> Option[a] {
  if idx < 0 then None
  else match xs {
    [] => None,
    [x, ...rest] => if idx == 0 then Some(x) else nth(rest, idx - 1)
  }
}

-- last: Get last element of list
export pure func last[a](xs: [a]) -> Option[a] {
  match xs {
    [] => None,
    [x] => Some(x),
    [_, ...rest] => last(rest)
  }
}

-- ============================================================================
-- Predicates (v0.6.5) - Element searching
-- ============================================================================

-- any: Check if any element satisfies predicate (short-circuits on first match)
-- Note: 'exists' is a reserved keyword in AILANG, so we use 'any' instead
export pure func any[a](p: (a) -> bool, xs: [a]) -> bool {
  match xs {
    [] => false,
    [x, ...rest] => if p(x) then true else any(p, rest)
  }
}

-- findIndex: Find index of first element matching predicate
export pure func findIndex[a](p: (a) -> bool, xs: [a]) -> Option[int] {
  findIndexHelper(p, xs, 0)
}

-- Helper for findIndex with accumulator
pure func findIndexHelper[a](p: (a) -> bool, xs: [a], idx: int) -> Option[int] {
  match xs {
    [] => None,
    [x, ...rest] => if p(x) then Some(idx) else findIndexHelper(p, rest, idx + 1)
  }
}

-- ============================================================================
-- Extremes (v0.6.4) - Find minimum/maximum elements
-- ============================================================================
-- Monomorphic versions for int, float, string.
-- Returns Option to handle empty lists safely (unlike Haskell's partial maximum).

-- maximumInt: Find largest int in list
export pure func maximumInt(xs: [int]) -> Option[int] {
  match xs {
    [] => None,
    [x] => Some(x),
    [x, ...rest] => match maximumInt(rest) {
      None => Some(x),
      Some(m) => if x > m then Some(x) else Some(m)
    }
  }
}

-- minimumInt: Find smallest int in list
export pure func minimumInt(xs: [int]) -> Option[int] {
  match xs {
    [] => None,
    [x] => Some(x),
    [x, ...rest] => match minimumInt(rest) {
      None => Some(x),
      Some(m) => if x < m then Some(x) else Some(m)
    }
  }
}

-- maximumFloat: Find largest float in list
export pure func maximumFloat(xs: [float]) -> Option[float] {
  match xs {
    [] => None,
    [x] => Some(x),
    [x, ...rest] => match maximumFloat(rest) {
      None => Some(x),
      Some(m) => if x > m then Some(x) else Some(m)
    }
  }
}

-- minimumFloat: Find smallest float in list
export pure func minimumFloat(xs: [float]) -> Option[float] {
  match xs {
    [] => None,
    [x] => Some(x),
    [x, ...rest] => match minimumFloat(rest) {
      None => Some(x),
      Some(m) => if x < m then Some(x) else Some(m)
    }
  }
}

-- maximumString: Find lexicographically largest string in list
export pure func maximumString(xs: [string]) -> Option[string] {
  match xs {
    [] => None,
    [x] => Some(x),
    [x, ...rest] => match maximumString(rest) {
      None => Some(x),
      Some(m) => if x > m then Some(x) else Some(m)
    }
  }
}

-- minimumString: Find lexicographically smallest string in list
export pure func minimumString(xs: [string]) -> Option[string] {
  match xs {
    [] => None,
    [x] => Some(x),
    [x, ...rest] => match minimumString(rest) {
      None => Some(x),
      Some(m) => if x < m then Some(x) else Some(m)
    }
  }
}
