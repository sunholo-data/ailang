-- std/list - Linked list operations
--
-- Functional list operations: map, filter, fold, etc.
-- Lists are immutable linked lists with O(1) prepend, O(n) append.
--
-- Pure functions (no effects required)

module std/list
import std/option (Option, Some, None)

export pure func length[a](xs: [a]) -> int {
  match xs {
    [] => 0,
    [_, ...rest] => 1 + length(rest)
  }
}

export pure func head[a](xs: [a]) -> Option[a] {
  match xs {
    [] => None,
    [x, ..._] => Some(x)
  }
}

export pure func tail[a](xs: [a]) -> [a] {
  match xs {
    [] => [],
    [_, ...rest] => rest
  }
}

export pure func reverse[a](xs: [a]) -> [a] {
  -- Simple recursive reverse (not tail-recursive)
  match xs {
    [] => [],
    [x, ...rest] => concat(reverse(rest), [x])
  }
}

export pure func concat[a](xs: [a], ys: [a]) -> [a] {
  match xs {
    [] => ys,
    [x, ...rest] => [x] ++ concat(rest, ys)
  }
}

export pure func zip[a, b](xs: [a], ys: [b]) -> [(a, b)] {
  match xs {
    [] => [],
    [xh, ...xr] => match ys {
      [] => [],
      [yh, ...yr] => [(xh, yh)] ++ zip(xr, yr)
    }
  }
}

-- Optional: include these now if your polymorphism is happy.
export pure func map[a, b](f: (a) -> b, xs: [a]) -> [b] {
  match xs { [] => [], [x, ...rest] => [f(x)] ++ map(f, rest) }
}

export pure func filter[a](p: (a) -> bool, xs: [a]) -> [a] {
  match xs {
    [] => [],
    [x, ...rest] => if p(x) then [x] ++ filter(p, rest) else filter(p, rest)
  }
}

export pure func foldl[a, b](f: (b, a) -> b, acc: b, xs: [a]) -> b {
  match xs { [] => acc, [x, ...rest] => foldl(f, f(acc, x), rest) }
}

export pure func foldr[a, b](f: (a, b) -> b, acc: b, xs: [a]) -> b {
  match xs { [] => acc, [x, ...rest] => f(x, foldr(f, acc, rest)) }
}

-- ============================================================================
-- Sorting (v0.6.3) - Merge sort with custom comparator
-- ============================================================================

-- sortBy: Sort list using a comparison function
-- cmp(a, b) should return: negative if a < b, 0 if equal, positive if a > b
export pure func sortBy[a](cmp: (a, a) -> int, xs: [a]) -> [a] {
  match xs {
    [] => [],
    [x] => [x],
    _ => {
      let mid = length(xs) / 2;
      let left = take(mid, xs);
      let right = drop(mid, xs);
      mergeBy(cmp, sortBy(cmp, left), sortBy(cmp, right))
    }
  }
}

-- mergeBy: Merge two sorted lists using comparison function
pure func mergeBy[a](cmp: (a, a) -> int, xs: [a], ys: [a]) -> [a] {
  match xs {
    [] => ys,
    [x, ...xr] => match ys {
      [] => xs,
      [y, ...yr] => if cmp(x, y) <= 0
        then [x] ++ mergeBy(cmp, xr, ys)
        else [y] ++ mergeBy(cmp, xs, yr)
    }
  }
}

-- take: Take first n elements
export pure func take[a](n: int, xs: [a]) -> [a] {
  if n <= 0 then []
  else match xs {
    [] => [],
    [x, ...rest] => [x] ++ take(n - 1, rest)
  }
}

-- drop: Drop first n elements
export pure func drop[a](n: int, xs: [a]) -> [a] {
  if n <= 0 then xs
  else match xs {
    [] => [],
    [_, ...rest] => drop(n - 1, rest)
  }
}
