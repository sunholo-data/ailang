-- std/list - Linked list operations
--
-- Functional list operations: map, filter, fold, etc.
-- Lists are immutable and backed by a flat array: indexing is O(1), and BOTH
-- `x :: xs` and `xs ++ ys` copy the whole list. So ANY shape that grows a list
-- one element at a time is O(n^2) in time: hand-written recursion,
-- prepend-then-reverse, and a foldl whose step conses onto a list accumulator.
-- foldl is O(n) only if the step is O(1); a step that conses onto (or
-- concatenates to) a list accumulator is O(n) per element, making the fold O(n^2).
-- Build lists in one pass instead:
--   map / filter / flatMap / zip / take   one element (or none) per input
--   mapAccumL                             one output per input, plus running state
--   foldl with a non-list accumulator     sums, counts, records, maps: always fine
-- Matching `[x, ...rest]` also copies `rest` on the bytecode VM, so recursion that
-- walks a list that way is O(n^2) there; index with nth or use a helper below.
-- Every pure helper below is an iterative builtin or built from one: O(n) time,
-- no recursion-depth limit.
--
-- Pure functions (no effects required)

module std/list
import std/option (Option, Some, None)

export pure func length[a](xs: [a]) -> int {
  _list_length(xs)
}

export pure func head[a](xs: [a]) -> Option[a] {
  match xs {
    [] => None,
    [x, ..._] => Some(x)
  }
}

export pure func tail[a](xs: [a]) -> [a] {
  match xs {
    [] => [],
    [_, ...rest] => rest
  }
}

-- M-ITERATIVE-LIST: Delegates to the Go-level iterative builtin; O(n) time, O(1) stack.
-- The previous recursive `concat(reverse(rest), [x])` form was O(n^2) and depth-capped at 10,000.
export pure func reverse[a](xs: [a]) -> [a] = _list_reverse(xs)

-- Appends ys to xs by copying: O(len(xs) + len(ys)) per call. In a loop, `concat(acc, [x])`
-- is O(n^2) in time AND memory (measured: 5,000 records = 78 s / 1.7 GB). Prepend-then-reverse
-- (0.36 s / 294 MB on the same 5,000) is cheaper per step but STILL O(n^2): it takes about 4x
-- as long each time n doubles (160,000 elements: 9.6 s interpreter, 23.4 s VM). Build with
-- map/filter/flatMap, or mapAccumL when each output depends on running state.
export pure func concat[a](xs: [a], ys: [a]) -> [a] = xs ++ ys

-- Truncates to the shorter list. Delegates to the iterative _list_zip builtin (#1318).
export pure func zip[a, b](xs: [a], ys: [b]) -> [(a, b)] = _list_zip(xs, ys)

-- Apply a function to each element, returning a new list.
-- M-ITERATIVE-LIST: Delegates to Go-level iterative builtin for O(1) stack usage.
export pure func map[a, b](f: a -> b, xs: [a]) -> [b] = _list_map(f, xs)

export pure func filter[a](p: a -> bool, xs: [a]) -> [a] = _list_filter(p, xs)

-- Left fold. O(n) only if the step is O(1): a step that conses onto (or concatenates to)
-- a list accumulator is O(n) per element, making the fold O(n^2). Use mapAccumL to build a list.
export pure func foldl[a, b](f: (b, a) -> b, acc: b, xs: [a]) -> b = _list_foldl(f, acc, xs)

-- Right fold: foldr(f, acc, [x0, x1]) = f(x0, f(x1, acc)). Iterative builtin (right to
-- left): O(n) time, no recursion-depth limit.
export pure func foldr[a, b](f: (a, b) -> b, acc: b, xs: [a]) -> b = _list_foldr(f, acc, xs)

-- mapAccumL: stateful map in one left-to-right pass, O(n) for an O(1) step.
-- f(state, element) returns (output, newState); the result is (outputs, finalState)
-- and the outputs list is built in ONE allocation, with no per-step copy. This is the
-- linear replacement for a foldl that conses onto a list inside its accumulator.
-- mapAccumL(\st x. (st + x, st + x), 0, [1, 2, 3]) == ([1, 3, 6], 6)
-- mapAccumL(f, s, []) == ([], s)
export pure func mapAccumL[a, b, s](f: (s, a) -> (b, s), s0: s, xs: [a]) -> ([b], s) = _list_mapAccumL(f, s0, xs)

-- ============================================================================
-- Sorting (v0.6.3) - stable sort with custom comparator
-- ============================================================================

-- sortBy: Sort list using a comparison function
-- cmp(a, b) should return: negative if a < b, 0 if equal, positive if a > b
-- Stable: elements that compare equal keep their input order. Delegates to the
-- iterative _list_sortBy builtin (#1318) — the old merge sort recursed once per
-- element and copied on every `++` (84k strings: 99.7 GB, 36 s).
export pure func sortBy[a](cmp: (a, a) -> int, xs: [a]) -> [a] = _list_sortBy(cmp, xs)

-- take: Take first n elements
export pure func take[a](n: int, xs: [a]) -> [a] = _list_take(n, xs)

-- range: the integers from start (inclusive) to end (exclusive).
-- range(0, 3) = [0, 1, 2]; empty when end <= start. One allocation, no recursion:
-- use it as the source list for map/filter/foldl instead of hand-rolled recursion.
export pure func range(start: int, end: int) -> [int] = _list_range(start, end)

-- drop: Drop first n elements
-- Delegates to the iterative builtin to avoid recursion-depth failures on large n.
export pure func drop[a](n: int, xs: [a]) -> [a] = _list_drop(n, xs)

-- contains: Is x an element of xs?
-- Delegates to the _list_contains builtin, which the contract verifier encodes
-- as SMT sequence membership — so `ensures { contains(allowed, result) }`
-- verifies, where a hand-written recursive membership is skipped as
-- "not SMT-encodable". The builtin existed since v0.5.x; this export did not.
export pure func contains[a](xs: [a], x: a) -> bool = _list_contains(xs, x)

-- ============================================================================
-- Index Access (v0.6.5) - Element access by index
-- ============================================================================

-- nth: Get element at index (0-based). Returns None for negative or out-of-bounds.
-- Uses O(1) builtin for direct index access instead of O(n) recursive traversal.
export pure func nth[a](xs: [a], idx: int) -> Option[a] {
  if idx < 0 then None else if idx >= _list_length(xs) then None else Some(_list_nth(xs, idx))
}

-- last: Get last element of list
-- Uses O(1) builtin for direct index access instead of O(n) recursive traversal.
export pure func last[a](xs: [a]) -> Option[a] {
  let len = _list_length(xs)
  if len == 0 then None else Some(_list_nth(xs, len - 1))
}

-- nth_or: Element at index, or a default if negative/out-of-bounds.
-- Removes the Some/None unwrap boilerplate at every indexing call site while
-- keeping the safety of nth (never crashes on a bad index).
-- Example: nth_or([10, 20, 30], 1, 0) == 20 ; nth_or([10], 5, 0) == 0
export pure func nth_or[a](xs: [a], idx: int, default: a) -> a {
  match nth(xs, idx) {
    Some(v) => v,
    None => default
  }
}

-- head_or: First element, or a default if the list is empty.
-- Example: head_or([1, 2], 0) == 1 ; head_or([], 0) == 0
export pure func head_or[a](xs: [a], default: a) -> a = nth_or(xs, 0, default)

-- last_or: Last element, or a default if the list is empty.
-- Example: last_or([1, 2, 3], 0) == 3 ; last_or([], 0) == 0
export pure func last_or[a](xs: [a], default: a) -> a {
  match last(xs) {
    Some(v) => v,
    None => default
  }
}

-- ============================================================================
-- Predicates (v0.6.5) - Element searching
-- ============================================================================

-- any: Check if any element satisfies predicate (short-circuits on first match:
-- p is not called on later elements). Iterative builtin: O(n), no depth limit (#1518).
-- Note: 'exists' is a reserved keyword in AILANG, so we use 'any' instead
export pure func any[a](p: a -> bool, xs: [a]) -> bool = _list_any(p, xs)

-- findIndex: Find index of first element matching predicate (short-circuits like any).
-- Iterative builtin: O(n), no depth limit (#1518).
export pure func findIndex[a](p: a -> bool, xs: [a]) -> Option[int] = _list_findIndex(p, xs)

-- ============================================================================
-- Zip Combinators (v0.8.1) - Combine lists element-wise
-- ============================================================================

-- zipWith: Combine two lists element-wise with a function
-- zipWith(\a b. a + b, [1,2,3], [10,20,30]) => [11, 22, 33]
-- Stops at the shorter list (same as zip).
export pure func zipWith[a, b, c](f: (a, b) -> c, xs: [a], ys: [b]) -> [c] {
  map(\pair. match pair {
    (x, y) => f(x, y)
  }, zip(xs, ys))
}

-- ============================================================================
-- Pure flatMap (v0.7.3) - Map then flatten
-- ============================================================================

-- flatMap: Apply function returning list to each element, flatten results
export pure func flatMap[a, b](f: a -> [b], xs: [a]) -> [b] = _list_flatMap(f, xs)

-- Fused take + flatMap: retains at most n outputs and stops invoking f once
-- they exist. It bounds f invocation to the needed input prefix, but does NOT
-- bound peak memory by n:
--   peak = source residency + largest single f(x) + n retained
-- If one f(x) can itself be large, bound it inside f.
export pure func takeFlatMap[a, b](n: int, f: a -> [b], xs: [a]) -> [b] = _list_takeFlatMap(n, f, xs)

-- Fused take + map: retains at most n outputs and invokes f on at most n
-- inputs. It does NOT bound peak memory by n:
--   peak = source residency + largest single f(x) + n retained
-- If one f(x) can itself be large, bound it inside f.
export pure func takeMap[a, b](n: int, f: a -> b, xs: [a]) -> [b] = _list_takeMap(n, f, xs)

-- ============================================================================
-- Effectful Combinators (v0.7.3) - map/filter/fold with effects
-- ============================================================================
-- All effectful combinators evaluate elements left-to-right, sequentially, once each.
-- No recursion-depth limit on either engine: foldlE/forEachE are index-walking tail
-- loops (O(n)); mapE/filterE/flatMapE split the index range in halves, so their
-- recursion is O(log n) deep and they copy O(n log n) elements in total.
-- (A builtin cannot take an effectful callback yet, so these stay in AILANG.)

-- mapE: Apply an effectful function to each element (left-to-right)
export func mapE[a, b, e](f: a -> b ! {e}, xs: [a]) -> [b] ! {e} = mapERange(f, xs, 0, _list_length(xs))

-- mapE over xs[lo..hi): the left half runs (and its effects happen) before the right half.
func mapERange[a, b, e](f: a -> b ! {e}, xs: [a], lo: int, hi: int) -> [b] ! {e} {
  if hi <= lo then []
  else if hi - lo == 1 then [f(_list_nth(xs, lo))]
  else {
    let mid = lo + (hi - lo) / 2;
    let left = mapERange(f, xs, lo, mid);
    let right = mapERange(f, xs, mid, hi);
    left ++ right
  }
}

-- filterE: Effectful predicate per element (left-to-right)
export func filterE[a, e](p: a -> bool ! {e}, xs: [a]) -> [a] ! {e} = filterERange(p, xs, 0, _list_length(xs))

func filterERange[a, e](p: a -> bool ! {e}, xs: [a], lo: int, hi: int) -> [a] ! {e} {
  if hi <= lo then []
  else if hi - lo == 1 then {
    let x = _list_nth(xs, lo);
    if p(x) then [x] else []
  }
  else {
    let mid = lo + (hi - lo) / 2;
    let left = filterERange(p, xs, lo, mid);
    let right = filterERange(p, xs, mid, hi);
    left ++ right
  }
}

-- foldlE: Effectful left fold (left-to-right)
export func foldlE[a, b, e](f: (b, a) -> b ! {e}, acc: b, xs: [a]) -> b ! {e} = foldlEFrom(f, acc, xs, 0, _list_length(xs))

func foldlEFrom[a, b, e](f: (b, a) -> b ! {e}, acc: b, xs: [a], i: int, n: int) -> b ! {e} {
  if i >= n then acc
  else {
    let newAcc = f(acc, _list_nth(xs, i));
    foldlEFrom(f, newAcc, xs, i + 1, n)
  }
}

-- flatMapE: Effectful flatMap (map then flatten, left-to-right)
export func flatMapE[a, b, e](f: a -> [b] ! {e}, xs: [a]) -> [b] ! {e} = flatMapERange(f, xs, 0, _list_length(xs))

func flatMapERange[a, b, e](f: a -> [b] ! {e}, xs: [a], lo: int, hi: int) -> [b] ! {e} {
  if hi <= lo then []
  else if hi - lo == 1 then f(_list_nth(xs, lo))
  else {
    let mid = lo + (hi - lo) / 2;
    let left = flatMapERange(f, xs, lo, mid);
    let right = flatMapERange(f, xs, mid, hi);
    left ++ right
  }
}

-- forEachE: Execute effect per element, discard results (left-to-right)
export func forEachE[a, e](f: a -> () ! {e}, xs: [a]) -> () ! {e} = forEachEFrom(f, xs, 0, _list_length(xs))

func forEachEFrom[a, e](f: a -> () ! {e}, xs: [a], i: int, n: int) -> () ! {e} {
  if i >= n then ()
  else {
    f(_list_nth(xs, i));
    forEachEFrom(f, xs, i + 1, n)
  }
}

-- ============================================================================
-- Extremes (v0.6.4) - Find minimum/maximum elements
-- ============================================================================
-- Monomorphic versions for int, float, string.
-- Returns Option to handle empty lists safely (unlike Haskell's partial maximum).
-- Each is a right fold seeded with the last element, comparing `x > m` (or `<`):
-- iterative, O(n), no depth limit. It makes the same comparisons in the same order
-- as the earlier recursive definitions, so ties and float NaN resolve exactly as before
-- (a tie keeps the later element; NaN follows whatever `>`/`<` return for it).

-- maximumInt: Find largest int in list
export pure func maximumInt(xs: [int]) -> Option[int] {
  let n = _list_length(xs)
  if n == 0 then None else Some(foldr(\x m. if x > m then x else m, _list_nth(xs, n - 1), xs))
}

-- minimumInt: Find smallest int in list
export pure func minimumInt(xs: [int]) -> Option[int] {
  let n = _list_length(xs)
  if n == 0 then None else Some(foldr(\x m. if x < m then x else m, _list_nth(xs, n - 1), xs))
}

-- maximumFloat: Find largest float in list
export pure func maximumFloat(xs: [float]) -> Option[float] {
  let n = _list_length(xs)
  if n == 0 then None else Some(foldr(\x m. if x > m then x else m, _list_nth(xs, n - 1), xs))
}

-- minimumFloat: Find smallest float in list
export pure func minimumFloat(xs: [float]) -> Option[float] {
  let n = _list_length(xs)
  if n == 0 then None else Some(foldr(\x m. if x < m then x else m, _list_nth(xs, n - 1), xs))
}

-- maximumString: Find lexicographically largest string in list
export pure func maximumString(xs: [string]) -> Option[string] {
  let n = _list_length(xs)
  if n == 0 then None else Some(foldr(\x m. if x > m then x else m, _list_nth(xs, n - 1), xs))
}

-- minimumString: Find lexicographically smallest string in list
export pure func minimumString(xs: [string]) -> Option[string] {
  let n = _list_length(xs)
  if n == 0 then None else Some(foldr(\x m. if x < m then x else m, _list_nth(xs, n - 1), xs))
}

-- M-DOCPARSE-DX M2: Set operations

-- member: Check if element is in list (argument order flipped vs contains).
-- NOT SMT-encodable: in an ensures clause use contains(xs, x) instead.
export pure func member[a](elem: a, xs: [a]) -> bool = _list_member(elem, xs)

-- dedup: Remove duplicates, preserving first occurrence order
export pure func dedup[a](xs: [a]) -> [a] = _list_dedup(xs)

-- intersect: Elements present in both lists
export pure func intersect[a](xs: [a], ys: [a]) -> [a] = _list_intersect(xs, ys)

-- union: Combine two lists without duplicates
export pure func union[a](xs: [a], ys: [a]) -> [a] = _list_union(xs, ys)

-- difference: Elements in first list but not in second
export pure func difference[a](xs: [a], ys: [a]) -> [a] = _list_difference(xs, ys)
