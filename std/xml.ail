-- std/xml - XML parsing and querying
--
-- Parse XML strings into XmlNode trees and query elements.
-- All operations are pure (no effects required).
--
-- XmlNode ADT: Element(tag, attrs, children) | Text(content) | CData(content) | Comment(content)
--
-- Security: 256 depth limit, 50MB input size limit.
--
-- Usage:
--   import std/xml (parse, parseLenient, sanitizeXml, parseFold, findAll, findFirst,
--                   getText, getAttr, getChildren, getTag,
--                   serialize, escapeXml, xmlElement, xmlText, xmlComment)
--   match parse("<root><item id='1'>Hello</item></root>") {
--     Ok(doc) => println(getText(doc)),
--     Err(msg) => println(msg)
--   }
--
-- Real-world (malformed) XML with a bare '&' — use parseLenient:
--   match parseLenient("<r><p>Apex Consulting & Partners</p></r>") { ... }

module std/xml

import std/result (Result)
import std/option (Option)
import std/iter (FoldStep, Continue, Stop)

-- XmlNode ADT — represents an XML document tree.
-- Constructors match the Go builtins in internal/builtins/xml.go.
-- M-CODEGEN-MULTIMOD: Type declaration required for Go codegen to emit struct definitions.
export type XmlNode =
  | Element(string, [{name: string, value: string}], [XmlNode])
  | Text(string)
  | Comment(string)

-- NodeKind classifies an XmlNode without string-equality on the tag.
-- Returned by nodeKind(node) so callers can pattern-match exhaustively
-- instead of testing `getTag(n) == ""` to detect text. Constructors are
-- prefixed to avoid name collision with XmlNode's Element/Text/Comment.
export type NodeKind =
  | KindElement
  | KindText
  | KindComment

-- Parse XML string into XmlNode tree
-- Returns Ok(XmlNode) or Err(message) for malformed XML
export pure func parse(xml: string) -> Result[XmlNode, string] = _xml_parse(xml)

-- M-STDLIB-XML-LENIENT: lenient parsing for real-world (malformed) XML.
--
-- Repair common well-formedness offenders so a strict parser accepts the input.
-- Currently: escapes a bare '&' that does not begin a valid entity reference
-- (&amp; &#123; &#xAB; &name; are left intact). Pure, single-pass, idempotent.
-- Strict callers should keep using `parse`; this is opt-in (no silent fallback).
export pure func sanitizeXml(xml: string) -> string = _xml_sanitize(xml)

-- Lenient parse: sanitizeXml(xml) then parse. For real-world XML from
-- non-reference generators (Office content.xml, HTML5) that emit an unescaped
-- '&'. Returns Ok(XmlNode) or Err(message).
export pure func parseLenient(xml: string) -> Result[XmlNode, string] = parse(sanitizeXml(xml))

-- Find all descendant elements matching tag name
-- Searches recursively through the tree
export pure func findAll(node: XmlNode, tag: string) -> List[XmlNode] = _xml_findAll(node, tag)

-- Find first descendant element matching tag name
-- Returns Some(node) or None
export pure func findFirst(node: XmlNode, tag: string) -> Option[XmlNode] = _xml_findFirst(node, tag)

-- Extract text content from a node
-- For Element nodes, concatenates all descendant text
export pure func getText(node: XmlNode) -> string = _xml_getText(node)

-- Get attribute value by name
-- Returns Some(value) or None if attribute not present
export pure func getAttr(node: XmlNode, name: string) -> Option[string] = _xml_getAttr(node, name)

-- Get child nodes of an element
-- Returns empty list for non-Element nodes
export pure func getChildren(node: XmlNode) -> List[XmlNode] = _xml_getChildren(node)

-- Get tag name of an element
-- Returns tag string for Element, empty string for Text/CData/Comment
export pure func getTag(node: XmlNode) -> string = _xml_getTag(node)

-- Bulk: find all matching elements and extract their text content
-- Equivalent to map(findAll(node, tag), getText) but in one Go call
export pure func findAllTexts(node: XmlNode, tag: string) -> List[string] = _xml_findAllTexts(node, tag)

-- Bulk: find all matching elements and extract a named attribute
-- Equivalent to filterMap(findAll(node, tag), \n -> getAttr(n, attr)) but in one Go call
export pure func findAllAttrs(node: XmlNode, tag: string, attr: string) -> List[string] = _xml_findAllAttrs(node, tag, attr)

-- Stream-parse: extract up to N elements matching a tag without building full tree
-- Memory: O(largest element) instead of O(entire document). For large XLSX/XML files.
export pure func parseElements(xml: string, tag: string, maxResults: int) -> Result[List[XmlNode], string] = _xml_parseElements(xml, tag, maxResults)

-- Fold over XML elements matching a tag. Calls handler for each match
-- with an accumulator, returning the final accumulated value.
-- Memory: O(largest element + accumulator), not O(all matched elements).
--
-- COST MODEL:
--   parseFold(xml, tag, init, f)  O(n) scan, O(1) memory per element
export pure func parseFold[a](xml: string, tag: string, init: a, f: (a, XmlNode) -> a) -> Result[a, string] = _xml_parseFold(xml, tag, init, f)

-- Bounded variant of parseFold: handler returns FoldStep[a] = Continue(a) | Stop(a).
-- Stop(acc') halts the scan immediately without parsing the rest of the input.
-- Critical when extracting a bounded prefix from a large XML document (e.g.
-- "first 5000 rows of a 50K-row sharedStrings.xml").
--
-- COST MODEL:
--   parseFoldStep(xml, tag, init, f)  O(prefix), early-terminating
export pure func parseFoldStep[a](xml: string, tag: string, init: a, f: (a, XmlNode) -> FoldStep[a]) -> Result[a, string] =
  _xml_parseFoldStep(xml, tag, init, f)

-- Parse with node count limit — returns Err if tree exceeds maxNodes
-- Safety valve for large documents that might exhaust memory
export pure func parseWithLimit(xml: string, maxNodes: int) -> Result[XmlNode, string] = _xml_parseWithLimit(xml, maxNodes)

-- M-DOCPARSE-DX M4: XML serialization

-- Serialize XmlNode tree to XML string
-- Element("root", [], [Text("hello")]) => "<root>hello</root>"
export pure func serialize(node: XmlNode) -> string = _xml_serialize(node)

-- Serialize XmlNode tree to XML string with XML declaration
-- Prepends <?xml version="1.0" encoding="UTF-8"?>
export pure func serializeWithDecl(node: XmlNode) -> string = _xml_serializeWithDecl(node)

-- escapeXml: Escape string for XML text content
-- Converts <, >, &, " to entity references
export pure func escapeXml(text: string) -> string = _escapeXml(text)

-- M-STDLIB-XML-V2: XmlNode constructors
-- Build XML trees programmatically instead of string concatenation

-- Create an Element node with tag, attributes, and children
export pure func xmlElement(tag: string, attrs: [{name: string, value: string}], children: [XmlNode]) -> XmlNode = _xmlElement(tag, attrs, children)

-- Create a Text node
export pure func xmlText(content: string) -> XmlNode = _xmlText(content)

-- Create a Comment node
export pure func xmlComment(content: string) -> XmlNode = _xmlComment(content)

-- M-STDLIB-XML-WALK-PERF (v0.21.0): Tree-walk performance builtins
--
-- Eliminate the dominant FFI/allocation cost of XmlNode tree walks:
--   * foldChildren        — fold over direct children without allocating [XmlNode]
--   * foldChildrenStep    — bounded fold; handler returns FoldStep[a] = Continue|Stop
--   * getAttrMap          — all attributes in one FFI call instead of N getAttr calls
--   * nodeKind            — classify a node by variant instead of `getTag(n) == ""`

-- Fold over direct children of an Element without materialising [XmlNode].
-- Non-Element nodes return init unchanged.
-- Replaces: foldl(f, init, getChildren(node)).
export pure func foldChildren[a](node: XmlNode, init: a, f: (a, XmlNode) -> a) -> a
  = _xml_foldChildren(node, init, f)

-- Bounded variant of foldChildren. Handler returns Continue(a) | Stop(a).
-- Stop(acc') halts the walk immediately and returns acc'.
export pure func foldChildrenStep[a](node: XmlNode, init: a, f: (a, XmlNode) -> FoldStep[a]) -> a
  = _xml_foldChildrenStep(node, init, f)

-- All attributes of an Element as Map[string, string]. Non-Element nodes return empty map.
-- Replaces: N separate getAttr calls when extracting multiple attributes from one node.
-- Duplicate attribute names: last write wins.
export pure func getAttrMap(node: XmlNode) -> Map[string, string]
  = _xml_getAttrMap(node)

-- Classify a node as KindElement | KindText | KindComment without string-equality on the tag.
-- Use instead of `getTag(n) == ""` text-detection patterns.
export pure func nodeKind(node: XmlNode) -> NodeKind
  = _xml_nodeKind(node)

-- Go-iterative flatMap over direct children. Use this — NOT foldChildren —
-- when the walker produces a flat list of outputs. Internally appends into
-- one Go-native slice, so callers avoid both the [XmlNode] alloc that
-- getChildren makes AND the prepend+reverse penalty that an AILANG-side
-- fold accumulator would incur.
--
-- Replaces: flatMap(f, getChildren(node)).
export pure func flatMapChildren[a](node: XmlNode, f: (XmlNode) -> [a]) -> [a]
  = _xml_flatMapChildren(node, f)

-- Go-iterative map over direct children. Use when f produces exactly one
-- output element per child. Replaces: map(f, getChildren(node)).
export pure func mapChildren[a](node: XmlNode, f: (XmlNode) -> a) -> [a]
  = _xml_mapChildren(node, f)
