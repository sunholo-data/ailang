-- std/sem - Semantic caching types (M-DX15)
--
-- Provides types for semantic frame caching:
-- - sem_frame: Canonical cache entry with content/opaque separation
-- - simhash64: 64-bit locality-sensitive hash type alias
-- - similarity_match: Result of similarity search
-- - update_result: CAS update result (Ok or Conflict)
--
-- See design_docs/planned/v0_5_11/DX-15-semantic-caching-MVP-sprint-plan.md

module std/sem

import std/option (Option, Some, None)
import std/json (Json, JNull, JString, JNumber, JArray, JObject, encode, decode, kv, jo, js, jnum, jn)
import std/result (Result, Ok, Err, isOk)
import std/sharedmem as cache (get, put, cas)

-- ============================================================================
-- Type Aliases
-- ============================================================================

-- SimHash is a 64-bit locality-sensitive hash
-- Similar documents have hashes with low Hamming distance
export type simhash64 = int

-- Namespace is a string identifier for SharedIndex partitioning (DX-16)
-- Valid: alphanumeric, underscore, hyphen. No colons, slashes, spaces.
export type namespace = string

-- ============================================================================
-- Namespace Validation (DX-16)
-- ============================================================================

-- Check if namespace contains an invalid character
-- Returns the character if found, None if clean
pure func find_invalid_char(ns: string) -> Option[string] {
  -- Check for colon
  if _str_find(ns, ":") >= 0 then Some(":")
  else if _str_find(ns, "/") >= 0 then Some("/")
  else if _str_find(ns, "\\") >= 0 then Some("\\")
  else if _str_find(ns, " ") >= 0 then Some(" ")
  else if _str_find(ns, "\t") >= 0 then Some("\\t")
  else if _str_find(ns, "\n") >= 0 then Some("\\n")
  else None
}

-- validate_namespace: Validate a namespace string
-- Returns None for valid namespaces, Some(message) for invalid
--
-- Rules:
-- - Cannot be empty
-- - Cannot contain: ':', '/', '\', space, tab, newline
--
-- Examples:
--   validate_namespace("beliefs")   => None (valid)
--   validate_namespace("")          => Some("empty namespace")
--   validate_namespace("a:b")       => Some("invalid character: :")
export pure func validate_namespace(ns: namespace) -> Option[string] {
  if _str_len(ns) == 0 then Some("empty namespace")
  else {
    let invalid = find_invalid_char(ns)
    in match invalid {
      Some(c) => Some(concat_String("invalid character: ", c)),
      None => None
    }
  }
}

-- ============================================================================
-- Result Types
-- ============================================================================

-- Result of similarity search
export type similarity_match = {
  hash: int,      -- The matching SimHash
  distance: int   -- Hamming distance from query (0 = identical)
}

-- Result of CAS (compare-and-swap) update
-- CASSuccess: Update succeeded
-- CASConflict: Another writer modified the entry (stale version)
export type UpdateResult = CASSuccess | CASConflict(string)

-- ============================================================================
-- The Semantic Frame Type
-- ============================================================================

-- sem_frame is the canonical cache entry type.
--
-- Design principles (from user feedback):
-- 1. content is UTF-8 text used for SimHash computation
-- 2. opaque is arbitrary bytes payload (not hashed)
-- 3. simhash is computed from content, not opaque
-- 4. embedding is optional packed bytes (Tier 2, future)
-- 5. meta is key-value metadata
--
-- Example usage:
--   let frame = {
--     id = "doc-123",
--     ver = 1,
--     ts = 1702555200,
--     content = "The quick brown fox",
--     simhash = _simhash("The quick brown fox"),
--     embedding = None,
--     embedding_dim = 0,
--     opaque = _bytes_from_string("{\"source\": \"api\"}")
--   }
export type sem_frame = {
  -- Identity fields
  id: string,             -- Unique identifier
  ver: int,               -- Version number (for CAS)
  ts: int,                -- Timestamp (Unix epoch)

  -- Content for similarity (required)
  content: string,        -- UTF-8 text for SimHash computation
  simhash: int,           -- Computed from content (simhash64 type)

  -- Neural embeddings (optional, Tier 2)
  embedding: Option[bytes],  -- Packed float32 values
  embedding_dim: int,        -- Dimension (768 for EmbeddingGemma, 0 if none)

  -- Payload (not hashed)
  opaque: bytes           -- Arbitrary binary payload
}

-- ============================================================================
-- Helper Functions
-- ============================================================================

-- Check if two frames are similar based on SimHash
-- threshold: maximum Hamming distance to consider "similar"
export pure func is_similar(f1: sem_frame, f2: sem_frame, threshold: int) -> bool {
  _hamming_distance(f1.simhash, f2.simhash) <= threshold
}

-- Check if a frame has an embedding
export pure func has_embedding(f: sem_frame) -> bool {
  match f.embedding {
    Some(_) => true,
    None => false
  }
}

-- Get the simhash from a frame
export pure func get_simhash(f: sem_frame) -> int {
  f.simhash
}

-- Compare two frames by version
export pure func is_newer(f1: sem_frame, f2: sem_frame) -> bool {
  f1.ver > f2.ver
}

-- ============================================================================
-- Frame Constructors
-- ============================================================================

-- make_frame_at: Pure constructor with explicit timestamp
-- Use this for testing or when you need deterministic timestamps
--
-- Parameters:
--   id: Unique identifier for the frame
--   content: UTF-8 text used for SimHash computation
--   opaque: Arbitrary binary payload (not hashed)
--   ts: Unix epoch timestamp in milliseconds
--
-- Returns: A new sem_frame with computed SimHash, version 1, no embedding
export pure func make_frame_at(id: string, content: string, opaque: bytes, ts: int) -> sem_frame {
  {
    id: id,
    ver: 1,
    ts: ts,
    content: content,
    simhash: _simhash(content),
    embedding: None,
    embedding_dim: 0,
    opaque: opaque
  }
}

-- make_frame: Constructor with automatic timestamp from Clock
-- Use this in production code when you want real timestamps
--
-- Parameters:
--   id: Unique identifier for the frame
--   content: UTF-8 text used for SimHash computation
--   opaque: Arbitrary binary payload (not hashed)
--
-- Returns: A new sem_frame with computed SimHash, current timestamp, version 1
-- Requires: Clock capability (--caps Clock)
export func make_frame(id: string, content: string, opaque: bytes) -> sem_frame ! {Clock} {
  let ts = _clock_now()
  in make_frame_at(id, content, opaque, ts)
}

-- with_embedding: Add an embedding to an existing frame
-- Returns a new frame with the embedding set (immutable update)
--
-- Parameters:
--   f: The frame to update
--   emb: Packed float32 embedding bytes
--   dim: Embedding dimension (e.g., 768 for EmbeddingGemma)
--
-- Returns: New frame with embedding set
export pure func with_embedding(f: sem_frame, emb: bytes, dim: int) -> sem_frame {
  {f | embedding: Some(emb), embedding_dim: dim}
}

-- bump_version: Increment the version number for CAS updates
-- Returns a new frame with ver incremented by 1
export pure func bump_version(f: sem_frame) -> sem_frame {
  {f | ver: f.ver + 1}
}

-- ============================================================================
-- Embedding Encode/Decode (DX-16)
-- ============================================================================
-- NOTE: Use builtins directly:
--   _embedding_encode(floats: list[float]) -> bytes
--   _embedding_decode(bytes) -> Option[list[float]]
--
-- High-level helpers deferred due to TList/TApp type representation mismatch.
-- The builtins work correctly - see internal/builtins/embedding_test.go.

-- ============================================================================
-- JSON Serialization
-- ============================================================================

-- Helper: Convert int to float for JSON encoding
pure func int_to_float(n: int) -> float {
  _int_to_float(n)
}

-- Helper: Encode Option[bytes] as JNull or JString(base64)
pure func encode_option_bytes(opt: Option[bytes]) -> Json {
  match opt {
    Some(b) => JString(_bytes_to_base64(b)),
    None => JNull
  }
}

-- encode_frame: Convert sem_frame to JSON string
-- bytes fields are encoded as base64 strings
-- Option[bytes] is encoded as null or base64 string
--
-- Example output:
-- {"id":"doc-123","ver":1,"ts":1702555200,"content":"hello",...}
export pure func encode_frame(f: sem_frame) -> string {
  let json_obj = jo([
    kv("id", js(f.id)),
    kv("ver", jnum(int_to_float(f.ver))),
    kv("ts", jnum(int_to_float(f.ts))),
    kv("content", js(f.content)),
    kv("simhash", jnum(int_to_float(f.simhash))),
    kv("embedding", encode_option_bytes(f.embedding)),
    kv("embedding_dim", jnum(int_to_float(f.embedding_dim))),
    kv("opaque", js(_bytes_to_base64(f.opaque)))
  ])
  in encode(json_obj)
}

-- Helper: Extract string from JSON, return None if not a string
pure func json_get_string(j: Json) -> Option[string] {
  match j {
    JString(s) => Some(s),
    _ => None
  }
}

-- Helper: Extract number from JSON as int, return None if not a number
pure func json_get_int(j: Json) -> Option[int] {
  match j {
    JNumber(n) => Some(_float_to_int(n)),
    _ => None
  }
}

-- Helper: Find value by key in JSON object key-value list
pure func find_key(kvs: List[{key: string, value: Json}], target: string) -> Option[Json] {
  match kvs {
    [] => None,
    [pair, ...rest] => if _str_eq(pair.key, target) then Some(pair.value) else find_key(rest, target)
  }
}

-- Helper: Extract field from JObject by key
pure func json_field(j: Json, key: string) -> Option[Json] {
  match j {
    JObject(kvs) => find_key(kvs, key),
    _ => None
  }
}

-- Helper: Decode Option[bytes] from JSON (null or base64 string)
pure func decode_option_bytes(j: Json) -> Option[Option[bytes]] {
  match j {
    JNull => Some(None),
    JString(s) => match _bytes_from_base64(s) {
      Some(b) => Some(Some(b)),
      None => None
    },
    _ => None
  }
}

-- decode_frame: Parse JSON string into sem_frame
-- Returns None if JSON is invalid or missing required fields
--
-- Expected format: {"id":"...","ver":1,"ts":...,"content":"...",
--                   "simhash":...,"embedding":null,"embedding_dim":0,
--                   "opaque":"base64..."}
export pure func decode_frame(json_str: string) -> Option[sem_frame] {
  match decode(json_str) {
    Err(_) => None,
    Ok(j) => decode_frame_json(j)
  }
}

-- Internal: Decode sem_frame from parsed JSON
pure func decode_frame_json(j: Json) -> Option[sem_frame] {
  -- Extract all required fields
  let id_opt = match json_field(j, "id") { Some(v) => json_get_string(v), None => None }
  in let ver_opt = match json_field(j, "ver") { Some(v) => json_get_int(v), None => None }
  in let ts_opt = match json_field(j, "ts") { Some(v) => json_get_int(v), None => None }
  in let content_opt = match json_field(j, "content") { Some(v) => json_get_string(v), None => None }
  in let simhash_opt = match json_field(j, "simhash") { Some(v) => json_get_int(v), None => None }
  in let emb_field = match json_field(j, "embedding") { Some(v) => decode_option_bytes(v), None => None }
  in let dim_opt = match json_field(j, "embedding_dim") { Some(v) => json_get_int(v), None => None }
  in let opaque_b64 = match json_field(j, "opaque") { Some(v) => json_get_string(v), None => None }
  in let opaque_opt = match opaque_b64 { Some(s) => _bytes_from_base64(s), None => None }
  -- Build frame if all fields present
  in match id_opt {
    None => None,
    Some(id) => match ver_opt {
      None => None,
      Some(ver) => match ts_opt {
        None => None,
        Some(ts) => match content_opt {
          None => None,
          Some(content) => match simhash_opt {
            None => None,
            Some(simhash) => match emb_field {
              None => None,
              Some(embedding) => match dim_opt {
                None => None,
                Some(dim) => match opaque_opt {
                  None => None,
                  Some(opaque) => Some({
                    id: id,
                    ver: ver,
                    ts: ts,
                    content: content,
                    simhash: simhash,
                    embedding: embedding,
                    embedding_dim: dim,
                    opaque: opaque
                  })
                }
              }
            }
          }
        }
      }
    }
  }
}

-- ============================================================================
-- SharedMem Frame Operations (S2.6)
-- ============================================================================

-- load_frame: Load a sem_frame from SharedMem cache by key
-- Returns None if key doesn't exist or JSON is invalid
export func load_frame(key: string) -> Option[sem_frame] ! {SharedMem} {
  match cache.get(key) {
    None => None,
    Some(bytes) => match _bytes_to_string(bytes) {
      json_str => decode_frame(json_str)
    }
  }
}

-- store_frame: Store a sem_frame in SharedMem cache
-- Overwrites any existing value at the key
export func store_frame(key: string, frame: sem_frame) -> unit ! {SharedMem} {
  let json_str = encode_frame(frame)
  in let bytes = _bytes_from_string(json_str)
  in cache.put(key, bytes)
}

-- UpdateResult type for CAS operations
export type UpdateResult =
  | CASSuccess
  | CASConflict

-- update_frame: Atomically update a frame using CAS with retries
-- Takes an update function that transforms the frame
-- Returns CASSuccess if update succeeded, CASConflict after max retries
--
-- retry_count: Number of remaining CAS retries (start with 8-10)
export func update_frame(key: string, f: sem_frame -> sem_frame, retry_count: int) -> UpdateResult ! {SharedMem} {
  match retry_count <= 0 {
    true => CASConflict,
    false => match cache.get(key) {
      None => CASConflict,  -- Key doesn't exist
      Some(old_bytes) => {
        let old_json = _bytes_to_string(old_bytes)
        in match decode_frame(old_json) {
          None => CASConflict,  -- Invalid JSON
          Some(old_frame) => {
            let new_frame = f(old_frame)
            in let new_json = encode_frame(new_frame)
            in let new_bytes = _bytes_from_string(new_json)
            in match cache.cas(key, Some(old_bytes), new_bytes) {
              true => CASSuccess,
              false => update_frame(key, f, retry_count - 1)
            }
          }
        }
      }
    }
  }
}

-- create_or_update_frame: Create a new frame or update existing
-- If key doesn't exist, creates with initial_frame
-- If key exists, applies update function
export func create_or_update_frame(key: string, initial_frame: sem_frame, f: sem_frame -> sem_frame, retry_count: int) -> UpdateResult ! {SharedMem} {
  match cache.get(key) {
    None => {
      -- Try to create
      let json_str = encode_frame(initial_frame)
      in let bytes = _bytes_from_string(json_str)
      in match cache.cas(key, None, bytes) {
        true => CASSuccess,
        false => create_or_update_frame(key, initial_frame, f, retry_count - 1)
      }
    },
    Some(_) => update_frame(key, f, retry_count)
  }
}

-- ============================================================================
-- SharedIndex + SharedMem Combined Operations (DX-16 M9)
-- ============================================================================

-- SearchResult type for similarity search results
-- Matches the record returned by _sharedindex_find_simhash
export type search_result = {
  key: string,       -- The frame key
  score: float,      -- Similarity score (1.0 = identical, 0.0 = maximally different)
  version: int,      -- Version number of the indexed entry
  timestamp: int     -- Timestamp when entry was indexed
}

-- store_frame_ns: Store a frame in both SharedMem and SharedIndex
-- Combines storage with index update for similarity search
--
-- Parameters:
--   ns: Namespace for index partitioning (e.g., "beliefs", "goals")
--   frame: The sem_frame to store
--
-- Effects: SharedMem (storage), SharedIndex (index update)
--
-- Note: Uses frame.id as the key for both storage and indexing
export func store_frame_ns(ns: namespace, frame: sem_frame) -> unit ! {SharedMem, SharedIndex} {
  -- Store in SharedMem
  let json_str = encode_frame(frame)
  in let bytes = _bytes_from_string(json_str)
  in let _ = cache.put(frame.id, bytes)
  -- Update SharedIndex
  in _sharedindex_upsert(ns, frame.id, frame.simhash, frame.ver, frame.ts)
}

-- find_similar: Find frames similar to a query string
-- Returns top-K results sorted by similarity score (descending)
--
-- Parameters:
--   ns: Namespace to search in
--   query: Query text (SimHash computed for similarity comparison)
--   top_k: Maximum number of results to return
--
-- Returns: List of search results with keys, scores, versions, timestamps
-- Note: This only searches the index - use load_frame to retrieve full frames
export func find_similar(ns: namespace, query: string, top_k: int) -> list[search_result] ! {SharedIndex} {
  let query_hash = _simhash(query)
  in _sharedindex_find_simhash(ns, query_hash, top_k, 0, true)
}

-- find_similar_bounded: Find similar frames with scan limit
-- Like find_similar but bounds the O(N) scan for large namespaces
--
-- Parameters:
--   ns: Namespace to search in
--   query: Query text
--   top_k: Maximum results
--   max_scan: Maximum entries to scan (0 = unlimited)
--   deterministic: true for Strict mode (consistent ordering), false for BestEffort
export func find_similar_bounded(ns: namespace, query: string, top_k: int, max_scan: int, deterministic: bool) -> list[search_result] ! {SharedIndex} {
  let query_hash = _simhash(query)
  in _sharedindex_find_simhash(ns, query_hash, top_k, max_scan, deterministic)
}

-- Helper: Get first element from search results
-- DX-17 fix: TList/TApp now unify, so we can use pattern matching
pure func get_first_result(results: list[search_result]) -> Option[search_result] {
  match results {
    [] => None,
    [first, ..._] => Some(first)
  }
}

-- resolve_best_match: Find the most similar frame and load it
-- Combines index search with frame retrieval
--
-- Parameters:
--   ns: Namespace to search in
--   query: Query text
--
-- Returns: Some(frame) if a similar frame exists and can be loaded, None otherwise
export func resolve_best_match(ns: namespace, query: string) -> Option[sem_frame] ! {SharedMem, SharedIndex} {
  let query_hash = _simhash(query)
  in let results = _sharedindex_find_simhash(ns, query_hash, 1, 0, true)
  in match get_first_result(results) {
    None => None,
    Some(best) => load_frame(best.key)
  }
}

-- resolve_best_match_threshold: Like resolve_best_match but with score threshold
-- Only returns a match if similarity score meets the threshold
--
-- Parameters:
--   ns: Namespace to search in
--   query: Query text
--   min_score: Minimum similarity score (0.0 to 1.0)
--
-- Returns: Some(frame) if score >= min_score, None otherwise
export func resolve_best_match_threshold(ns: namespace, query: string, min_score: float) -> Option[sem_frame] ! {SharedMem, SharedIndex} {
  let query_hash = _simhash(query)
  in let results = _sharedindex_find_simhash(ns, query_hash, 1, 0, true)
  in match get_first_result(results) {
    None => None,
    Some(best) => if best.score >= min_score then load_frame(best.key) else None
  }
}

-- delete_frame_ns: Delete a frame from both SharedMem and SharedIndex
-- Removes from storage and index atomically
--
-- Parameters:
--   ns: Namespace containing the frame
--   key: Frame key (id)
export func delete_frame_ns(ns: namespace, key: string) -> unit ! {SharedMem, SharedIndex} {
  let _ = _sharedmem_delete(key)
  in _sharedindex_delete(ns, key)
}

-- count_frames: Get the count of indexed frames in a namespace
export func count_frames(ns: namespace) -> int ! {SharedIndex} {
  _sharedindex_entry_count(ns)
}

-- list_namespaces: Get all namespace names with indexed entries
export func list_namespaces(u: unit) -> list[string] ! {SharedIndex} {
  _sharedindex_namespaces(u)
}
