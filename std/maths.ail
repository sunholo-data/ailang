-- std/maths - British English alias for std/math
--
-- Re-exports all functions from std/math.
-- Use either import std/math or import std/maths - they're identical.

module std/maths

-- Import all functions from std/math and re-export them
-- Note: We call the internal builtins directly to avoid extra indirection

-- Trigonometric functions
export pure func sin(x: float) -> float = _math_sin(x)
export pure func cos(x: float) -> float = _math_cos(x)
export pure func tan(x: float) -> float = _math_tan(x)
export pure func asin(x: float) -> float = _math_asin(x)
export pure func acos(x: float) -> float = _math_acos(x)
export pure func atan(x: float) -> float = _math_atan(x)
export pure func atan2(y: float, x: float) -> float = _math_atan2(y, x)

-- Power and logarithm functions
export pure func sqrt(x: float) -> float = _math_sqrt(x)
export pure func pow(x: float, y: float) -> float = _math_pow(x, y)
export pure func exp(x: float) -> float = _math_exp(x)
export pure func log(x: float) -> float = _math_log(x)
export pure func log10(x: float) -> float = _math_log10(x)

-- Rounding functions
export pure func floor(x: float) -> float = _math_floor(x)
export pure func ceil(x: float) -> float = _math_ceil(x)
export pure func round(x: float) -> float = _math_round(x)

-- Absolute value
export pure func abs_Float(x: float) -> float = _math_abs_Float(x)
export pure func abs_Int(x: int) -> int = _math_abs_Int(x)

-- Constants
export pure func PI() -> float = _math_PI()
export pure func E() -> float = _math_E()
