-- std/array - Fixed-size arrays with O(1) access
--
-- Arrays provide O(1) indexed access, unlike lists which are O(n).
-- Use when random access is needed. set() copies the whole array, so a loop of
-- single-element set() calls is O(n^2): build the values first (fromList,
-- make) or use a whole-array operation instead.
--
-- Pure functions (no effects required)

module std/array
import std/option (Option, Some, None)
import std/list (map as listMap, foldl as listFoldl, filter as listFilter)

--
-- INDEXING: 0-based (first element at index 0, last at length-1)
-- IMMUTABILITY: All operations return new arrays (copy-on-write)
--
-- COST MODEL:
--   make(n, v)     O(n)  - allocates n elements
--   get(arr, i)    O(1)  - direct index lookup
--   set(arr, i, v) O(n)  - copies entire array (immutable semantics)
--   length(arr)    O(1)  - stored metadata
--   fromList(xs)   O(n)  - converts each element
--   toList(arr)    O(n)  - converts each element
--
-- ERRORS: get, unsafeGet and set fail on an out-of-bounds index, naming the
-- index and the length. getOpt returns None instead.
-- ============================================================================
-- Array creation

-- Create empty array with zero elements. O(1).
export pure func empty[a]() -> Array[a] {
  _array_empty()
}

-- Create array of given size, all elements initialized to default. O(n).
export pure func make[a](size: int, default: a) -> Array[a] {
  _array_make(size, default)
}

-- Convert list to array. O(n). Use when you need O(1) indexed access.
export pure func fromList[a](xs: [a]) -> Array[a] {
  _array_from_list(xs)
}

-- Convert array to list. O(n). Use for list operations (map, filter, foldl).
export pure func toList[a](arr: Array[a]) -> [a] {
  _array_to_list(arr)
}

-- Array access
-- Returns number of elements. O(1).
export pure func length[a](arr: Array[a]) -> int {
  _array_length(arr)
}

-- Get element at index (0-based). Throws error if idx < 0 or idx >= length.
export pure func get[a](arr: Array[a], idx: int) -> a {
  _array_get(arr, idx)
}

-- Safe get: returns Some(element) if in bounds, None otherwise.
export pure func getOpt[a](arr: Array[a], idx: int) -> Option[a] {
  if idx < 0 then None else if idx >= _array_length(arr) then None else Some(_array_get(arr, idx))
}

-- Unsafe get: runtime error if out of bounds. Use only when you've verified bounds.
export pure func unsafeGet[a](arr: Array[a], idx: int) -> a {
  _array_unsafe_get(arr, idx)
}

-- Array modification (immutable - returns new array)

-- Set element at index, returning NEW array. O(n) due to copy-on-write.
-- Original array is unchanged (immutable semantics). An out-of-bounds index
-- is an error naming the index and the length.
-- TIP: For many updates, consider building a list and using fromList.
export pure func set[a](arr: Array[a], idx: int, val: a) -> Array[a] {
  _array_set(arr, idx, val)
}

-- Append element to end of array, returning NEW array. O(n) due to copy.
-- Original array is unchanged (immutable semantics).
-- TIP: For bulk building, prefer fromList over repeated append.
export pure func append[a](arr: Array[a], val: a) -> Array[a] {
  _array_append(arr, val)
}

-- ============================================================================
-- Bulk updates (one copy, then k writes: O(n + k), not O(n * k))
-- ============================================================================

-- Apply (index, value) writes in list order with ONE copy; a later write to the
-- same index wins. Any out-of-bounds index is an error.
--   updateMany(make(3, 0.0), [(0, 1.0), (2, 5.0)])  -- #[1.0, 0.0, 5.0]
export pure func updateMany[a](arr: Array[a], writes: [(int, a)]) -> Array[a] {
  _array_update_many(arr, writes)
}

-- Add xs[j] into position idx[j] for every j, with ONE copy (gradient
-- accumulation). idx and xs must have equal length; out of bounds is an error.
--   scatterAdd(make(3, 0.0), [0, 0, 2], [1.0, 2.0, 5.0])  -- #[3.0, 0.0, 5.0]
export pure func scatterAdd(arr: Array[float], idx: [int], xs: [float]) -> Array[float] {
  _array_scatter_add(arr, idx, xs)
}

-- ============================================================================
-- Float kernels on Array[float] (native loops over an unboxed store)
-- ============================================================================
-- An all-float array is stored as 8 bytes per element. Two-array kernels are
-- STRICT: a length mismatch is an error (std/embedding's [float] versions keep
-- a lenient common-prefix rule). Sums run in index order (bit-reproducible).
-- Use [float] + std/embedding for small vectors; Array[float] when memory or
-- bulk updates matter.

-- Dot product. O(n).
export pure func dot(a: Array[float], b: Array[float]) -> float = _array_f_dot(a, b)

-- a*x + y in one pass (the SGD update). O(n).
export pure func axpy(a: float, x: Array[float], y: Array[float]) -> Array[float] = _array_f_axpy(a, x, y)

-- s * v. O(n).
export pure func scale(s: float, v: Array[float]) -> Array[float] = _array_f_scale(s, v)

-- Elementwise a + b. O(n).
export pure func add(a: Array[float], b: Array[float]) -> Array[float] = _array_f_add(a, b)

-- Elementwise a - b. O(n).
export pure func sub(a: Array[float], b: Array[float]) -> Array[float] = _array_f_sub(a, b)

-- Elementwise a * b. O(n).
export pure func mul(a: Array[float], b: Array[float]) -> Array[float] = _array_f_mul(a, b)

-- Sum of all elements, in index order. O(n).
export pure func sum(v: Array[float]) -> float = _array_f_sum(v)

-- Index of the first largest element; NaNs are skipped. Error on empty. O(n).
export pure func argmax(v: Array[float]) -> int = _array_f_argmax(v)
