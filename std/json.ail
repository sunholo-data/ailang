-- JSON encoding for AILANG
-- Provides ADT for JSON values and encoding function
module std/json
import std/option (Option, Some, None)
import std/result (Result)
import std/list (foldl, foldr, map, flatMap, length, findIndex)
import std/math (floatToInt, intToFloat)

-- JSON ADT with all JSON types.
-- Numbers: decode gives JInt(n) for an integer literal that fits int64 ("42",
-- "-7", "9223372036854775807") and JNumber(x) for everything else ("1.0",
-- "1e3", "-0", integers outside int64). JInt is exact; encode prints it digit
-- for digit. JInt is declared last so the older constructors keep their tags.
export type Json = JNull | JBool(bool) | JNumber(float) | JString(string) | JArray([Json]) | JObject([{ key: string, value: Json }]) | JInt(int) deriving (Eq)

-- Encode JSON to string (Go-backed for correctness)
export func encode(obj: Json) -> string {
  _json_encode(obj)
}

-- Decode JSON from string (Go-backed for correctness).
-- The string must hold exactly one JSON value; anything but whitespace after
-- it is Err("decode: trailing data at offset N") (use repair for lenient input).
export func decode(s: string) -> Result[Json, string] {
  _json_decode(s)
}

-- Repair truncated/malformed JSON string (Go-backed)
-- Returns the repaired string so callers can inspect or re-decode.
-- Handles: trailing whitespace, unclosed strings/arrays/objects, trailing commas, truncated keywords.
export func repair(s: string) -> Result[string, string] {
  _json_repair(s)
}

-- Convenience constructors (reduce AI fumbles)

export func jn() -> Json {
  JNull
}

export func jb(b: bool) -> Json {
  JBool(b)
}

export func jnum(x: float) -> Json {
  JNumber(x)
}

-- jint: integer JSON number, exact for every int (encode prints all digits)
export pure func jint(n: int) -> Json = JInt(n)

export func js(s: string) -> Json {
  JString(s)
}

export func ja(xs: [Json]) -> Json {
  JArray(xs)
}

export func jo(kvs: [{ key: string, value: Json }]) -> Json {
  JObject(kvs)
}

-- Helper to build object key-value pairs
export func kv(k: string, v: Json) -> { key: string, value: Json } {
  { key: k, value: v }
}

-- JSON Accessor Functions

-- Get value from object by key
export func get(obj: Json, key: string) -> Option[Json] {
  match obj {
    JObject(kvs) => findInList(kvs, key),
    _ => None
  }
}

-- Helper: find the first pair with this key. findIndex is an iterative builtin;
-- the `[kv, ...rest]` walk it replaced copied the tail per step on the VM (#1518).
func findInList(kvs: [{ key: string, value: Json }], key: string) -> Option[Json] {
  match findIndex(\kv. _str_eq(kv.key, key), kvs) {
    Some(i) => {
      let kv = _list_nth(kvs, i);
      Some(kv.value)
    },
    None => None
  }
}

-- Check if object has key
export func has(obj: Json, key: string) -> bool {
  match get(obj, key) {
    Some(_) => true,
    None => false
  }
}

-- Get value from object by key with fallback
export func getOr(obj: Json, key: string, default: Json) -> Json {
  match get(obj, key) {
    Some(v) => v,
    None => default
  }
}

-- Extract string value
export func asString(j: Json) -> Option[string] {
  match j {
    JString(s) => Some(s),
    _ => None
  }
}

-- Extract number value as a float; accepts JInt and JNumber.
-- A JInt above 2^53 is rounded to the nearest float: use getInt or match
-- JInt(n) to keep it exact.
export func asNumber(j: Json) -> Option[float] {
  match j {
    JNumber(n) => Some(n),
    JInt(i) => Some(intToFloat(i)),
    _ => None
  }
}

-- Extract boolean value
export func asBool(j: Json) -> Option[bool] {
  match j {
    JBool(b) => Some(b),
    _ => None
  }
}

-- Extract boolean value, tolerating a stringified boolean.
-- System-boundary helper (A12): some external APIs normalise a boolean
-- written as JSON true/false but return "true"/"false" as a JSON string
-- (e.g. Firestore's booleanValue). Accepts JBool(b) OR JString "true"/"false";
-- anything else is None. Prefer asBool for values you control — reach for
-- asBoolLoose only at the boundary with an API that may hand back either shape.
export func asBoolLoose(j: Json) -> Option[bool] {
  match j {
    JBool(b) => Some(b),
    JString(s) => if s == "true" then Some(true) else if s == "false" then Some(false) else None,
    _ => None
  }
}

-- Extract array value
export func asArray(j: Json) -> Option[[Json]] {
  match j {
    JArray(xs) => Some(xs),
    _ => None
  }
}

-- Extract object value as key-value list
export func asObject(j: Json) -> Option[[{ key: string, value: Json }]] {
  match j {
    JObject(kvs) => Some(kvs),
    _ => None
  }
}

-- Helper: extract key from kv pair (for use with map)
func extractKey(pair: { key: string, value: Json }) -> string {
  pair.key
}

-- Helper: extract value from kv pair (for use with map)
func extractValue(pair: { key: string, value: Json }) -> Json {
  pair.value
}

-- Get all keys from object (in source order)
-- NOTE: Callers must also `import std/list (map)` for runtime resolution
export func keys(obj: Json) -> [string] {
  match asObject(obj) {
    Some(kvs) => map(extractKey, kvs),
    None => []
  }
}

-- Get all values from object (in source order)
-- NOTE: Callers must also `import std/list (map)` for runtime resolution
export func values(obj: Json) -> [Json] {
  match asObject(obj) {
    Some(kvs) => map(extractValue, kvs),
    None => []
  }
}

-- ============================================================================
-- JSON Convenience Functions (v0.6.4)
-- These combine get() + asX() to reduce nested Option matching
-- ============================================================================

-- getString: Get string value from JSON object by key
export func getString(obj: Json, key: string) -> Option[string] {
  match get(obj, key) {
    Some(j) => asString(j),
    None => None
  }
}

-- getNumber: Get float value from JSON object by key
export func getNumber(obj: Json, key: string) -> Option[float] {
  match get(obj, key) {
    Some(j) => asNumber(j),
    None => None
  }
}

-- getInt: Get int value from JSON object by key.
-- JInt(n) gives Some(n); a JNumber gives Some only when it is integral and
-- within int64 (30.0 -> Some(30)); a fractional one (1187.5) is None, never
-- truncated. Anything else, or a missing key, is None.
export func getInt(obj: Json, key: string) -> Option[int] {
  match get(obj, key) {
    Some(JInt(i)) => Some(i),
    Some(JNumber(f)) => integralFloat(f),
    _ => None
  }
}

-- integralFloat: Some(int) when f is a whole number inside int64, else None
-- (NaN fails every comparison, so it is None too).
pure func integralFloat(f: float) -> Option[int] =
  if f >= -9223372036854775808.0 && f < 9223372036854775808.0 && intToFloat(floatToInt(f)) == f
  then Some(floatToInt(f))
  else None

-- getBool: Get bool value from JSON object by key
export func getBool(obj: Json, key: string) -> Option[bool] {
  match get(obj, key) {
    Some(j) => asBool(j),
    None => None
  }
}

-- getArray: Get array value from JSON object by key
export func getArray(obj: Json, key: string) -> Option[[Json]] {
  match get(obj, key) {
    Some(j) => asArray(j),
    None => None
  }
}

-- getObject: Get nested object from JSON object by key (returns Json)
export func getObject(obj: Json, key: string) -> Option[Json] {
  get(obj, key)
}

-- ============================================================================
-- JSON Array Type Extraction (v0.6.5)
-- Two variants: permissive (filter/skip non-matching) vs strict (fail on mismatch)
-- ============================================================================

-- These four were `[x] ++ recursive-call` / `[x] ++ acc` builders: one evaluator
-- frame per element and quadratic copying. Converting 1,252 rows of 768 numbers
-- took 3.8 s / 1.1 GB, far more than decoding the JSON (M-NUMERICS-QUICK). They
-- now go through the iterative flatMap builtin.

-- filterStrings: Extract string values from JSON array, skipping non-strings
-- Permissive: JNumber, JBool, etc. are silently ignored
export pure func filterStrings(xs: [Json]) -> [string] =
  flatMap(\x. match x { JString(s) => [s], _ => [] }, xs)

-- filterNumbers: Extract float values from JSON array, skipping non-numbers
-- Permissive: JString, JBool, etc. are silently ignored; JInt and JNumber both count
export pure func filterNumbers(xs: [Json]) -> [float] =
  flatMap(\x. match x { JNumber(n) => [n], JInt(i) => [intToFloat(i)], _ => [] }, xs)

-- allStrings: Extract ALL elements as strings, or None if any non-string
-- Strict: Returns None if array contains JNumber, JBool, etc.
export pure func allStrings(xs: [Json]) -> Option[[string]] {
  let ss = filterStrings(xs);
  if length(ss) == length(xs) then Some(ss) else None
}

-- allNumbers: Extract ALL elements as numbers, or None if any non-number
-- Strict: Returns None if array contains JString, JBool, etc.
export pure func allNumbers(xs: [Json]) -> Option[[float]] {
  let ns = filterNumbers(xs);
  if length(ns) == length(xs) then Some(ns) else None
}

-- ============================================================================
-- Convenience Wrappers: Object → Array → Typed Elements (v0.6.5)
-- ============================================================================

-- getStringArray: Get string array from object (permissive)
export func getStringArray(obj: Json, key: string) -> Option[[string]] {
  match getArray(obj, key) {
    Some(arr) => Some(filterStrings(arr)),
    None => None
  }
}

-- getStringArrayStrict: Get string array from object (strict)
export func getStringArrayStrict(obj: Json, key: string) -> Option[[string]] {
  match getArray(obj, key) {
    Some(arr) => allStrings(arr),
    None => None
  }
}

-- getStringArrayOrEmpty: Get string array or [] if missing/invalid
export func getStringArrayOrEmpty(obj: Json, key: string) -> [string] {
  match getArray(obj, key) {
    Some(arr) => filterStrings(arr),
    None => []
  }
}

-- getNumberArray: Get number array from object (permissive)
export func getNumberArray(obj: Json, key: string) -> Option[[float]] {
  match getArray(obj, key) {
    Some(arr) => Some(filterNumbers(arr)),
    None => None
  }
}

-- getNumberArrayStrict: Get number array from object (strict)
export func getNumberArrayStrict(obj: Json, key: string) -> Option[[float]] {
  match getArray(obj, key) {
    Some(arr) => allNumbers(arr),
    None => None
  }
}

-- getNumberArrayOrEmpty: Get number array or [] if missing/invalid
export func getNumberArrayOrEmpty(obj: Json, key: string) -> [float] {
  match getArray(obj, key) {
    Some(arr) => filterNumbers(arr),
    None => []
  }
}

-- decodeFloatArray: parse a flat JSON array of numbers ("[1.5, -2, 3e4]") straight
-- into an unboxed Array[float], without building a Json tree. Use it for a float
-- column exported from DuckDB or numpy. Anything else (nesting, strings, null,
-- a trailing comma, trailing data) is Err naming the byte offset.
--   decodeFloatArray("[1.5, 2]")  -- Ok(#[1.5, 2.0])
export pure func decodeFloatArray(s: string) -> Result[Array[float], string] = _json_decode_float_array(s)
