-- std/string - String manipulation functions
--
-- String operations: length, substring, trim, split, etc.
-- Strings are immutable UTF-8 sequences.
--
-- Pure functions (no effects required)

module std/string

import std/option (Option, Some, None)

export pure func length(s: string) -> int { _str_len(s) }
export pure func substring(s: string, start: int, end: int) -> string { _str_slice(s, start, end) }
export pure func toUpper(s: string) -> string { _str_upper(s) }
export pure func toLower(s: string) -> string { _str_lower(s) }
export pure func trim(s: string) -> string { _str_trim(s) }

-- compare: -1 / 0 / +1
export pure func compare(a: string, b: string) -> int { _str_compare(a, b) }

-- returns first index or -1
export pure func find(hay: string, needle: string) -> int { _str_find(hay, needle) }

-- returns true if hay contains needle
export pure func contains(hay: string, needle: string) -> bool { find(hay, needle) >= 0 }

-- replace: Replace all occurrences of old with new
-- Example: replace("hello world", "world", "universe") => "hello universe"
export pure func replace(s: string, old: string, new: string) -> string { _str_replace(s, old, new) }

-- startsWith: Check if string starts with prefix
-- Example: startsWith("hello world", "hello") => true
export pure func startsWith(s: string, prefix: string) -> bool { _str_startsWith(s, prefix) }

-- endsWith: Check if string ends with suffix
-- Example: endsWith("hello world", "world") => true
export pure func endsWith(s: string, suffix: string) -> bool { _str_endsWith(s, suffix) }

-- String parsing (returns Option)
export pure func stringToInt(s: string) -> Option[int] { _stringToInt(s) }
export pure func stringToFloat(s: string) -> Option[float] { _stringToFloat(s) }

-- String splitting
export pure func split(s: string, delimiter: string) -> list[string] { _str_split(s, delimiter) }

-- chars: Convert string to list of single-character strings
-- Useful for character-by-character processing
-- Example: chars("abc") returns ["a", "b", "c"]
export pure func chars(s: string) -> list[string] { _str_chars(s) }

-- ============================================================================
-- Type to String Conversion (v0.5.10)
-- ============================================================================

-- floatToStr: Convert a float to its string representation
-- Uses compact format (no trailing zeros)
export pure func floatToStr(f: float) -> string { _string_floatToStr(f) }

-- intToStr: Convert an integer to its string representation
export pure func intToStr(n: int) -> string { _string_intToStr(n) }

-- ============================================================================
-- String Building (v0.6.5)
-- ============================================================================

-- join: Concatenate list of strings with delimiter
-- Uses Go's strings.Join for O(n) single-allocation performance
export pure func join(delimiter: string, xs: [string]) -> string = _str_join(xs, delimiter)

-- concat: Concatenate a list of strings with no separator.
-- O(n) single-allocation via strings.Builder under the hood.
-- concat(["a", "b", "c"]) == "abc"
-- Prefer "${...}" interpolation for mixed-type building; prefer concat/join for list-driven building.
export pure func concat(xs: [string]) -> string = _str_join(xs, "")

-- repeat: Repeat a string n times
-- Complexity: O(n) single allocation via _str_join.
-- repeat("ab", 3) = "ababab"
-- repeat("x", 0) = ""
export pure func repeat(s: string, n: int) -> string {
  if n <= 0 then "" else _str_join(_repeat_list(s, n), "")
}

-- Internal helper: build [s, s, ..., s] (n times).
-- Not exported; used by repeat/. Keep the strings.Builder in _str_join doing the heavy lifting.
pure func _repeat_list(s: string, n: int) -> [string] {
  if n <= 0 then [] else s :: _repeat_list(s, n - 1)
}

-- M-DOCPARSE-DX M3: String splitting

-- words: Split on whitespace (tabs, spaces, newlines), drop empties
-- words("hello  world\tfoo") = ["hello", "world", "foo"]
export pure func words(s: string) -> [string] = _str_words(s)

-- splitAny: Split on any of multiple single-character delimiters
-- splitAny("a,b;c", [",", ";"]) = ["a", "b", "c"]
export pure func splitAny(s: string, delimiters: [string]) -> [string] = _str_splitAny(s, delimiters)

-- ============================================================================
-- Character-Level Iteration (v0.9.3 / M-PERF7)
-- ============================================================================

-- foldChars: Fold over characters without intermediate list allocation
-- 10-100x faster than foldl(f, acc, chars(s)) for large strings
-- Each character is passed as a single-character string
-- Example: foldChars(\acc c -> acc ++ c, "", "abc") = "abc"
export pure func foldChars(f: (a, string) -> a, acc: a, s: string) -> a = _str_foldChars(f, acc, s)

-- charAt: Get character at rune index (0-based)
-- Note: O(n) rune conversion per call — use foldChars for sequential access
-- Example: charAt("hello", 1) = "e"
export pure func charAt(s: string, i: int) -> string = _str_charAt(s, i)

-- Get Unicode code point of a single-character string
-- Example: charCode("a") = 97, charCode("🎉") = 127881
export pure func charCode(c: string) -> int = _str_charCode(c)

-- ============================================================================
-- Encoding (v0.11.0 / M-STD-STRING-PERF)
-- ============================================================================

-- foldSlices: Fold over split segments without materializing a list
-- Equivalent to foldl(f, acc, split(s, delim)) but O(n) memory.
-- No intermediate list allocated — segments are slices from the source string.
-- Example: foldSlices("a,b,c", ",", 0, \acc s -> acc + length(s)) = 3
export pure func foldSlices(s: string, delim: string, acc: a, f: (a, string) -> a) -> a
  = _str_foldSlices(s, delim, acc, f)

-- mapSlicesJoin: Split, transform each segment, and join results in O(n)
-- Equivalent to join("", map(f, split(s, delim))) but uses a strings.Builder.
-- No intermediate list, no O(n^2) accumulator concatenation.
-- This is the recommended pattern for any split->transform->concatenate workflow.
-- Example: mapSlicesJoin("a,b,c", ",", toUpper) = "ABC"
export pure func mapSlicesJoin(s: string, delim: string, f: (string) -> string) -> string
  = _str_mapSlicesJoin(s, delim, f)

-- replaceMany: Replace multiple patterns in a single pass
-- Uses Go's strings.NewReplacer (Aho-Corasick) for O(n) single-scan replacement.
-- Much faster than calling replace() N times sequentially.
-- Example: replaceMany("a&amp;b&lt;c", [("&amp;", "&"), ("&lt;", "<")]) = "a&b<c"
export pure func replaceMany(s: string, replacements: [(string, string)]) -> string
  = _str_replaceMany(s, replacements)

-- decodeQuotedPrintable: Decode RFC 2045 §6.7 quoted-printable encoding
-- Single-pass O(n) native Go implementation — no interpreter overhead.
-- =XX hex escapes decoded, soft line breaks (=\r\n) removed,
-- invalid sequences passed through unchanged.
-- Example: decodeQuotedPrintable("hello=20world") = "hello world"
export pure func decodeQuotedPrintable(s: string) -> string = _str_decodeQP(s)

-- startsWithIgnoreCase: Case-insensitive prefix check
-- Uses Unicode-aware case folding (handles ß ↔ SS, etc.)
-- Example: startsWithIgnoreCase("Content-Type", "content-type") = true
export pure func startsWithIgnoreCase(s: string, prefix: string) -> bool = _str_startsWithIC(s, prefix)
