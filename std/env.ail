module std/env

-- Environment variable access with capability-based security
-- All operations require Env capability grant
-- Uses immutable snapshot captured at program start

-- Effect marker
-- export effect Env  -- Will be added when effect declarations are supported

-- Imports
import std/result(Result, Ok, Err)

-- Error type for environment operations
export type EnvError =
  | NotFound(string)    -- Variable doesn't exist in snapshot
  | NotAllowed(string)  -- Variable not in allowlist

-- Get environment variable value
-- Returns Result with value if exists and allowed
-- @requires Env capability
-- @security Snapshot semantics (external changes ignored after program start)
-- @security Allowlist enforcement (use --allow-env or --allow-env-file)
-- @security Redaction enabled by default (AILANG_REDACT_ENV=off to disable)
-- @example match getEnv("API_KEY") { Ok(key) => key, Err(_) => "default" }
export func getEnv(name: string) -> Result(string, EnvError) ! {Env} = _env_getEnv(name)

-- Check if environment variable exists
-- Returns true if variable exists and is allowed, false otherwise
-- @requires Env capability
-- @security Returns false for non-allowed variables (doesn't reveal existence)
-- @example if hasEnv("DEBUG") then "debug mode" else "production mode"
export func hasEnv(name: string) -> bool ! {Env} = _env_hasEnv(name)

-- Get environment variable with fallback
-- Convenience function that returns default value if variable not found/allowed
-- @requires Env capability
-- @example getEnvOr("PORT", "8080")  -- Returns "8080" if PORT not set
export func getEnvOr(name: string, defaultValue: string) -> string ! {Env} =
  match getEnv(name) {
    Ok(value) => value
    Err(_) => defaultValue
  }

-- Usage examples (documentation)
--
-- Basic usage:
--   ailang run --caps Env program.ail
--   let path = getEnvOr("PATH", "/usr/bin")
--
-- With allowlist (security):
--   ailang run --caps Env --allow-env API_KEY,DEBUG program.ail
--   let key = getEnv("API_KEY")  -- Ok if set, Err(NotAllowed) for other vars
--
-- Override variables (testing):
--   ailang run --caps Env --env API_KEY=test program.ail
--   let key = getEnv("API_KEY")  -- Returns "test"
--
-- Load snapshot (reproducibility):
--   ailang run --caps Env --env-snapshot env.json program.ail
--
-- Save snapshot (for later):
--   ailang run --caps Env --write-env-snapshot env.json program.ail
