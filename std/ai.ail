-- std/ai.ail
-- AI effect for general-purpose AI oracle calls
--
-- The AI effect is AILANG's general-purpose AI oracle - an opaque,
-- host-provided effect for calling external AI/ML systems. Use cases:
--   - Game NPC decision-making (via typed wrappers)
--   - CLI tools with AI assistance
--   - Agents written in AILANG calling LLMs
--   - Data analysis pipelines with AI steps
--
-- The interface is intentionally simple: string -> string
-- By convention, JSON is used for input/output, but not enforced.
--
-- Usage:
--   import std/ai as AI
--   import std/json (Json, decode)
--   import std/result (Result, Ok, Err)
--
--   -- Unstructured: string -> string
--   let resp = AI.call("What is the capital of France?")
--
--   -- Structured JSON (schema-enforced, provider validates):
--   let raw = AI.callJson("Return name and age", "{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"age\":{\"type\":\"integer\"}}}")
--   let result = decode(raw)
--
--   -- Structured JSON (no schema, just valid JSON):
--   let raw = AI.callJsonSimple("Return [1,2,3] as JSON")
--   let result = decode(raw)
--
-- IMPORTANT: Host must configure AIHandler explicitly:
--   - game.NewStubAIHandler() for testing
--   - Your custom handler for production (e.g., OpenAI, local LLM)
--   - Nil handler = error (no silent fallbacks)
--
-- ## Token streaming (v0.15.0+)
--
-- For SSE token streaming via the M-AI-PROVIDER-CONFIG registry, see
-- `std/ai/streaming` — exposes `openaiCompatStream` and `anthropicStream`
-- which dispatch to a registered config-driven provider with full AI cap +
-- budget tracking. Recipes for OpenAI, OpenRouter, and Anthropic live at
-- `docs/recipes/ai-token-streaming`.
--
-- ## Custom providers
--
-- To add a new AI provider as a package (no Go code, no binary fork), see
-- the `[[ai_provider]]` block in `ailang.toml` and the guide at
-- `docs/guides/custom-ai-providers`. Streaming providers in v0.15.0+ also
-- declare an `[ai_provider.streaming]` sub-block consumed by std/ai/streaming.

module std/ai

import std/result (Result, Ok, Err)

-- ============================================================================
-- Multi-turn / tool-aware types (M-AI-TOOL-LOOP, v0.17.0)
-- ============================================================================
--
-- AIError is the canonical typed error returned by Result-returning AI calls.
-- Shape mirrors std/ai/streaming.AIError byte-for-byte. Field semantics:
--   code      : one of AuthFailed | RateLimit | Timeout | ConnectionFailed |
--               BudgetExhausted | ProviderNotFound | CapabilityNotSupported |
--               ProtocolError | ModelNotAllowed | ContextLength |
--               SchemaValidation | ToolsNotSupported | ModelNotFound | Internal
--   message   : human-readable, may include provider name verbatim
--   retryable : true for transient/network/load conditions; false for
--               configuration / auth / schema mismatches
export type AIError = {
  code: string,
  message: string,
  retryable: bool
}

-- ToolCall is one tool invocation emitted by the model in a step response.
-- The host dispatches it (looking up `name` in the registered tool catalog),
-- then feeds the result back as a Message with role="tool" and tool_call_id
-- matching this id.
--
-- arguments is JSON-encoded as a string — caller decodes per the advertised
-- parameters schema.
export type ToolCall = {
  id: string,
  name: string,
  arguments: string
}

-- Message is one entry in a multi-turn conversation.
--   role         : "user" | "assistant" | "tool" | "system"
--   content      : prose; may be empty for assistant messages whose tool_calls
--                  is non-empty
--   tool_calls   : assistant only — invocations the model emitted
--   tool_call_id : "tool" role only — references a prior ToolCall.id
export type Message = {
  role: string,
  content: string,
  tool_calls: [ToolCall],
  tool_call_id: string
}

-- ToolSchema declares one tool the model may call. Parameters is the raw
-- JSON Schema string (same shape as Request.ResponseSchema).
export type ToolSchema = {
  name: string,
  description: string,
  parameters: string
}

-- CacheBreakpoint is one opt-in prompt-cache hint (M-AI-PROMPT-CACHING, v0.18.4).
-- Empty list = no caching, bit-for-bit identical wire shape to today.
--
--   position : "system" | "last_user" | "tool_result"
--              Phase 1 supports "system" only (others reserved for Phase 2).
--   ttl      : "ephemeral" | "5m"
--              Anthropic ephemeral = ~5min server TTL; longer Anthropic tiers TBD.
--              Providers without TTL choices ignore this field.
--
-- Per-provider behavior (from Go-side ai.CacheBreakpoint docs):
--   Anthropic: stamps cache_control:{type:"ephemeral"} on the matching
--              content block. Inspect StepResult.cache_read_input_tokens
--              to verify cache hits on subsequent turns.
--   OpenAI:    NO-OP (auto-caches prompts >=1024 tokens). Emits one-shot
--              session warning so callers know hints were ignored.
--   Gemini:    NO-OP for v0.18.4. Explicit CachedContent API deferred.
--   OpenRouter: dispatches based on model-string prefix.
--   Ollama:    silent NO-OP (local model).
export type CacheBreakpoint = {
  position: string,
  ttl: string
}

-- StepResult is what one agent turn produces. When tool_calls is non-empty,
-- the loop driver should dispatch each ToolCall, append the results as
-- tool-role messages, and call step again. When tool_calls is empty AND
-- finish_reason is "stop", the loop terminates.
--
-- finish_reason : "stop" | "tool_calls" | "length" | "error"
--
-- cache_read_input_tokens / cache_creation_input_tokens surface upstream
-- prompt-cache telemetry: Anthropic populates both; OpenAI + Gemini fill
-- cache_read only (their APIs don't surface a separate cache-write count);
-- providers without prompt caching leave both at 0. Useful for eval-harness
-- cost telemetry that distinguishes cold-cache vs warm-cache per-step costs.
export type StepResult = {
  message: Message,
  tool_calls: [ToolCall],
  finish_reason: string,
  input_tokens: int,
  output_tokens: int,
  cache_read_input_tokens: int,
  cache_creation_input_tokens: int
}

-- ============================================================================
-- Result-returning single-shot calls (typed errors)
-- ============================================================================
--
-- These bring the non-streaming AI surface to parity with v0.15.1's
-- callStream (which already returns Result[string, AIError]). Existing
-- call/callJson/callJsonSimple stay as-is for back-compat — new code
-- should prefer the Result variants.

-- callResult: Result-returning variant of call.
-- On success returns Ok(text); on failure returns Err(AIError).
export func callResult(input: string) -> Result[string, AIError] ! {AI} =
  _ai_call_result(input)

-- callJsonResult: Result-returning variant of callJson.
-- Same schema-enforced JSON output, but typed errors via Err(AIError).
export func callJsonResult(input: string, schema: string)
  -> Result[string, AIError] ! {AI} =
  _ai_call_json_result(input, schema)

-- ============================================================================
-- Multi-turn / tool-aware step
-- ============================================================================
--
-- step: One agent turn. Takes a conversation + optional tool catalog,
-- returns the assistant's response. Loop drivers (e.g. runTools below)
-- dispatch any returned tool_calls and call step again with the results
-- appended as tool-role messages.
--
-- Pass model="" to use the handler-bound model.
export func step(
  model: string,
  messages: [Message],
  tools: [ToolSchema]
) -> Result[StepResult, AIError] ! {AI} =
  _ai_step(model, messages, tools)

-- stepWithCache: cache-aware variant of step (M-AI-PROMPT-CACHING, v0.18.4).
--
-- Identical to step except it accepts an opt-in list of CacheBreakpoint hints
-- that providers interpret per their own caching contract. Empty list ([])
-- produces bit-for-bit identical behavior to step.
--
-- Typical usage — cache a stable system prompt across many turns:
--
--   let breakpoints = [{ position: "system", ttl: "ephemeral" }];
--   match stepWithCache(model, messages, tools, breakpoints) {
--     Ok(r) => -- r.cache_read_input_tokens > 0 on warm turns
--     Err(e) => ...
--   }
--
-- See CacheBreakpoint type for per-provider behavior.
export func stepWithCache(
  model: string,
  messages: [Message],
  tools: [ToolSchema],
  cache_breakpoints: [CacheBreakpoint]
) -> Result[StepResult, AIError] ! {AI} =
  _ai_step_with_cache(model, messages, tools, cache_breakpoints)

-- ============================================================================
-- Streaming variant (M-AI-STEP-STREAMING, v0.18.7)
-- ============================================================================

-- StreamChunk is one event emitted by stepWithStream's on_chunk callback
-- as the SSE stream drains.
--
-- v0.18.7 (Phase 1):     ContentDelta + Usage
-- v0.18.8 (this file):   + ThinkingDelta — surfaces Anthropic extended-
--                          thinking, OpenAI o1/o3 reasoning_content, and
--                          Gemini thought parts as a separate stream
-- Future (Phase 2):       + ToolCallDelta — partial tool_use blocks
--                          (requires per-provider JSON-fragment buffering)
--
-- Variant semantics:
--   ContentDelta(text)   — assistant-visible text fragment. Concatenation
--                          of all ContentDelta payloads equals
--                          StepResult.message.content.
--   ThinkingDelta(text)  — model reasoning fragment. NOT included in
--                          StepResult.message.content. Total
--                          reasoning-token count surfaces via
--                          StepResult.reason_tokens (for cost telemetry).
--                          Render in a separate UI surface or log
--                          channel; safe to drop entirely if you don't
--                          want to expose reasoning to end users.
--   Usage({...})         — terminal token-count summary. Fires once per
--                          stream, near the end.
--
-- Per-provider behavior:
--   Anthropic (direct/Bedrock/Vertex):
--     ContentDelta per text content_block_delta event.
--     ThinkingDelta per content_block_delta of type thinking_delta
--     (only when extended thinking is enabled on the request).
--     Usage from message_delta.
--   OpenAI:
--     ContentDelta per delta.content fragment.
--     ThinkingDelta per delta.reasoning_content fragment (o1/o3 models).
--     Usage from final chunk (when stream_options.include_usage:true).
--   OpenRouter:
--     Anthropic/* prefix → Anthropic shape via OR's translation.
--     OpenAI/* prefix    → OpenAI shape.
--   Gemini (AI Studio + Vertex):
--     ContentDelta per text part.
--     ThinkingDelta per part with thought:true flag.
--     Usage at end-of-stream (final chunk's authoritative usageMetadata).
--   Ollama / config-driven providers:
--     NO-OP fallback — calls stepWithCache and fires one synthetic
--     ContentDelta(full_text) + one Usage. No ThinkingDelta surfaces.
export type StreamChunk =
    ContentDelta(string)
  | ThinkingDelta(string)
  | Usage({
      input_tokens: int,
      output_tokens: int,
      cache_read_input_tokens: int,
      cache_creation_input_tokens: int
    })

-- stepWithStream: streaming variant of stepWithCache.
--
-- Identical to stepWithCache except for a 5th argument: a callback invoked
-- once per StreamChunk as the SSE stream drains. The final return is the
-- same Ok(StepResult)/Err(AIError) shape as stepWithCache — the callback
-- is purely a side-channel for incremental rendering.
--
-- Typical usage — token-by-token TUI rendering with separate thinking
-- panel:
--
--   -- match-in-lambda is a known parser bug, so factor the chunk
--   -- handler out into a top-level function (see runnable/ai_streaming.ail).
--   func render(chunk: StreamChunk) -> () ! {IO} {
--     match chunk {
--       ContentDelta(text)  => print(text),               -- main pane
--       ThinkingDelta(text) => printThinking(text),       -- side pane
--       Usage(_)            => println("")
--     }
--   }
--
--   match stepWithStream(model, messages, [], breakpoints, render) {
--     Ok(r) => -- r.Text holds the full accumulated CONTENT (not thinking)
--     Err(e) => ...
--   }
--
-- ThinkingDelta only fires when the underlying provider+model emits
-- API-level reasoning (Anthropic extended-thinking, OpenAI o1/o3
-- reasoning_content, Gemini thought parts). Models that embed
-- <thinking>...</thinking> tags inside their content stream (glm-5,
-- deepseek-r1, etc.) deliver reasoning via ContentDelta — strip with
-- a tag-aware splitter on the consumer side if you want to separate
-- them.
--
-- The callback's effect row is open (`\!{IO}` is typical but not required).
-- Errors thrown from the callback are recorded as trace events but do NOT
-- abort the SSE drain — the caller still receives a complete StepResult.
--
-- For providers without native streaming, the callback fires exactly twice:
-- once with ContentDelta(full_text) then once with Usage(...).
export func stepWithStream(
  model: string,
  messages: [Message],
  tools: [ToolSchema],
  cache_breakpoints: [CacheBreakpoint],
  on_chunk: (StreamChunk) -> () ! {IO}
) -> Result[StepResult, AIError] ! {AI} =
  _ai_step_with_stream(model, messages, tools, cache_breakpoints, on_chunk)

-- runTools: convenience loop driver for multi-turn tool dispatch.
--
-- Calls step in a loop until the model returns finish_reason != "tool_calls"
-- or step_budget reaches 0. For each tool_call the model emits, dispatch is
-- called with the ToolCall and the returned string becomes the tool-role
-- message content fed back on the next turn.
--
-- Returns Ok(messages) — the FULL final conversation including the original
-- input plus every assistant + tool message produced during the loop. The
-- caller can extract the last assistant message, the full transcript, or
-- whatever shape they need.
--
-- Errors:
--   - step_budget exhausted     -> Err(AIError{Internal, retryable=false})
--   - any step returns Err(e)   -> Err(e) propagated verbatim
--
-- Effect row: declared as ! {AI}. The dispatch callback's effects (if any)
-- propagate via row polymorphism — pass a dispatch with effects {FS, Process}
-- and the runTools call site will infer ! {AI, FS, Process} automatically.
export func runTools(
  model: string,
  messages: [Message],
  tools: [ToolSchema],
  dispatch: (ToolCall) -> string,
  step_budget: int
) -> Result[[Message], AIError] ! {AI} {
  if step_budget <= 0
  then Err({
    code: "Internal",
    message: "runTools: step budget exhausted",
    retryable: false
  })
  else match step(model, messages, tools) {
    Err(e) => Err(e),
    Ok(result) =>
      if result.finish_reason != "tool_calls"
      then Ok(messages ++ [result.message])
      else {
        let toolMessages = dispatchToolCalls(result.tool_calls, dispatch);
        let nextMessages = (messages ++ [result.message]) ++ toolMessages;
        runTools(model, nextMessages, tools, dispatch, step_budget - 1)
      }
  }
}

-- dispatchToolCalls runs the dispatch callback once per ToolCall and
-- constructs a tool-role Message for each result. The Message.tool_call_id
-- carries the matching ToolCall.id so the model can correlate which
-- response corresponds to which call on the next turn.
--
-- Note: not exported — internal helper for runTools. Effect row inferred
-- from dispatch's row.
func dispatchToolCalls(
  calls: [ToolCall],
  dispatch: (ToolCall) -> string
) -> [Message] {
  match calls {
    [] => [],
    [call, ...rest] => {
      let result = dispatch(call);
      let msg: Message = {
        role: "tool",
        content: result,
        tool_calls: [],
        tool_call_id: call.id
      };
      [msg] ++ dispatchToolCalls(rest, dispatch)
    }
  }
}

-- ============================================================================
-- Legacy single-shot calls (pre-v0.17.0 — kept for back-compat)
-- ============================================================================

-- call: Call the AI oracle with a string input
-- Input is typically JSON-encoded context
-- Output is typically JSON-encoded response
export func call(input: string) -> string ! {AI} = _ai_call(input)

-- callJson: Call the AI oracle requesting schema-enforced JSON output
-- The provider enforces the schema on the response.
-- Returns the raw JSON string. Use std/json.decode to parse.
export func callJson(input: string, schema: string) -> string ! {AI} =
  _ai_call_json(input, schema)

-- callJsonSimple: Call the AI oracle requesting valid JSON (no schema)
-- The provider returns valid JSON but without schema enforcement.
-- Returns the raw JSON string. Use std/json.decode to parse.
export func callJsonSimple(input: string) -> string ! {AI} =
  _ai_call_json_simple(input)

-- callImage: Generate an image via AI and save to file
-- Calls an image generation model (e.g., Gemini gemini-2.5-flash-image)
-- and writes the resulting PNG/JPEG to output_path.
-- Options is a JSON string: {"aspect_ratio": "16:9", "mime_type": "image/png"}
-- Returns the output path on success.
-- Requires both AI and FS capabilities.
export func callImage(prompt: string, output_path: string, options: string) -> string ! {AI, FS} =
  _ai_call_image(prompt, output_path, options)

-- callImageBase64: Generate an image via AI and return as base64 JSON
-- Returns a JSON string: {"base64": "...", "mime_type": "image/png"}
-- Use std/bytes.fromBase64 to decode the base64 data to bytes.
-- Only requires AI capability (no file system access).
export func callImageBase64(prompt: string, options: string) -> string ! {AI} =
  _ai_call_image_base64(prompt, options)
