-- std/ai.ail
-- AI effect for general-purpose AI oracle calls
--
-- The AI effect is AILANG's general-purpose AI oracle - an opaque,
-- host-provided effect for calling external AI/ML systems. Use cases:
--   - Game NPC decision-making (via typed wrappers)
--   - CLI tools with AI assistance
--   - Agents written in AILANG calling LLMs
--   - Data analysis pipelines with AI steps
--
-- The interface is intentionally simple: string -> string
-- By convention, JSON is used for input/output, but not enforced.
--
-- Usage:
--   import std/ai as AI
--   import std/json (Json, decode)
--   import std/result (Result, Ok, Err)
--
--   -- Unstructured: string -> string
--   let resp = AI.call("What is the capital of France?")
--
--   -- Structured JSON (schema-enforced, provider validates):
--   let raw = AI.callJson("Return name and age", "{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"age\":{\"type\":\"integer\"}}}")
--   let result = decode(raw)
--
--   -- Structured JSON (no schema, just valid JSON):
--   let raw = AI.callJsonSimple("Return [1,2,3] as JSON")
--   let result = decode(raw)
--
-- IMPORTANT: Host must configure AIHandler explicitly:
--   - game.NewStubAIHandler() for testing
--   - Your custom handler for production (e.g., OpenAI, local LLM)
--   - Nil handler = error (no silent fallbacks)
--
-- ## Token streaming (v0.15.0+)
--
-- For SSE token streaming via the M-AI-PROVIDER-CONFIG registry, see
-- `std/ai/streaming` — exposes `openaiCompatStream` and `anthropicStream`
-- which dispatch to a registered config-driven provider with full AI cap +
-- budget tracking. Recipes for OpenAI, OpenRouter, and Anthropic live at
-- `docs/recipes/ai-token-streaming`.
--
-- ## Custom providers
--
-- To add a new AI provider as a package (no Go code, no binary fork), see
-- the `[[ai_provider]]` block in `ailang.toml` and the guide at
-- `docs/guides/custom-ai-providers`. Streaming providers in v0.15.0+ also
-- declare an `[ai_provider.streaming]` sub-block consumed by std/ai/streaming.

module std/ai

import std/result (Result, Ok, Err)

-- ============================================================================
-- Multi-turn / tool-aware types (M-AI-TOOL-LOOP, v0.17.0)
-- ============================================================================
--
-- AIError is the canonical typed error returned by Result-returning AI calls.
-- Shape mirrors std/ai/streaming.AIError byte-for-byte. Field semantics:
--   code      : one of AuthFailed | RateLimit | Timeout | ConnectionFailed |
--               BudgetExhausted | ProviderNotFound | CapabilityNotSupported |
--               ProtocolError | ModelNotAllowed | ContextLength |
--               SchemaValidation | ToolsNotSupported | ModelNotFound | Internal
--   message   : human-readable, may include provider name verbatim
--   retryable : true for transient/network/load conditions; false for
--               configuration / auth / schema mismatches
export type AIError = {
  code: string,
  message: string,
  retryable: bool
}

-- ToolCall is one tool invocation emitted by the model in a step response.
-- The host dispatches it (looking up `name` in the registered tool catalog),
-- then feeds the result back as a Message with role="tool" and tool_call_id
-- matching this id.
--
-- arguments is JSON-encoded as a string — caller decodes per the advertised
-- parameters schema.
export type ToolCall = {
  id: string,
  name: string,
  arguments: string
}

-- Message is one entry in a multi-turn conversation.
--   role         : "user" | "assistant" | "tool" | "system"
--   content      : prose; may be empty for assistant messages whose tool_calls
--                  is non-empty
--   tool_calls   : assistant only — invocations the model emitted
--   tool_call_id : "tool" role only — references a prior ToolCall.id
export type Message = {
  role: string,
  content: string,
  tool_calls: [ToolCall],
  tool_call_id: string
}

-- ToolSchema declares one tool the model may call. Parameters is the raw
-- JSON Schema string (same shape as Request.ResponseSchema).
export type ToolSchema = {
  name: string,
  description: string,
  parameters: string
}

-- StepResult is what one agent turn produces. When tool_calls is non-empty,
-- the loop driver should dispatch each ToolCall, append the results as
-- tool-role messages, and call step again. When tool_calls is empty AND
-- finish_reason is "stop", the loop terminates.
--
-- finish_reason : "stop" | "tool_calls" | "length" | "error"
export type StepResult = {
  message: Message,
  tool_calls: [ToolCall],
  finish_reason: string,
  input_tokens: int,
  output_tokens: int
}

-- ============================================================================
-- Result-returning single-shot calls (typed errors)
-- ============================================================================
--
-- These bring the non-streaming AI surface to parity with v0.15.1's
-- callStream (which already returns Result[string, AIError]). Existing
-- call/callJson/callJsonSimple stay as-is for back-compat — new code
-- should prefer the Result variants.

-- callResult: Result-returning variant of call.
-- On success returns Ok(text); on failure returns Err(AIError).
export func callResult(input: string) -> Result[string, AIError] ! {AI} =
  _ai_call_result(input)

-- callJsonResult: Result-returning variant of callJson.
-- Same schema-enforced JSON output, but typed errors via Err(AIError).
export func callJsonResult(input: string, schema: string)
  -> Result[string, AIError] ! {AI} =
  _ai_call_json_result(input, schema)

-- ============================================================================
-- Multi-turn / tool-aware step
-- ============================================================================
--
-- step: One agent turn. Takes a conversation + optional tool catalog,
-- returns the assistant's response. Loop drivers (e.g. runTools, M6)
-- dispatch any returned tool_calls and call step again with the results
-- appended as tool-role messages.
--
-- Pass model="" to use the handler-bound model.
export func step(
  model: string,
  messages: [Message],
  tools: [ToolSchema]
) -> Result[StepResult, AIError] ! {AI} =
  _ai_step(model, messages, tools)

-- ============================================================================
-- Legacy single-shot calls (pre-v0.17.0 — kept for back-compat)
-- ============================================================================

-- call: Call the AI oracle with a string input
-- Input is typically JSON-encoded context
-- Output is typically JSON-encoded response
export func call(input: string) -> string ! {AI} = _ai_call(input)

-- callJson: Call the AI oracle requesting schema-enforced JSON output
-- The provider enforces the schema on the response.
-- Returns the raw JSON string. Use std/json.decode to parse.
export func callJson(input: string, schema: string) -> string ! {AI} =
  _ai_call_json(input, schema)

-- callJsonSimple: Call the AI oracle requesting valid JSON (no schema)
-- The provider returns valid JSON but without schema enforcement.
-- Returns the raw JSON string. Use std/json.decode to parse.
export func callJsonSimple(input: string) -> string ! {AI} =
  _ai_call_json_simple(input)

-- callImage: Generate an image via AI and save to file
-- Calls an image generation model (e.g., Gemini gemini-2.5-flash-image)
-- and writes the resulting PNG/JPEG to output_path.
-- Options is a JSON string: {"aspect_ratio": "16:9", "mime_type": "image/png"}
-- Returns the output path on success.
-- Requires both AI and FS capabilities.
export func callImage(prompt: string, output_path: string, options: string) -> string ! {AI, FS} =
  _ai_call_image(prompt, output_path, options)

-- callImageBase64: Generate an image via AI and return as base64 JSON
-- Returns a JSON string: {"base64": "...", "mime_type": "image/png"}
-- Use std/bytes.fromBase64 to decode the base64 data to bytes.
-- Only requires AI capability (no file system access).
export func callImageBase64(prompt: string, options: string) -> string ! {AI} =
  _ai_call_image_base64(prompt, options)
