-- std/zip - ZIP archive reading, writing, and streaming
--
-- Read and write entries in ZIP archives (including .docx, .xlsx, .pptx).
-- Stream XML entries via fold for memory-efficient processing (v0.11.0).
--
-- Requires: FS capability (--caps FS)
--
-- Security: Path traversal rejected, 10K entry limit, 100MB decompressed size limit.
--
-- Usage:
--   import std/zip (listEntries, readEntry, readEntryBytes, scanFold, createArchive)
--   match listEntries("archive.zip") {
--     Ok(entries) => println(show(entries)),
--     Err(msg) => println(msg)
--   }

module std/zip

import std/result (Result)
import std/xml (XmlNode)
import std/iter (FoldStep, Continue, Stop)

-- List all entry paths in a ZIP archive
-- Returns Ok([string]) with entry names, or Err(message)
-- @requires FS capability
-- @sandbox Respects AILANG_FS_SANDBOX
export func listEntries(path: string) -> Result[List[string], string] ! {FS} = _zip_listEntries(path)

-- Read a text entry (UTF-8) from a ZIP archive
-- Returns Ok(string) with entry content, or Err(message)
-- @requires FS capability
-- @sandbox Respects AILANG_FS_SANDBOX
export func readEntry(path: string, entry: string) -> Result[string, string] ! {FS} = _zip_readEntry(path, entry)

-- Read a binary entry as base64-encoded string from a ZIP archive
-- Returns Ok(string) with base64 content, or Err(message)
-- @requires FS capability
-- @sandbox Respects AILANG_FS_SANDBOX
export func readEntryBytes(path: string, entry: string) -> Result[string, string] ! {FS} = _zip_readEntryBytes(path, entry)

-- M-STREAMING-ZIP-XML: Streaming ZIP+XML fold

-- Stream a ZIP entry through an XML parser, folding over matching elements.
-- The decompressed XML is never held entirely in memory.
-- Memory: O(largest element + accumulator), not O(entire decompressed entry).
--
-- COST MODEL:
--   scanFold(path, entry, tag, init, f)  O(n) scan, O(1) memory per element
--   Peak memory: ~4 KB XML buffer + accumulator size
-- @requires FS capability
-- @sandbox Respects AILANG_FS_SANDBOX
export func scanFold[a](path: string, entry: string, tag: string,
                        init: a, f: (a, XmlNode) -> a) -> Result[a, string] ! {FS} = _zip_xml_scanFold(path, entry, tag, init, f)

-- Bounded variant: handler returns FoldStep[a] = Continue(a) | Stop(a).
-- Returning Stop(acc') halts the scan without reading the rest of the entry.
-- Critical for extracting a small prefix from a large XLSX sheet.
--
-- COST MODEL:
--   scanFoldStep(path, entry, tag, init, f)  O(prefix) scan, stops on Stop(_)
-- @requires FS capability
export func scanFoldStep[a](path: string, entry: string, tag: string,
                            init: a, f: (a, XmlNode) -> FoldStep[a]) -> Result[a, string] ! {FS} =
  _zip_xml_scanFoldStep(path, entry, tag, init, f)

-- M-DOCPARSE-DX M4: ZIP write capabilities

-- Create a ZIP archive from a list of entries
-- Each entry is {name: string, content: string}
-- Returns Ok(()) on success, Err(message) on failure
-- @requires FS capability
-- @sandbox Respects AILANG_FS_SANDBOX
export func createArchive(path: string, entries: [{name: string, content: string}]) -> Result[(), string] ! {FS} = _zip_createArchive(path, entries)

-- Create a ZIP archive with binary entries (base64-encoded data)
-- Each entry is {name: string, data: string} where data is base64
-- For embedding images, fonts, or other binary content in DOCX/PPTX
-- @requires FS capability
-- @sandbox Respects AILANG_FS_SANDBOX
export func createArchiveWithBytes(path: string, entries: [{name: string, data: string}]) -> Result[(), string] ! {FS} = _zip_createArchiveWithBytes(path, entries)
