-- Standard library: Network operations
-- Run with: ailang run --caps Net <file>

module std/net

import std/result (Result)

-- Network error types
--
-- Migration note (httpRequest Err changed from `string` to `NetError` in v0.25.0):
-- to turn an error into a string (e.g. to build a JSON error payload), use `show(e)` —
-- it renders any NetError variant, so `js(e)` becomes `js(show(e))`:
--     Err(e) => encode(jo([kv("error", js(show(e)))]))
-- To branch on the cause instead, match the variants (see the httpRequest example below).
export type NetError =
  | Transport(string)      -- DNS, timeout, TLS, connection errors
  | DisallowedHost(string) -- Domain not in allowlist
  | InvalidHeader(string)  -- Blocked or malformed header
  | BodyTooLarge(string)   -- Response exceeds size limit

-- HTTP response with full metadata
export type HttpResponse = {
  status: int,                           -- HTTP status code (200, 404, etc.)
  headers: List[{name: string, value: string}], -- Response headers (preserved order)
  body: string,                          -- Response body as UTF-8 (lossy for binary payloads)
  bodyBytes: bytes,                      -- Response body as raw bytes (always exact)
  ok: bool                               -- true if status 200-299
}

-- HTTP GET request (deprecated: use httpRequest for status codes/headers)
--
-- Fetches content from an HTTP/HTTPS URL.
-- Implemented as a wrapper around httpRequest for backward compatibility.
--
-- Security features:
--   - HTTPS enforced by default (http:// requires --net-allow-http)
--   - DNS rebinding prevention
--   - IP blocking (localhost, private IPs, link-local)
--   - Redirect validation (max 5 redirects)
--   - Body size limits (5MB default)
--   - Domain allowlist support
--
-- Args:
--   url: String - The URL to fetch (must be https:// unless http allowed)
--
-- Returns:
--   String - The response body
--
-- Errors:
--   E_NET_CAP_MISSING - Net capability not granted
--   E_NET_PROTOCOL_BLOCKED - Unsupported/blocked protocol
--   E_NET_IP_BLOCKED - Blocked IP address (localhost/private/link-local)
--   E_NET_DOMAIN_BLOCKED - Domain not in allowlist
--   E_NET_DNS_REBINDING - DNS resolves to blocked IP
--   E_NET_TOO_MANY_REDIRECTS - Exceeded redirect limit
--   E_NET_BODY_TOO_LARGE - Response exceeds size limit
--   E_NET_REQUEST_FAILED - HTTP request failed
--
-- Example:
--   let html = httpGet("https://example.com")
export func httpGet(url: string) -> string ! {Net} =
  match httpRequest("GET", url, [], "") {
    Ok(resp) => resp.body,
    Err(Transport(msg)) => "E_NET_REQUEST_FAILED: ${msg}",
    Err(DisallowedHost(host)) => "E_NET_DOMAIN_BLOCKED: ${host}",
    Err(InvalidHeader(hdr)) => "E_NET_INVALID_HEADER: ${hdr}",
    Err(BodyTooLarge(size)) => "E_NET_BODY_TOO_LARGE: ${size}"
  }

-- HTTP POST request
--
-- Sends an HTTP POST request with the given body.
-- Sets Content-Type: application/json by default.
-- Implemented as a wrapper around httpRequest for backward compatibility.
--
-- Security features: Same as httpGet()
--
-- Args:
--   url: String - The URL to POST to
--   body: String - The request body (typically JSON)
--
-- Returns:
--   String - The response body
--
-- Errors: Same as httpGet()
--
-- Example:
--   let response = httpPost("https://api.example.com/data", "{\"key\": \"value\"}")
export func httpPost(url: string, body: string) -> string ! {Net} =
  let headers = [{name: "Content-Type", value: "application/json"}] in
  match httpRequest("POST", url, headers, body) {
    Ok(resp) => resp.body,
    Err(Transport(msg)) => "E_NET_REQUEST_FAILED: ${msg}",
    Err(DisallowedHost(host)) => "E_NET_DOMAIN_BLOCKED: ${host}",
    Err(InvalidHeader(hdr)) => "E_NET_INVALID_HEADER: ${hdr}",
    Err(BodyTooLarge(size)) => "E_NET_BODY_TOO_LARGE: ${size}"
  }

-- HTTP request with custom headers and structured errors (v0.3.8+)
--
-- Advanced HTTP client with full control over method, headers, and error handling.
--
-- Security features:
--   - Same as httpGet() plus:
--   - Header validation (blocks hop-by-hop, Host override, etc.)
--   - Authorization stripped on cross-origin redirects
--   - Method whitelist (GET, POST only in v0.3.8)
--
-- Args:
--   method: String - HTTP method ("GET", "POST")
--   url: String - Target URL
--   headers: List[{name, value}] - Custom headers (Authorization, Content-Type, etc.)
--   body: String - Request body (empty for GET)
--
-- Returns:
--   Result[HttpResponse, NetError] - Ok(response) or Err(error)
--
-- Error handling:
--   - Transport/DisallowedHost/InvalidHeader/BodyTooLarge → Err(NetError)
--   - HTTP 4xx/5xx → Ok(HttpResponse) with status code
--
-- Example:
--   let headers = [{name: "Authorization", value: "Bearer token"}];
--   match httpRequest("POST", url, headers, body) {
--     Ok(resp) -> if resp.ok then resp.body else "Error: ${show(resp.status)}",
--     Err(Transport(msg)) -> "Network error: ${msg}",
--     Err(DisallowedHost(host)) -> "Blocked: ${host}",
--     Err(InvalidHeader(hdr)) -> "Bad header: ${hdr}",
--     Err(BodyTooLarge(size)) -> "Too large: ${size}"
--   }
--
-- IMPORTANT: Ok(resp) captures the FULL HttpResponse record.
-- Use resp.body to get the response body string.
-- Use resp.status for the HTTP status code.
-- Do NOT pass resp directly to decode() — use decode(resp.body).
export func httpRequest(
  method: string,
  url: string,
  headers: List[{name: string, value: string}],
  body: string
) -> Result[HttpResponse, NetError] ! {Net} {
  _net_httpRequest(method, url, headers, body)
}

-- HTTP request with raw bytes body (binary upload)
--
-- Like httpRequest, but the body is raw bytes. Use for binary uploads
-- (images, PDFs, audio) or any protocol that needs exact byte-level control.
--
-- Defaults Content-Type to "application/octet-stream" if you don't supply one.
-- Sets explicit Content-Length (no chunked encoding) — required by many
-- binary-upload servers (S3, LinkedIn images, etc.).
--
-- Security features: Same as httpRequest()
--
-- Args:
--   method: String - HTTP method ("PUT", "POST", etc.)
--   url: String - Target URL
--   headers: List[{name, value}] - Custom headers
--   body: bytes - Raw bytes payload
--
-- Returns:
--   Result[HttpResponse, NetError] — resp.bodyBytes has the raw response payload
--
-- Example (LinkedIn-style image upload):
--   import std/fs (readFileBytes)
--   import std/bytes (fromBase64)
--
--   match readFileBytes("photo.png") {
--     Ok(b64) => match fromBase64(b64) {
--       Some(imgBytes) => match httpRequestBytes("PUT", uploadUrl, [], imgBytes) {
--         Ok(resp) => if resp.ok then "uploaded" else "status: ${show(resp.status)}",
--         Err(_) => "upload failed"
--       },
--       None => "decode failed"
--     },
--     Err(e) => "read failed: ${e}"
--   }
export func httpRequestBytes(
  method: string,
  url: string,
  headers: List[{name: string, value: string}],
  body: bytes
) -> Result[HttpResponse, NetError] ! {Net} {
  _net_httpRequestBytes(method, url, headers, body)
}

-- Percent-encode a string for use in a URL (path, query, fragment, or form value).
--
-- Encodes per RFC 3986: space becomes %20, reserved chars (= & + / etc.) are
-- percent-encoded, unreserved chars (A-Z a-z 0-9 - _ . ~) pass through. Safe
-- to use in any URL position.
--
-- For building a full application/x-www-form-urlencoded body from {name,value}
-- pairs, use urlEncodeForm — it encodes space as + per the WHATWG form spec,
-- which is what HTTP servers expect for form bodies.
--
-- Pure function: no Net capability needed.
--
-- Examples:
--   urlEncode("hello world")        -- "hello%20world"
--   urlEncode("a/b=c+d&e")          -- "a%2Fb%3Dc%2Bd%26e"
--   urlEncode("café")               -- "caf%C3%A9"
export func urlEncode(s: string) -> string {
  _net_url_encode(s)
}

-- Build an application/x-www-form-urlencoded body from {name,value} records.
--
-- Encodes space as + (WHATWG form spec — what HTTP servers expect for form
-- bodies). Other unsafe characters are percent-encoded. Keys are sorted
-- alphabetically (Go url.Values.Encode behavior); if you need order-preserving
-- output for signing schemes (AWS SigV4, OAuth1.0a), build the body manually
-- with urlEncode on each value.
--
-- Pure function: no Net capability needed. Pass the result as the `body`
-- argument to httpRequest along with a
-- {name: "Content-Type", value: "application/x-www-form-urlencoded"} header.
--
-- Example (LinkedIn OAuth2 token exchange):
--   let body = urlEncodeForm([
--     {name: "grant_type",    value: "authorization_code"},
--     {name: "code",          value: code},
--     {name: "client_id",     value: clientId},
--     {name: "client_secret", value: clientSecret},
--     {name: "redirect_uri",  value: redirectUri}
--   ])
export func urlEncodeForm(params: List[{name: string, value: string}]) -> string {
  _net_url_encode_form(params)
}
