{
  "name": "ailang-docs",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "sync-prompt": "bash scripts/sync-active-prompt.sh",
    "sync-design-docs": "bash scripts/sync-design-docs.sh",
    "check-stdlib-index": "bash scripts/check-stdlib-index.sh",
    "sync-all": "npm run sync-prompt && npm run sync-design-docs && npm run check-stdlib-index",
    "start": "npm run sync-all && docusaurus start",
    "build": "npm run sync-all && docusaurus build",
    "test:benchmarks": "node --test src/lib/benchmarkEvidence.test.mjs src/lib/benchmarkHistory.test.mjs src/components/BenchmarkPerformance/render.test.cjs",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "@mermaid-js/layout-elk": "^0.1.9",
    "clsx": "^2.0.0",
    "lucide-react": "^1.58.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "raw-loader": "^4.0.2"
  },
  "engines": {
    "node": ">=20.0"
  },
  "overrides": {
    "tinypool": "^2.1.2",
    "postcss-selector-parser": "^7.1.7",
    "serialize-javascript": "^7.0.5",
    "qs": "^6.16.0",
    "uuid": "^11.1.1",
    "katex": "^0.18.2"
  }
}
