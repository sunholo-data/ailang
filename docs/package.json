{
  "name": "ailang-docs",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "sync-prompt": "bash scripts/sync-active-prompt.sh",
    "sync-design-docs": "bash scripts/sync-design-docs.sh",
    "check-stdlib-index": "bash scripts/check-stdlib-index.sh",
    "sync-all": "npm run sync-prompt && npm run sync-design-docs && npm run check-stdlib-index",
    "start": "npm run sync-all && docusaurus start",
    "build": "npm run sync-all && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.0",
    "@docusaurus/preset-classic": "3.10.0",
    "@docusaurus/theme-mermaid": "3.10.0",
    "@mdx-js/react": "^3.0.0",
    "@mermaid-js/layout-elk": "^0.1.9",
    "clsx": "^2.0.0",
    "lucide-react": "^1.14.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^18.0.0",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.0",
    "@docusaurus/tsconfig": "3.10.0",
    "@docusaurus/types": "3.10.0",
    "raw-loader": "^4.0.2"
  },
  "engines": {
    "node": ">=20.0"
  }
}
