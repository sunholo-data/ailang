module probe_clock
import std/process (exec, ProcessError)
import std/bytes (toString)
import std/io (println)

func showOut(label: string, r: Result[{exitCode: int, resolvedPath: string, stderr: bytes, stdout: bytes, truncated: bool}, ProcessError]) -> () ! {IO} {
  match r {
    Ok(out) => println("[${label}] exit=${show(out.exitCode)} out=${toString(out.stdout)} err=${toString(out.stderr)}"),
    Err(e) => println("[${label}] error=${show(e)}")
  }
}

export func main() -> () ! {IO, Process} {
  -- HEAD commit T = 2026-10-20 10:24:51 +02:00.
  -- --until=R keeps T iff T < now-R  =>  now > T+R  (LOWER bound on now)
  -- --since=R keeps T iff T > now-R  =>  now < T+R  (UPPER bound on now)
  showOut("until now", exec("git", ["log", "--until=now", "--oneline"]));
  showOut("since 1d ago", exec("git", ["log", "--since=1.day.ago", "--oneline"]));
  showOut("since 9h ago", exec("git", ["log", "--since=9.hours.ago", "--oneline"]));
