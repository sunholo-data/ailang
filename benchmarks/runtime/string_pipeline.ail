-- string_pipeline.ail — Phase 2A benchmark: real-world string processing
-- Tests: string operations representative of DocParse-style workloads
-- Expected: process a block of text through multiple transformations

module benchmarks/runtime/string_pipeline

import std/string (split, join, trim, toUpper, toLower, replace, length, contains, startsWith, foldSlices)
import std/list (map, filter, foldl)

-- Simulate processing header lines from an email/HTTP message
pure func processLine(line: string) -> string =
  if startsWith(line, "X-") then toUpper(line)
  else if contains(line, ":") then
    let parts = split(line, ":") in
    join(": ", map(trim, parts))
  else toLower(line)

-- Build sample input: repeated lines simulating real text
pure func buildInput(n: int, acc: [string]) -> [string] =
  if n <= 0 then acc
  else
    let line = if n % 3 == 0 then "X-Custom-Header: value" ++ show(n)
               else if n % 3 == 1 then "Content-Type : text/plain"
               else "some plain text line " ++ show(n) in
    buildInput(n - 1, line :: acc)

export pure func main() -> int =
  let lines = buildInput(500, []) in
  let processed = map(processLine, lines) in
  foldl(\acc s. acc + length(s), 0, processed)
