-- cp_60159 with a visited set: the idiomatic Python shape (visited = set()),
-- written with std/set over (row, col, dir) states (M-PERSISTENT-COLLECTIONS
-- Phase 1; cp_60159.ail is the set-free Floyd reference). 2026-10-28, all 17
-- hidden tests pass: max 3.67s evaluator, 0.38s --strict-bytecode. Set.insert
-- is still O(n) (Phase 2 not landed); the longest hidden-test path is 4,852 states.

module benchmark/solution

import std/io (println, readLine)
import std/string (words, trim, chars, stringToInt)
import std/list (flatMap, take, map)
import std/option (Some, None)
import std/array as A
import std/set as S
import std/set (Set)

func toI(s: string) -> int =
  match stringToInt(s) {
    Some(n) => n,
    None => 0
  }

func dirOf(s: string) -> int =
  if s == "U" then 0 else if s == "R" then 1 else if s == "D" then 2 else 3

func dr(d: int) -> int = if d == 0 then -1 else if d == 2 then 1 else 0

func dc(d: int) -> int = if d == 1 then 1 else if d == 3 then -1 else 0

-- Outside the grid counts as a passage: moving there solves the puzzle.
func isOpen(g: Array[bool], n: int, r: int, c: int) -> bool =
  if r < 0 || r >= n || c < 0 || c >= n then true else A.get(g, r * n + c)

-- First passage among right, front, left, back; -1 if all are walls.
func choose(g: Array[bool], n: int, r: int, c: int, d: int) -> int {
  let cands = [(d + 1) % 4, d, (d + 3) % 4, (d + 2) % 4];
  pick(g, n, r, c, cands)
}

func pick(g: Array[bool], n: int, r: int, c: int, ds: [int]) -> int =
  match ds {
    [] => -1,
    x :: rest => if isOpen(g, n, r + dr(x), c + dc(x)) then x else pick(g, n, r, c, rest)
  }

func walk(g: Array[bool], n: int, r: int, c: int, d: int, seen: Set[(int, int, int)], moves: int) -> int =
  if S.member(seen, (r, c, d)) then -1
  else {
    let nd = choose(g, n, r, c, d);
    if nd < 0 then -1
    else {
      let r2 = r + dr(nd);
      let c2 = c + dc(nd);
      if r2 < 0 || r2 >= n || c2 < 0 || c2 >= n then moves + 1
      else walk(g, n, r2, c2, nd, S.insert(seen, (r, c, d)), moves + 1)
    }
  }

func readRows(k: int, acc: [string]) -> [string] ! {IO} =
  if k <= 0 then acc else readRows(k - 1, trim(readLine()) :: acc)

func queries(g: Array[bool], n: int, q: int) -> () ! {IO} =
  if q <= 0 then ()
  else {
    let ws = words(readLine());
    match ws {
      [rs, cs, ds] => println(show(walk(g, n, toI(rs) - 1, toI(cs) - 1, dirOf(ds), S.empty(), 0))),
      _ => ()
    };
    queries(g, n, q - 1)
  }

func reverseS(xs: [string], acc: [string]) -> [string] =
  match xs {
    [] => acc,
    x :: rest => reverseS(rest, x :: acc)
  }

export func main() -> () ! {IO} {
  let hdr = words(readLine());
  match hdr {
    [ns, qs] => {
      let n = toI(ns);
      let rows = reverseS(readRows(n, []), []);
      let g = A.fromList(flatMap(\row. map(\ch. ch == ".", take(n, chars(row))), rows));
      queries(g, n, toI(qs))
    },
    _ => ()
  }
}
