# AILANG Agent Executor — opencode variant (opencode CLI, no Go toolchain)
# M-EXECUTOR-VARIANTS: Use for agents running OpenAI models via the opencode CLI.
# Use for: any agent with provider=opencode on non-Go codebases.
ARG PROJECT
FROM europe-west1-docker.pkg.dev/${PROJECT}/ailang/agent-base:latest

# opencode CLI (npm package: opencode-ai, binary: opencode)
USER root
RUN npm install -g opencode-ai
USER ailang

# The image declares the executor CLI it installs. cmd/ailang execute-job
# refuses a task whose AILANG_PROVIDER disagrees, instead of cloning the repo
# and then exec-failing on a binary that was never here (2026-08-27/28).
ENV AILANG_IMAGE_PROVIDER=opencode
