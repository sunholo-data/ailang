# AILANG Dashboard — Collaboration Hub
#
# Runs `ailang serve` which serves the React frontend and
# provides REST API + WebSocket for real-time updates.

# ── Build Go binary ──────────────────────────────────────────
FROM golang:1.26-bookworm AS go-builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .
# Stamp the version from std/VERSION, which is IN the build context and which the
# release smoke gate already asserts equals the tag. Without this the binary
# reports "AILANG dev" and an image can only be identified by digest — measured
# 2026-09-12 inside the promoted prod agent-pi:v0.38.3.
#
# The module path matters: it is github.com/sunholo-data/ailang (see go.mod).
# A -X against a path that does not exist sets nothing and reports no error,
# which is how Dockerfile.registry-validator came to stamp
# github.com/sunholo/ailang/... and silently do nothing, and how the
# release-manager skill once documented -X main.Version.
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w -X github.com/sunholo-data/ailang/internal/version.Version=$(cat std/VERSION)" -o /ailang ./cmd/ailang/

# ── Build React UI ───────────────────────────────────────────
FROM node:22-bookworm-slim AS ui-builder

WORKDIR /ui

COPY ui/package.json ui/package-lock.json ./
RUN npm ci

COPY ui/ .
RUN npm run build

# ── Runtime stage ────────────────────────────────────────────
FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=go-builder /ailang /usr/local/bin/ailang

# The dashboard's transforms (event formatting, heatmap, budget) are AILANG
# modules, and since 2026-09-08 they are the ONLY implementation — the Go copies
# that used to answer when these were missing have been removed. They were
# missing here: this image shipped the binary and no .ail files at all, so the
# AILANG path had never once run in production and the "fallback" was in fact
# the only thing executing. Ship the modules, and their std/ imports.
COPY --from=go-builder /build/internal/dashboard_transforms /app/internal/dashboard_transforms
COPY --from=go-builder /build/std /app/std
ENV AILANG_PROJECT_ROOT=/app

# The React build output is embedded in the Go binary via go:embed,
# but we also copy it separately in case of static file serving.
# The ailang serve command serves from internal/server/dist/ (embedded).

ENV AILANG_STORAGE=gcp
ENV PORT=1957

EXPOSE 1957

ENTRYPOINT ["/usr/local/bin/ailang"]
CMD ["serve", "--port", "1957"]
