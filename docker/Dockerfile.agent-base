# AILANG Agent Base — minimal shared layer for all executor variants.
# Contains: Node 22 + git + ailang binary + bootstrap plugin pre-clone.
# Does NOT contain any executor CLI (claude, gemini, codex, opencode) or Go toolchain.
# All executor-specific images build FROM this.

# ── Build stage ──────────────────────────────────────────────
FROM golang:1.26-bookworm AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .
# Stamp the version from std/VERSION, which is IN the build context and which the
# release smoke gate already asserts equals the tag. Without this the binary
# reports "AILANG dev" and an image can only be identified by digest — measured
# 2026-09-12 inside the promoted prod agent-pi:v0.38.3.
#
# The module path matters: it is github.com/sunholo-data/ailang (see go.mod).
# A -X against a path that does not exist sets nothing and reports no error,
# which is how Dockerfile.registry-validator came to stamp
# github.com/sunholo/ailang/... and silently do nothing, and how the
# release-manager skill once documented -X main.Version.
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w -X github.com/sunholo-data/ailang/internal/version.Version=$(cat std/VERSION)" -o /ailang ./cmd/ailang/

# ── Runtime stage ────────────────────────────────────────────
FROM debian:bookworm-slim

# openssh-client is a *Recommends* of Debian's git, not a dependency, so
# --no-install-recommends leaves it out and `git@host:...` fails at runtime with
# "cannot run ssh: No such file or directory". It is required by the per-agent
# deploy-key path (configureSSHDeployKey) — the only way an agent pushes to a
# repo the fleet token cannot write. Every executor image derives from this one,
# so this is the single place it belongs.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    openssh-client \
    curl \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# Node.js 22 (required by all AI CLI tools: claude, gemini, codex, opencode)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# ailang binary
COPY --from=builder /ailang /usr/local/bin/ailang

# Git identity for automated commits
RUN git config --system user.name "ailang-agent" \
    && git config --system user.email "ailang-agent@noreply.github.com"

# Pre-clone shared skills plugin for faster cold starts (M-CLOUD-PLUGIN-SKILLS, v0.9.1).
# Override at build time: --build-arg AILANG_PLUGIN_REPO=https://github.com/your-org/plugin.git
#
# This clone MUST succeed. The plugin carries the cloud agents' hooks — including
# the git guardrails — so an image built without it runs agents unguarded. It
# used to be `... 2>/dev/null || true`, which turned a throttled clone into a
# silently hook-less image. GitHub throttles anonymous git traffic from Cloud
# Build's egress (measured 2026-09-02), so the clone authenticates when the
# build passes a `github_token` secret (docker buildx build
# --secret id=github_token,env=GITHUB_TOKEN); without one it is anonymous, so
# local builds still work. The helper is passed with -c for this one command
# and nothing is written to the image.
ARG AILANG_PLUGIN_REPO=https://github.com/sunholo-data/ailang_bootstrap.git
RUN --mount=type=secret,id=github_token \
    if [ -s /run/secrets/github_token ]; then \
      git -c credential.helper='!f() { echo username=x-access-token; echo "password=$(cat /run/secrets/github_token)"; }; f' \
          clone --depth 1 ${AILANG_PLUGIN_REPO} /plugins/ailang_bootstrap; \
    else \
      git clone --depth 1 ${AILANG_PLUGIN_REPO} /plugins/ailang_bootstrap; \
    fi

ENV COORDINATOR_MODE=cloud

# Non-root user — Claude Code refuses --dangerously-skip-permissions when running as root.
RUN useradd -m -s /bin/bash ailang \
    && mkdir -p /workspace /plugins \
    && chown -R ailang:ailang /workspace /plugins

USER ailang
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/ailang"]
CMD ["coordinator", "execute-job"]
