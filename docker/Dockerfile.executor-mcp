# Hosted AILANG code executor (M-AILANG-EXECUTOR-GE P1):
#   design_docs/planned/v0_55_0/m-ailang-executor-gemini-enterprise.md
#
# One MCP endpoint serving the public docs tools (mcp_tools/), the built-in
# submit_feedback tool, and the executor tools (executor_tools/): ailang_prompt,
# ailang_check, ailang_run, ailang_eval, ailang_builtins. Untrusted code runs
# in a child `ailang run --policy /srv/executor-policy.toml` (IO only,
# supervised 60s timeout), never in the server process. The server may exec
# only those four ailang subcommands, each bounded at 90s (policy 60s + compile).
#
# Two services run this image (ailang-multivac cloud_run_executor_mcp.tf):
#   * IAM-only, for Gemini Enterprise: the CMD below (/mcp/, no OAuth).
#   * Public OAuth (P1b): terraform replaces the CMD with --mcp-connect-only,
#     --oauth-issuer, --static /srv/executor_oauth/static, --caps adding IO,Net,
#     and the extra executor_oauth/ dir (sunholo/mcp_oauth sign-in server).
FROM golang:1.26.10-bookworm AS builder
WORKDIR /build
COPY go.mod go.sum ./
RUN GOPROXY='https://proxy.golang.org|direct' sh -c 'for i in 1 2 3 4; do go mod download && exit 0; echo "go mod download failed (attempt $i/4); retrying" >&2; sleep $((i * 15)); done; exit 1'
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w -X github.com/sunholo-data/ailang/internal/version.Version=$(cat std/VERSION)" -o /out/ailang ./cmd/ailang/ && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -o /out/build-snapshot ./tools/build-snapshot/
RUN /out/build-snapshot --repo /build --out /out/snapshot
# executor_oauth/ has its own manifest; fetch its registry packages (versions
# and content hashes pinned by its ailang.lock) into /root/.ailang.
RUN cd /build/executor_oauth && /out/ailang lock

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /out/ailang /usr/local/bin/ailang
COPY --from=builder /out/snapshot /srv/snapshot
COPY --from=builder /build/mcp_tools /srv/mcp_tools
COPY --from=builder /build/executor_tools /srv/executor_tools
COPY --from=builder /build/std /srv/std
COPY --from=builder /build/docker/executor-policy.toml /srv/executor-policy.toml
COPY --from=builder /build/executor_oauth /srv/executor_oauth
COPY --from=builder --chown=nonroot:nonroot /root/.ailang /home/nonroot/.ailang
ENV HOME=/home/nonroot
# sunholo/mcp_oauth AGENT.md #1: traces render arguments verbatim, and the
# OAuth routes handle request handles, codes and tokens.
ENV AILANG_TRACE_VALUES=off
ENV MCP_SNAPSHOT_DIR=/srv/snapshot
ENV AILANG_RELAX_MODULES=1
ENV AILANG_STDLIB_PATH=/srv/std
ENV EXECUTOR_POLICY=/srv/executor-policy.toml
ENV EXECUTOR_WORK_DIR=/tmp/ailang-exec
ENV EXECUTOR_AILANG_BIN=/usr/local/bin/ailang
# ai-check would otherwise leave a compile cache in every request dir.
ENV AILANG_NO_CACHE=1
WORKDIR /srv
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/ailang", "serve-api", \
            "--bind", "0.0.0.0", \
            "--mcp-http", "--routes-only", \
            "--process-timeout", "90s", \
            "--process-allowlist", "/usr/local/bin/ailang:prompt,/usr/local/bin/ailang:ai-check,/usr/local/bin/ailang:run,/usr/local/bin/ailang:builtins", \
            "--port", "8080"]
# The IAM-only service. Flags must come before the dirs (Go flag parsing stops
# at the first positional), so per-service flags live here, not in ENTRYPOINT.
CMD ["--caps", "Clock,FS,Env,Process,Rand", "mcp_tools/", "executor_tools/"]
