# AILANG Agent Executor — motoko variant (motoko_agent, no Go toolchain)
# M-MOTOKO-EXECUTOR-ADAPTER: Use for AILANG-native agent runs against any
# OpenRouter-routable model. Use for: cross-harness comparisons (motoko-X vs
# vanilla-X) and open-weight model evaluation (Gemma 4, GLM-5, Qwen, etc.).
#
# Cost-control rule (EXECUTOR_SHAPE.md §8): when this image is deployed as
# a Cloud Run Job, secret bindings MUST exclude ANTHROPIC_API_KEY. Bind only
# OPENROUTER_API_KEY + OPENAI_API_KEY + GEMINI_API_KEY. Claude does NOT run in
# motoko: never via OpenRouter (Mark, 2026-09-29), and Anthropic refuses
# subscription OAuth from anything but Claude Code (429, measured 2026-10-02).

ARG PROJECT
ARG MOTOKO_COMMIT=af1d56513d3ae314bd831fd149c7b6f2503a361c
FROM europe-west1-docker.pkg.dev/${PROJECT}/ailang/agent-base:latest

# motoko_agent setup (NOT a single binary like pi/opencode — it's a bun TUI
# wrapper around scripts/run-agent.sh that drives the AILANG runtime + the
# motoko-ext-* extension packages).
USER root

# Re-declare after FROM so the value is in scope for the ENV bake at the
# bottom of this stage — ARGs declared before FROM don't survive into the
# build stage, which would otherwise bake an empty MOTOKO_COMMIT.
ARG MOTOKO_COMMIT

# unzip is required by the bun installer to extract its release archive.
# agent-base ships only ca-certificates/git/curl/gnupg, so add it here.
RUN apt-get update && apt-get install -y --no-install-recommends unzip \
    && rm -rf /var/lib/apt/lists/*

# Bun runtime. motoko main commits a text bun.lock, which needs bun >= 1.2; this
# is the version the rig runs motoko main with.
RUN curl -fsSL https://bun.sh/install | bash -s "bun-v1.3.14" \
    && mv /root/.bun/bin/bun /usr/local/bin/bun \
    && chmod +x /usr/local/bin/bun

# Check out our pinned fork merge af1d5651 (MOTOKO.md §14):
# sunholo/main-dst-20261027 base 835c738b = upstream main 97244396
# (2026-10-25) plus 21 carried commits, then the approved one-line #1958
# play_chunks callback migration. The callback slot is IO-only, matching
# Ports; the helper's outer IO+Trace row and the Ports ABI are unchanged.
# Source: sunholo-voight-kampff/motoko_agent#4. The live rig remains at
# 835c738b; this Docker source pin does not switch a shared checkout.
# Historical carried features include the ollama stream env forwarding #266.
# Upstream now carries the tool-schema dedupe (#220), repetition_guard's
# tool_call_id fix (#260) and the byte-stable compaction summary (#262), so
# those are upstream's. The rest are ours, as on the previous branch
# sunholo/main-dst-20261002 (upstream 4023bf08):
# the cloud / ollama_microrag / ailang_only profiles with extensions.strict on,
# motoko_ext_ailang_policy (the ailang_only lane), #209 (EditFile mode copy),
# one schema per tool name (duplicate ReadFile/WriteFile/EditFile schemas made
# strict OpenRouter providers answer 400), a path guard that needs no GNU
# `realpath -m`, rig-lease forwarding, and agent.context_limit 262144 on our
# profiles so compaction fires for fleet models the catalogue lacks (e3fa68ec,
# 2026-10-08), and the lane's AILANG teaching prompt + pi's lane guidance
# (b3347a96, 2026-10-12), and repetition_guard in the ailang_only profile
# (a1ece42e, 2026-10-12), whose result comparison now ignores the envelope's
# tool_call_id (6de44ada; upstream arniwesth/motoko_agent#260), and a cost cap
# that prices prompt-cache tokens (d668e630; its env forwarding 84fde7b7), and
# the session identity passed as OPENROUTER_SESSION_ID (aa23bbd1), and a
# byte-stable compaction summary that keeps the prompt cache warm (b1ffa339).
# MOTOKO.md §10. Previous pins: 965f2ec5 (sunholo/main-dst-20261015, 2026-10-16), d5aa3e31 (sunholo/main-dst-20261015), b1ffa339 (sunholo/main-dst-20261002), aa23bbd1, 84fde7b7, d668e630, 6de44ada, a1ece42e, b3347a96, e3fa68ec, de68fddf, 4d4917cd (sunholo/main-dst). Fetch-by-SHA pins the exact commit whatever the
# branch does next.
#
# The fetch authenticates when the build passes a `github_token` secret
# (docker buildx build --secret id=github_token,env=GITHUB_TOKEN — the
# ailang-multivac pipelines and cloudbuild-dev.yaml do). GitHub throttles
# anonymous git traffic from Cloud Build's egress; measured 2026-09-02 as
# "could not read Username for 'https://github.com'", which names credentials
# but is rate limiting. Without the secret the fetch is anonymous, so local
# builds still work. The helper is passed with -c for this one command and
# nothing is written to the image.
RUN --mount=type=secret,id=github_token \
    mkdir -p /opt/motoko_agent && cd /opt/motoko_agent \
    && git init -q \
    && git remote add origin https://github.com/sunholo-voight-kampff/motoko_agent.git \
    && if [ -s /run/secrets/github_token ]; then \
         git -c credential.helper='!f() { echo username=x-access-token; echo "password=$(cat /run/secrets/github_token)"; }; f' \
             fetch --depth=1 origin ${MOTOKO_COMMIT}; \
       else \
         git fetch --depth=1 origin ${MOTOKO_COMMIT}; \
       fi \
    && git checkout FETCH_HEAD

# Install bun deps for the TUI. The package.json lives in src/tui (the repo
# root is an AILANG project — ailang.toml/lock — with no root package.json),
# and run-agent.sh execs the TS source (src/tui/src/index.ts) directly via
# bun, so no tsc `build` step is needed — bun runs TypeScript natively.
RUN cd /opt/motoko_agent/src/tui && bun install --frozen-lockfile || bun install

# Resolve motoko's AILANG dependencies. Its extensions are in-repo path packages
# (packages/motoko-ext-*); `ailang lock` resolves them and fetches the registry
# ones. No `|| true`: a lock that fails here is a motoko that cannot start. The
# old line also ran a bare `ailang install`, which prints usage and exits 0, so
# it never installed anything.
#
# `ailang lock` runs as root, so the registry packages it fetches land in
# /root/.ailang/cache/registry. The runtime user is `ailang`, and since v0.53.1
# (M-PKG-REGISTRY-CONFINEMENT) package setup hashes every registry dependency
# from $HOME/.ailang/cache/registry and stops when one is missing. So hand the
# runtime user its own copy; without it every ailang_only motoko task failed at
# the lane check with "failed to hash registry dependency sunholo/logging"
# (measured on the dev plane 2026-10-19).
RUN cd /opt/motoko_agent && ailang lock \
    && mkdir -p /home/ailang/.ailang/cache \
    && cp -a /root/.ailang/cache/registry /home/ailang/.ailang/cache/ \
    && chown -R ailang:ailang /home/ailang/.ailang

# Warm the AILANG compile cache for the runtime's entry module, so a Cloud Run
# Job (always a cold start) does not recompile motoko on every task. Measured
# 2026-10-13 with ailang #1788: a cold compile of src/core/supervisor.ail takes
# ~76 s; once the cache is warm, `ailang run` of the same entry starts in ~1 s.
# The cache is keyed to the ailang binary, which agent-base installs from the
# same release, so a cache warmed here is the one the runtime reads.
#
# Fail the build loudly rather than ship a cold image: any CACHE_WRITE_FAILED
# (the ARTIFACT_TOO_LARGE regression that #1778/#1788 fixed was exactly this,
# silently, on every run) or a missing session cache aborts the build.
# Runs as root; the runtime user only needs to read it.
RUN cd /opt/motoko_agent \
    && ailang check src/core/supervisor.ail > /tmp/motoko-warm.log 2>&1 \
    || { tail -40 /tmp/motoko-warm.log; exit 1; }; \
    cd /opt/motoko_agent \
    && if grep -q CACHE_WRITE_FAILED /tmp/motoko-warm.log; then \
         grep CACHE_WRITE_FAILED /tmp/motoko-warm.log; echo "compile cache not written"; exit 1; fi \
    && test -s src/core/.ailang/cache/compile/modules/src__core__session/coretypeinfo.gob \
    && rm -f /tmp/motoko-warm.log \
    && chmod -R a+rX /opt/motoko_agent

# motoko keeps run state under its own repo, not the task workspace: the session
# journal (upstream ADR-003, src/tui/src/session-journal.ts) at
# .motoko/sessions/<id>/ and logs at .motoko/logfile/. The repo is root-owned,
# so the runtime user gets that one directory. Without it every motoko task died
# at startup with `mkdir ... EACCES` in SessionJournal (dev plane, 2026-10-19,
# first image on the a94204aa base).
RUN mkdir -p /opt/motoko_agent/.motoko/sessions /opt/motoko_agent/.motoko/logfile \
    && chown -R ailang:ailang /opt/motoko_agent/.motoko \
    && su ailang -s /bin/sh -c 'mkdir -p /opt/motoko_agent/.motoko/sessions/build-probe \
         && rmdir /opt/motoko_agent/.motoko/sessions/build-probe \
         && touch /opt/motoko_agent/.motoko/logfile/.probe && rm /opt/motoko_agent/.motoko/logfile/.probe' \
    || { echo "the runtime user cannot write motoko's run state"; exit 1; }

# Prove the runtime user can do what the ailang_only lane check does at task
# start (internal/executor/motoko/lane.go checkLaneProfile): resolve the lane
# profile through motoko's own resolver. Root passing the warm-up above says
# nothing about the `ailang` user, which is how the missing registry cache
# shipped.
RUN su ailang -s /bin/sh -c 'cd /opt/motoko_agent \
      && AILANG_RELAX_MODULES=1 MOTOKO_REPO=/opt/motoko_agent ailang run --quiet --caps IO,FS,Env \
         --entry print_config_json src/core/config.ail -- --workdir /tmp --profile ailang_only' \
    | grep -q '"order":\["ailang_policy"' \
    || { echo "the runtime user cannot resolve the ailang_only profile"; exit 1; }

# Put `motoko` on PATH so the executor adapter's `exec.LookPath("motoko")`
# resolves cleanly. run-agent.sh accepts the directive as a positional arg and
# reads MODEL / MOTOKO_CONFIG / WORKDIR / MOTOKO_SESSION_ID from env.
#
# An exec wrapper, NOT a symlink. run-agent.sh finds its project root from
# `dirname "${BASH_SOURCE[0]}"`, which bash does not resolve through symlinks:
# through /usr/local/bin/motoko -> run-agent.sh the root came out as /usr/local
# and every task died with "Error: src/tui/src/index.ts not found." (dev cloud
# executor, 2026-10-01 — the symlink had never worked). Exec'ing the script by
# its real path gives it the right BASH_SOURCE whatever motoko does next.
RUN printf '#!/bin/sh\nexec /opt/motoko_agent/scripts/run-agent.sh "$@"\n' > /usr/local/bin/motoko \
    && chmod 755 /usr/local/bin/motoko

# Build-time guard: a motoko commit that moves the entry point or the launcher,
# or a launcher that stops resolving its project root, fails this build instead
# of every task. The smoke runs `motoko` from / with a stub `bun` first on PATH
# that prints where run-agent.sh exec'd it from and with what entry point, so
# it walks the real path check and cd without starting the agent, a model or
# any credentials.
RUN test -f /opt/motoko_agent/src/tui/src/index.ts \
    && test -x /opt/motoko_agent/scripts/run-agent.sh \
    && mkdir -p /tmp/motoko-smoke \
    && printf '#!/bin/sh\necho "$(pwd) $1"\n' > /tmp/motoko-smoke/bun \
    && chmod 755 /tmp/motoko-smoke/bun \
    && out="$(cd / && PATH=/tmp/motoko-smoke:$PATH motoko)" \
    && echo "motoko launcher smoke: $out" \
    && [ "$out" = "/opt/motoko_agent /opt/motoko_agent/src/tui/src/index.ts" ] \
    && rm -rf /tmp/motoko-smoke

# Bake the commit SHA so motoko's run_summary.motoko_commit is non-"dev"
# in cloud-deployed runs (mitigates self-referential masking — see motoko's
# M-MOTOKO-EVAL-INSTRUMENTATION Risk #4).
ENV MOTOKO_COMMIT=${MOTOKO_COMMIT}

USER ailang

# NOTE for ailang-multivac PR authors:
#   This image works against the public sunholo-voight-kampff/motoko_agent repo, but
#   the fetch should still be given the `github_token` build secret in Cloud
#   Build (see above) or it will intermittently hit GitHub's anonymous-egress
#   throttle. If you switch the pinned commit to one on a private branch, the
#   same secret must carry a token with read access to that repo.

# The image declares the executor CLI it installs. cmd/ailang execute-job
# refuses a task whose AILANG_PROVIDER disagrees, instead of cloning the repo
# and then exec-failing on a binary that was never here (2026-08-27/28).
ENV AILANG_IMAGE_PROVIDER=motoko
