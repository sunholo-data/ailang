# AILANG Agent Executor — go variant (Claude CLI + Go toolchain)
# M-EXECUTOR-VARIANTS: Use for agents that run go build/test on Go repos.
# Use for: sprint-executor (ailang repo), any agent editing Go codebases.
ARG PROJECT
FROM europe-west1-docker.pkg.dev/${PROJECT}/ailang/agent:latest

# Go toolchain — matches go.mod version in the ailang repo
COPY --from=golang:1.26-bookworm /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOPATH="/home/ailang/go"

# Website workloads use the guarded Claude Go lane as well as Go workloads.
# Match the existing Pi website tools, then restore the runtime user.
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python-is-python3 python3-yaml python3-venv \
    chromium fonts-liberation fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g yarn@1.22.22
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    PUPPETEER_SKIP_DOWNLOAD=true
USER ailang
