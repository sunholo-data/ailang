# AILANG Agent Executor — eval-go variant (all four executor CLIs + Go toolchain)
# M-EXECUTOR-VARIANTS: Use for eval-harness agents running benchmarks on Go codebases.
ARG PROJECT
FROM europe-west1-docker.pkg.dev/${PROJECT}/ailang/agent-eval:latest

# Go toolchain — matches go.mod version in the ailang repo
COPY --from=golang:1.25-bookworm /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOPATH="/home/ailang/go"
