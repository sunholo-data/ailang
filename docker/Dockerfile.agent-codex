# AILANG Agent Executor — codex variant (OpenAI Codex CLI, no Go toolchain)
# M-EXECUTOR-VARIANTS: Use for agents running OpenAI models via the Codex CLI.
# Use for: any agent with provider=codex on non-Go codebases.
ARG PROJECT
FROM europe-west1-docker.pkg.dev/${PROJECT}/ailang/agent-base:latest

# OpenAI Codex CLI — PINNED (2026-09-30). Unpinned, each image took whatever npm had
# at build time, so the 09-28 images carried 0.158.0 while the mission roles moved to
# gpt-6.1-sol, which needs >= 0.159.2 (older CLIs 400 it exactly like a nonexistent
# model). Bump deliberately; agent-codex-go inherits this image.
ARG CODEX_VERSION=0.159.2
USER root
RUN npm install -g "@openai/codex@${CODEX_VERSION}" \
    && codex --version </dev/null | grep -qx "codex-cli ${CODEX_VERSION}" \
       || { echo "codex --version = $(codex --version </dev/null), pinned ${CODEX_VERSION}" >&2; exit 1; }
USER ailang

# The image declares the executor CLI it installs. cmd/ailang execute-job
# refuses a task whose AILANG_PROVIDER disagrees, instead of cloning the repo
# and then exec-failing on a binary that was never here (2026-08-27/28).
ENV AILANG_IMAGE_PROVIDER=codex
# Explicit per-container credential home is required by the subscription lease.
# Both codex executor variants inherit this; API-key jobs use the same empty home.
ENV CODEX_HOME=/home/ailang/.codex
