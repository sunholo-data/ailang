# AILANG Agent Executor — default variant (Claude CLI, no Go toolchain)
# M-EXECUTOR-VARIANTS: Slimmed from monolithic image. Go toolchain moved to agent-go variant.
# Use for: design-doc-creator, sprint-planner, website-builder, docs agents.
ARG PROJECT
FROM europe-west1-docker.pkg.dev/${PROJECT}/ailang/agent-base:latest

# Claude Code CLI — the only executor in the default variant
USER root
RUN npm install -g @anthropic-ai/claude-code
USER ailang

# The image declares the executor CLI it installs. cmd/ailang execute-job
# refuses a task whose AILANG_PROVIDER disagrees, instead of cloning the repo
# and then exec-failing on a binary that was never here (2026-08-27/28).
ENV AILANG_IMAGE_PROVIDER=claude
