# AILANG Agent Executor — Cloud Run Job
#
# Runs `ailang coordinator execute-job` for task execution.
# Includes Claude CLI and Gemini CLI for agentic coding,
# plus git for repository operations.

# ── Build stage ──────────────────────────────────────────────
FROM golang:1.25-bookworm AS builder

WORKDIR /build

# Cache Go modules
COPY go.mod go.sum ./
RUN go mod download

# Build ailang binary
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -o /ailang ./cmd/ailang/

# ── Runtime stage ────────────────────────────────────────────
FROM debian:bookworm-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    curl \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js (required for Claude CLI and Gemini CLI)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install Claude CLI
RUN npm install -g @anthropic-ai/claude-code

# Install Gemini CLI
RUN npm install -g @anthropic-ai/gemini-cli 2>/dev/null || true

# Copy ailang binary
COPY --from=builder /ailang /usr/local/bin/ailang

# Copy Go toolchain from builder so agents can build Go projects without downloading it
COPY --from=builder /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOPATH="/home/ailang/go"

# Git config for automated commits
RUN git config --system user.name "ailang-agent" \
    && git config --system user.email "ailang-agent@noreply.github.com"

# Pre-clone shared skills plugin for faster cold starts (M-CLOUD-PLUGIN-SKILLS, v0.9.1)
# This is a cache — the execute-job command will re-clone if AILANG_PLUGIN_REPO is set.
# Override at build time: --build-arg AILANG_PLUGIN_REPO=https://github.com/your-org/your-plugin.git
ARG AILANG_PLUGIN_REPO=https://github.com/sunholo-data/ailang_bootstrap.git
RUN git clone --depth 1 ${AILANG_PLUGIN_REPO} /plugins/ailang_bootstrap 2>/dev/null || true

ENV COORDINATOR_MODE=cloud

# Create non-root user for agent execution.
# Claude Code refuses --dangerously-skip-permissions when running as root.
# Also a container security best practice — the agent doesn't need root.
RUN useradd -m -s /bin/bash ailang \
    && mkdir -p /workspace /plugins \
    && chown -R ailang:ailang /workspace /plugins

USER ailang

# Working directory for git operations
WORKDIR /workspace

# Run execute-job (AILANG_TASK_ID set by Eventarc)
ENTRYPOINT ["/usr/local/bin/ailang"]
CMD ["coordinator", "execute-job"]
